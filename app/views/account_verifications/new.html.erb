<% content_for :meta_robots, "noindex, nofollow" %>
<div class="max-w-md mx-auto p-6 bg-white rounded shadow-sm dark:bg-slate-800/80 dark:shadow-none">
  <h1 class="text-xl font-semibold mb-2"><%= t("account_verifications.title") %></h1>
  <p class="text-sm text-gray-600 dark:text-slate-400 mb-4"><%= t("account_verifications.subtitle") %></p>

  <div class="mb-5 rounded-md border border-gray-200 p-4 dark:border-white/10">
    <p class="text-sm font-medium text-gray-800 dark:text-slate-200"><%= t("account_verifications.by_email") %></p>
    <p class="mt-0.5 text-sm text-gray-600 dark:text-slate-400"><%= current_user.email %></p>
    <%= button_to t("account_verifications.send_code"), account_verification_path, method: :post,
          class: "mt-3 rounded-md bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-700" %>
  </div>

  <%= form_with url: account_verification_path, method: :patch, local: true do %>
    <div class="mb-4">
      <%= label_tag :code, t("sessions.code_label"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= text_field_tag :code, nil, required: true,
            class: "mt-1 block w-full rounded border px-3 py-2 tracking-widest uppercase dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
    </div>
    <%= submit_tag t("account_verifications.submit"), class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700" %>
  <% end %>

  <p class="mt-5 border-t border-gray-200 pt-4 text-sm text-gray-600 dark:border-white/10 dark:text-slate-400">
    <%= t("account_verifications.by_telegram") %>
    <%= link_to t("account_verifications.telegram_cta"), notifications_account_path, class: "font-medium text-indigo-600 underline dark:text-indigo-400" %>
  </p>
</div>

<section class="bg-white dark:bg-slate-800/80 border dark:border-white/10 rounded-lg p-4">
  <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-3">Tennis Scoreboard</h2>

  <% if tennis_score_html.present? %>
    <div class="text-sm leading-7 text-gray-900 dark:text-slate-100">
      <%= tennis_score_html %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500 dark:text-slate-400">No tennis scoreboard data yet.</p>
  <% end %>
</section>

<section class="bg-white border rounded-lg p-4">
  <h2 class="text-sm font-semibold text-gray-900 mb-3">Tennis Scoreboard</h2>

  <% if tennis_score_html.present? %>
    <div class="text-sm leading-7 text-gray-900">
      <%= tennis_score_html %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">No tennis scoreboard data yet.</p>
  <% end %>
</section>

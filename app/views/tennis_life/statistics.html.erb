<% content_for :meta_title, t("tennis_life.statistics.meta_title") %>
<% content_for :meta_description, t("tennis_life.statistics.meta_description") %>

<div class="max-w-6xl mx-auto px-4 py-6 space-y-6">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-slate-100"><%= t("tennis_life.statistics.title") %></h1>
      <p class="mt-1 text-sm text-gray-600 dark:text-slate-400"><%= t("tennis_life.statistics.subtitle") %></p>
    </div>
    <%= link_to t("tennis_life.statistics.back"), tennis_life_path, class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
  </div>

  <section class="rounded-lg border bg-white p-4 dark:bg-slate-800/80 dark:border-white/10">
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_18rem] gap-5">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-4"><%= t("tennis_life.statistics.rankings_title") %></h2>

        <% if @rating_rows.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead>
                <tr class="border-b border-gray-100 dark:border-white/10 text-left text-gray-500 dark:text-slate-400">
                  <th class="py-2 pr-4 font-medium"><%= t("tennis_life.statistics.rank") %></th>
                  <th class="py-2 pr-4 font-medium"><%= t("tennis_life.statistics.player") %></th>
                  <th class="py-2 pr-4 font-medium">Telegram</th>
                  <th class="py-2 pr-4 font-medium"><%= t("tennis_life.statistics.wins") %></th>
                  <th class="py-2 pr-4 font-medium"><%= t("tennis_life.statistics.games") %></th>
                  <th class="py-2 pr-4 font-medium">Win %</th>
                  <th class="py-2 pr-4 font-medium">Singles ELO</th>
                  <th class="py-2 font-medium">Doubles ELO</th>
                </tr>
              </thead>
              <tbody>
                <% @rating_rows.each_with_index do |row, idx| %>
                  <% user = row[:user] %>
                  <% telegram_username = user&.telegram_username.to_s.strip.delete_prefix("@") %>
                  <% player_name = user&.name.presence || (user&.id.present? ? "User ##{user.id}" : "Anonymous player") %>
                  <tr class="border-b border-gray-100 dark:border-white/10 text-gray-800 dark:text-slate-200">
                    <td class="py-3 pr-4"><%= idx + 1 %></td>
                    <td class="py-3 pr-4 font-medium"><%= player_name %></td>
                    <td class="py-3 pr-4">
                      <% if telegram_username.present? %>
                        <%= telegram_profile_link(telegram_username, label: "@#{telegram_username}", class: "text-indigo-600 dark:text-indigo-400 hover:underline") %>
                      <% else %>
                        <span class="text-gray-400 dark:text-slate-500">-</span>
                      <% end %>
                    </td>
                    <td class="py-3 pr-4"><%= row[:wins] %></td>
                    <td class="py-3 pr-4"><%= row[:games] %></td>
                    <td class="py-3 pr-4"><%= row[:pct] %>%</td>
                    <td class="py-3 pr-4"><%= row[:singles_rating] %></td>
                    <td class="py-3"><%= row[:doubles_rating] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tennis_life.index.no_rating_data") %></p>
        <% end %>
      </div>

      <aside class="self-start rounded-xl border border-indigo-100 bg-indigo-50/70 p-4 text-sm text-gray-700 dark:border-indigo-400/20 dark:bg-indigo-500/10 dark:text-slate-300">
        <h3 class="font-semibold text-gray-900 dark:text-slate-100"><%= t("tennis_life.statistics.elo_title") %></h3>
        <p class="mt-2"><%= t("tennis_life.statistics.elo_p1") %></p>
        <p class="mt-2"><%= t("tennis_life.statistics.elo_p2_html").html_safe %></p>
        <p class="mt-2"><%= t("tennis_life.statistics.elo_p3_html").html_safe %></p>
      </aside>
    </div>
  </section>

  <section class="rounded-lg border bg-white p-4 dark:bg-slate-800/80 dark:border-white/10">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-4"><%= t("tennis_life.statistics.recent_results") %></h2>

    <% if @recent_matches.any? %>
      <% related_ids = @recent_matches.flat_map { |match| match.stats.to_h.values_at("partner_id", "opponent_ids") }.flatten.compact.uniq %>
      <% names_by_id =
        if related_ids.any?
          User.where(id: related_ids).each_with_object({}) do |user, result|
            result[user.id] = user.name.presence || Telegram::Helpers::UserLookup.display_name(user, fallback: "User ##{user.id}")
          end
        else
          {}
        end %>
      <div class="space-y-3">
        <% @recent_matches.each do |match| %>
          <% stats = match.stats.to_h %>
          <% user_name = match.user&.name.presence || Telegram::Helpers::UserLookup.display_name(match.user, fallback: "User ##{match.user_id}") %>
          <% match_title =
            if match.mode == "doubles"
              partner_name = names_by_id[stats["partner_id"]]
              opponent_names = Array(stats["opponent_ids"]).filter_map { |id| names_by_id[id] }
              team_name = [ user_name, partner_name ].compact.uniq.join(" / ")
              opponents_label = opponent_names.any? ? opponent_names.join(" / ") : "Unknown opponents"
              "#{team_name} vs #{opponents_label}"
            else
              fallback_opponent_name = Array(stats["opponent_ids"]).filter_map { |id| names_by_id[id] }.first
              opponent_name = match.opponent&.name.presence ||
                Telegram::Helpers::UserLookup.display_name(match.opponent, fallback: fallback_opponent_name || "Unknown opponent")
              "#{user_name} vs #{opponent_name}"
            end %>
          <article class="rounded-lg border border-gray-100 p-4 dark:border-white/10">
            <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-slate-400">
              <p><%= match.played_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
              <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600 dark:bg-slate-700/60 dark:text-slate-300">
                <%= match.mode == "doubles" ? "2v2" : "1v1" %>
              </span>
            </div>
            <p class="mt-1 text-sm font-medium text-gray-900 dark:text-slate-100"><%= match_title %></p>
            <p class="mt-1 text-sm text-gray-600 dark:text-slate-300">
              Score: <%= match.score.presence || "-" %>
              · Outcome: <%= match.outcome.to_s.presence&.titleize || "-" %>
              · Surface: <%= match.surface.presence || "-" %>
            </p>
          </article>
        <% end %>
      </div>
      <%= render "shared/pagy", pagy: @pagy %>
    <% else %>
      <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tennis_life.statistics.no_matches") %></p>
    <% end %>
  </section>

  <%= render "shared/pages_nav" %>
</div>

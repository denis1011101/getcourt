<% content_for :meta_title, "Tennis Player Rankings, ELO Ratings & Match Results | GetCourt" %>
<% content_for :meta_description, "Complete amateur tennis player rankings with win rates and ELO ratings. Browse recent match results, scores and surfaces on the GetCourt platform." %>

<div class="max-w-6xl mx-auto px-4 py-6 space-y-6">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-slate-100">Tennis Player Rankings & Match Results</h1>
      <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">Full player rankings with ELO ratings and recent match history on GetCourt.</p>
    </div>
    <%= link_to "Back to Tennis Life", tennis_life_path, class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
  </div>

  <section class="rounded-lg border bg-white p-4 dark:bg-slate-800/80 dark:border-white/10">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-4">Player Rankings & Win Rates</h2>

    <% if @rating_rows.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 dark:border-white/10 text-left text-gray-500 dark:text-slate-400">
              <th class="py-2 pr-4 font-medium">Rank</th>
              <th class="py-2 pr-4 font-medium">Player</th>
              <th class="py-2 pr-4 font-medium">Telegram</th>
              <th class="py-2 pr-4 font-medium">Wins</th>
              <th class="py-2 pr-4 font-medium">Games</th>
              <th class="py-2 pr-4 font-medium">Win %</th>
              <th class="py-2 pr-4 font-medium">Singles ELO</th>
              <th class="py-2 font-medium">Doubles ELO</th>
            </tr>
          </thead>
          <tbody>
            <% @rating_rows.each_with_index do |row, idx| %>
              <% user = row[:user] %>
              <% telegram_username = user&.telegram_username.to_s.strip.delete_prefix("@") %>
              <% player_name = user&.name.presence || (user&.id.present? ? "User ##{user.id}" : "Anonymous player") %>
              <tr class="border-b border-gray-100 dark:border-white/10 text-gray-800 dark:text-slate-200">
                <td class="py-3 pr-4"><%= idx + 1 %></td>
                <td class="py-3 pr-4 font-medium"><%= player_name %></td>
                <td class="py-3 pr-4">
                  <% if telegram_username.present? %>
                    <%= telegram_profile_link(telegram_username, label: "@#{telegram_username}", class: "text-indigo-600 dark:text-indigo-400 hover:underline") %>
                  <% else %>
                    <span class="text-gray-400 dark:text-slate-500">-</span>
                  <% end %>
                </td>
                <td class="py-3 pr-4"><%= row[:wins] %></td>
                <td class="py-3 pr-4"><%= row[:games] %></td>
                <td class="py-3 pr-4"><%= row[:pct] %>%</td>
                <td class="py-3 pr-4"><%= row[:singles_rating] %></td>
                <td class="py-3"><%= row[:doubles_rating] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 dark:text-slate-400">No rating data yet.</p>
    <% end %>
  </section>

  <section class="rounded-lg border bg-white p-4 dark:bg-slate-800/80 dark:border-white/10">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-4">Recent Match Results</h2>

    <% if @recent_matches.any? %>
      <div class="space-y-3">
        <% @recent_matches.each do |match| %>
          <% user_name = match.user&.name.presence || Telegram::Helpers::UserLookup.display_name(match.user, fallback: "User ##{match.user_id}") %>
          <% opponent_name = match.opponent&.name.presence || Telegram::Helpers::UserLookup.display_name(match.opponent, fallback: "Unknown opponent") %>
          <article class="rounded-lg border border-gray-100 p-4 dark:border-white/10">
            <p class="text-xs text-gray-500 dark:text-slate-400"><%= match.played_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
            <p class="mt-1 text-sm font-medium text-gray-900 dark:text-slate-100"><%= "#{user_name} vs #{opponent_name}" %></p>
            <p class="mt-1 text-sm text-gray-600 dark:text-slate-300">
              Score: <%= match.score.presence || "-" %>
              · Outcome: <%= match.outcome.to_s.presence&.titleize || "-" %>
              · Surface: <%= match.surface.presence || "-" %>
            </p>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 dark:text-slate-400">No matches yet.</p>
    <% end %>
  </section>
</div>

<% game = card.record %>
<% participations = game.participations.loaded? ? game.participations.target : game.participations.to_a %>
<% taken = participations.count(&:approved?) %>
<% spots_left = [game.players_count.to_i - taken, 0].max %>
<% display_date = game.recurring? ? (game.next_date || game.date) : game.date %>
<% title_key = local_assigns.fetch(:title_key, "tennis_life.feed.game.title") %>

<div class="p-4">
  <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600 dark:text-indigo-300"><%= t(title_key) %></p>
  <h2 class="mt-2 text-base font-semibold text-gray-900 dark:text-slate-100"><%= game.court.name %></h2>
  <p class="mt-1 text-sm text-gray-600 dark:text-slate-300">
    <%= display_date&.strftime("%Y-%m-%d") || "—" %>
    <% if game.time %> · <%= game.time.strftime("%H:%M") %><% end %>
  </p>
  <% if game.comment.present? %><p class="mt-2 text-sm text-gray-500 dark:text-slate-400"><%= truncate(game.comment.squish, length: 120) %></p><% end %>
  <div class="mt-3 flex items-center justify-between gap-3">
    <span class="text-sm font-medium text-emerald-600 dark:text-emerald-300"><%= t("tennis_life.feed.game.spots_left", count: spots_left) %></span>
    <%= link_to t("tennis_life.feed.game.join"), game_path(game), class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>
</div>

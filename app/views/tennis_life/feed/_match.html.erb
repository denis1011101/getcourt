<% match = card.record %>
<% names_by_id = match_names_by_id(match_related_user_ids(match)) %>
<% player_name, opponent_name = match_feed_sides(match, names_by_id: names_by_id) %>

<div class="p-4">
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600 dark:text-emerald-300"><%= t("tennis_life.feed.match.title") %></p>
    <p class="text-xs text-gray-500 dark:text-slate-400"><%= match.played_at&.strftime("%Y-%m-%d") %></p>
  </div>
  <p class="mt-2 font-medium text-gray-900 dark:text-slate-100"><%= t("tennis_life.feed.match.versus", player: player_name, opponent: opponent_name) %></p>
  <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-600 dark:text-slate-300">
    <%# The score is written from the named side's perspective, so spelling the outcome out again adds nothing. %>
    <span><%= t("tennis_life.feed.match.score") %>: <%= match.score.presence || "—" %></span>
    <% if match.surface.present? %>
      <span><%= t("tennis_life.feed.match.surface") %>: <%= t("courts.surfaces.#{match.surface}", default: match.surface) %></span>
    <% end %>
  </div>
  <% if match.game_page_relevant? %>
    <%= link_to "#{t("tennis_life.feed.match.view_game")} →", game_path(match.game), class: "mt-3 inline-block text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
  <% end %>
</div>

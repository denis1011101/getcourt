<% user = card.record %>
<% stats = user.player_statistic %>
<% row = card.meta %>
<% name = user.name.presence || t("tennis_life.user_fallback", id: user.id) %>

<div class="p-4">
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-wide text-violet-600 dark:text-violet-300"><%= t("tennis_life.feed.player.title") %></p>
    <% if row[:rank] %><span class="text-xs font-semibold text-violet-600 dark:text-violet-300"><%= t("tennis_life.feed.rank", rank: row[:rank]) %></span><% end %>
  </div>
  <p class="mt-2 text-base font-semibold text-gray-900 dark:text-slate-100"><%= name %></p>
  <p class="mt-1 text-sm text-gray-600 dark:text-slate-300"><%= t("tennis_life.feed.player_record", wins: row[:wins].to_i, games: row[:games].to_i) %></p>
  <div class="mt-3 flex gap-4 text-xs text-gray-500 dark:text-slate-400">
    <span><%= t("tennis_life.feed.player.singles_elo", value: stats&.singles_rating || PlayerStatistic::BASE_ELO) %></span>
    <span><%= t("tennis_life.feed.player.doubles_elo", value: stats&.doubles_rating || PlayerStatistic::BASE_ELO) %></span>
  </div>
  <%= link_to "#{t("tennis_life.feed.all_statistics")} →", tennis_life_statistics_path, class: "mt-3 inline-block text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
</div>

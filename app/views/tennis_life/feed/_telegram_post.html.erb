<% post = card.record %>
<% username = post.telegram_channel.username.to_s.delete_prefix("@") %>
<% post_url = "https://t.me/#{username}/#{post.message_id}" if username.match?(/\A[\w]+\z/) %>
<% widget_path = "#{username}/#{post.message_id}" if post_url && post.message_id.to_s.match?(/\A\d+\z/) %>
<% text = I18n.locale == :en ? (post.text_en.presence || post.text) : (post.text.presence || post.text_en) %>

<div class="p-4"
     <% if widget_path %>
       data-controller="telegram-post"
       data-telegram-post-post-value="<%= widget_path %>"
     <% end %>>
  <p class="text-xs font-semibold uppercase tracking-wide text-sky-600 dark:text-sky-300"><%= t("tennis_life.feed.telegram.title") %></p>
  <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= post.telegram_channel.title.presence || post.telegram_channel.username %></p>
  <% if widget_path %>
    <div class="mt-3 hidden min-h-56"
         data-telegram-post-target="widget"
         aria-label="<%= t("tennis_life.feed.telegram.title") %>"></div>
  <% end %>
  <p class="mt-3 whitespace-pre-line text-sm text-gray-800 dark:text-slate-200"><%= truncate(text.to_s, length: 700) %></p>
  <% if post_url %>
    <%= link_to "#{t("tennis_life.feed.telegram.read")} →", post_url, target: "_blank", rel: "nofollow noopener", class: "mt-3 inline-block text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
  <% end %>
</div>

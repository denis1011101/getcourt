<% content_for :meta_title, t("tennis_life.index.meta_title") %>
<% content_for :meta_description, t("tennis_life.index.meta_description") %>

<div class="mx-auto max-w-3xl space-y-6 px-4 py-6">
  <header>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-slate-100"><%= t("tennis_life.feed.title") %></h1>
        <p class="mt-1 text-sm text-gray-600 dark:text-slate-400"><%= t("tennis_life.feed.subtitle") %></p>
      </div>
      <%= link_to t("tennis_life.feed.classic_link"), tennis_life_classic_path, class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
    </div>
  </header>

  <% if @pinned_rating_rows.any? %>
    <section class="rounded-xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-400/20 dark:bg-amber-500/10">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= t("tennis_life.feed.pinned_title") %></h2>
          <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("tennis_life.feed.pinned_subtitle", season: @season_label) %></p>
        </div>
        <%= link_to t("tennis_life.feed.all_statistics"), tennis_life_statistics_path, class: "text-xs text-indigo-600 hover:underline dark:text-indigo-400" %>
      </div>
      <ol class="mt-3 grid gap-2 sm:grid-cols-3">
        <% @pinned_rating_rows.each_with_index do |row, index| %>
          <% user = row[:user] %>
          <% name = user.name.presence || t("tennis_life.user_fallback", id: user.id) %>
          <li class="rounded-lg border border-amber-100 bg-white/80 p-3 dark:border-white/10 dark:bg-slate-800/80">
            <p class="text-xs font-semibold text-amber-700 dark:text-amber-300"><%= t("tennis_life.feed.rank", rank: index + 1) %></p>
            <p class="mt-1 truncate text-sm font-medium text-gray-900 dark:text-slate-100"><%= name %></p>
            <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("tennis_life.feed.player_record", wins: row[:wins], games: row[:games]) %></p>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <div data-controller="infinite-feed" data-infinite-feed-auto-limit-value="10">
    <div id="tennis-life-feed" class="space-y-4">
      <%= render partial: "tennis_life/feed/card", collection: @cards, as: :card %>
    </div>
    <%= render "tennis_life/feed/sentinel", next_cursor: @next_cursor %>
  </div>

  <%= render "shared/pages_nav" %>
</div>

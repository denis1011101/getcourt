<% content_for :meta_title, t("tennis_life.index.meta_title") %>
<% content_for :meta_description, t("tennis_life.index.meta_description") %>

<div class="max-w-6xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold mb-4"><%= t("tennis_life.index.title") %><span class="inline-flex items-center ml-1" style="vertical-align: -0.02em;"><svg viewBox="0 0 24 24" style="width: 0.26em; height: 0.26em;" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#d4f542"/><path d="M3 8 Q9 12 3 16" fill="none" stroke="white" stroke-width="1.8" opacity="0.7" stroke-linecap="round"/><path d="M21 8 Q15 12 21 16" fill="none" stroke="white" stroke-width="1.8" opacity="0.7" stroke-linecap="round"/></svg></span></h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <main class="lg:col-span-2 space-y-4">
      <section class="bg-white border rounded-lg dark:bg-slate-800/80 dark:border-white/10 p-4">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-3"><%= t("tennis_life.index.stats_title") %></h2>
        <div class="grid grid-cols-2 gap-3">
          <% @stats_cards.each do |card| %>
            <div class="rounded-md border p-3 dark:border-white/10">
              <p class="text-xs text-gray-500 dark:text-slate-400"><%= card[:title] %></p>
              <p class="text-xl font-semibold text-gray-900 dark:text-slate-100"><%= card[:value] %></p>
            </div>
          <% end %>
        </div>
      </section>

      <%= render "scoreboard", tennis_score_html: tennis_scoreboard_html(@tennis_score_raw) %>

      <section class="space-y-3">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= t("tennis_life.index.feed_title") %></h2>

        <% if @feed_posts.any? %>
          <% @feed_posts.each do |post| %>
            <% channel = post.telegram_channel.username.to_s.delete_prefix("@") %>
            <article class="bg-white border rounded-lg dark:bg-slate-800/80 dark:border-white/10 p-4">
              <% if post.text_en.present? %>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-1 font-medium"><%= post.telegram_channel.username %></p>
                <p class="text-sm text-gray-800 dark:text-slate-200 whitespace-pre-line mb-3"><%= post.text_en %></p>
              <% end %>
              <div class="<%= post.text_en.present? ? 'border-t dark:border-white/10 pt-3' : '' %>">
                <script async src="https://telegram.org/js/telegram-widget.js?22"
                        data-telegram-post="<%= "#{channel}/#{post.message_id}" %>"
                        data-width="100%"
                        data-userpic="true"></script>
              </div>
            </article>
          <% end %>
        <% elsif @random_telegram_post %>
          <% rpost = @random_telegram_post %>
          <% channel_url = rpost["channel_url"].to_s[%r{\Ahttps://t\.me/[\w-]+\z}] %>
          <% post_url = rpost["url"].to_s[%r{\Ahttps://t\.me/[\w-]+/\d+\z}] %>
          <% tg_post_path = rpost["url"].to_s.sub(%r{\Ahttps://t\.me/}, "") %>
          <article class="bg-white border rounded-lg dark:bg-slate-800/80 dark:border-white/10 p-4">
            <% if channel_url.present? %>
              <p class="text-xs text-gray-500 dark:text-slate-400 mb-1">
                <a href="<%= channel_url %>" class="text-indigo-600 dark:text-indigo-400 hover:underline" target="_blank" rel="nofollow noopener"><%= rpost["channel_name"] %></a>
              </p>
            <% end %>
            <%= turbo_frame_tag "featured_post_translation", src: tennis_life_featured_translation_path do %>
              <p class="text-sm text-gray-800 dark:text-slate-200 whitespace-pre-line"><%= rpost["text"] %></p>
            <% end %>
            <% if post_url.present? %>
              <a href="<%= post_url %>" class="mt-2 inline-block text-xs text-indigo-600 dark:text-indigo-400 hover:underline" target="_blank" rel="nofollow noopener"><%= t("tennis_life.index.read_on_telegram") %> →</a>
            <% end %>
            <% if tg_post_path.match?(%r{\A[\w-]+/\d+\z}) %>
              <div class="mt-3">
                <script async src="https://telegram.org/js/telegram-widget.js?22"
                        data-telegram-post="<%= tg_post_path %>"
                        data-width="100%"
                        data-userpic="true"></script>
              </div>
            <% end %>
          </article>
        <% else %>
          <div class="rounded-lg border p-6 text-center text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-800/80">
            <%= t("tennis_life.index.no_posts") %>
          </div>
        <% end %>
      </section>
    </main>

    <aside class="lg:col-span-1 space-y-4 lg:sticky lg:top-24 self-start">
      <section class="border rounded-lg p-4 bg-white dark:bg-slate-800/80 dark:border-white/10">
        <h3 class="text-sm font-semibold mb-2">
          <%= t("tennis_life.index.player_rating") %>
          <span class="font-normal text-gray-500 dark:text-slate-400">· <%= t("tennis_life.index.season_label", year: @season_label) %></span>
        </h3>
        <p class="mb-3 text-xs text-gray-500 dark:text-slate-400">
          <%= t("tennis_life.statistics.active_window_note", months: TennisLifeController::ACTIVE_RATING_MONTHS) %>
        </p>

        <% if @rating_rows.any? %>
          <ol class="space-y-2 text-sm">
            <% @rating_rows.each_with_index do |row, idx| %>
              <% user = row[:user] %>
              <% telegram_username = user&.telegram_username.to_s.strip.delete_prefix("@") %>
              <% display_name = if user&.name.present?
                user.name
              elsif user&.id.present?
                "User ##{user.id}"
              else
                "Anonymous player"
              end %>
              <li class="flex items-start justify-between gap-2 border-b border-gray-100 dark:border-white/10 pb-2">
                <div>
                  <p class="font-medium text-gray-900 dark:text-slate-100">
                    <%= "#{idx + 1}. #{display_name}" %>
                    <% if telegram_username.present? %>
                      (<%= telegram_profile_link(telegram_username, label: "@#{telegram_username}", class: "text-indigo-600 dark:text-indigo-400 hover:underline" ) %>)
                    <% end %>
                  </p>
                  <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("tennis_life.index.record", wins: row[:wins], games: row[:games]) %></p>
                </div>
                <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400"><%= "#{row[:pct]}%" %></span>
              </li>
            <% end %>
          </ol>
          <div class="mt-3 text-center">
            <%= link_to "#{t("tennis_life.index.view_all_statistics")} →", tennis_life_statistics_path, class: "text-xs text-indigo-600 dark:text-indigo-400 hover:underline" %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tennis_life.index.no_rating_data") %></p>
        <% end %>
      </section>

    </aside>
  </div>
</div>

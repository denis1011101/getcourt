<% content_for :meta_title, "Tennis Life — tennis news and updates" %>
<% content_for :meta_description, "Tennis Life: news, articles and updates about tennis" %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold mb-4">Tennis Life</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <main class="lg:col-span-2 space-y-4">
      <% if defined?(@posts) && @posts.present? %>
        <% @posts.each do |post| %>
          <article class="border rounded-lg p-4 bg-white shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-sm font-medium text-gray-800">
                  <%= post.telegram_channel&.title.presence || post.telegram_channel&.username || "Channel" %>
                </h3>
                <p class="text-xs text-gray-500"><%= post.published_at&.strftime("%Y-%m-%d %H:%M") %></p>
              </div>
            </div>

            <div class="mt-3 text-gray-800">
              <%= simple_format(h(post.text.to_s)) %>
            </div>

            <% if post.extra.present? && post.extra["link"].present? %>
              <div class="mt-3">
                <a href="<%= post.extra['link'] %>" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">View original</a>
              </div>
            <% end %>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-lg border p-6 text-center text-gray-700">
          The feed is empty. Content will appear after the first background fetch of the channels.
        </div>
      <% end %>
    </main>

    <aside class="lg:col-span-1 space-y-4">
      <div class="border rounded-lg p-4 bg-white">
        <h4 class="text-sm font-semibold mb-2">Telegram channels</h4>
        <ul class="space-y-2 text-sm">
          <% if defined?(TennisLifeController::TELEGRAM_CHANNELS) %>
            <% TennisLifeController::TELEGRAM_CHANNELS.each do |c| %>
              <li>
                <a href="<%= c[:url] %>" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">
                  <%= c[:name] %>
                </a>
              </li>
            <% end %>
          <% else %>
            <li class="text-gray-500">Channels not configured</li>
          <% end %>
        </ul>
      </div>
    </aside>
  </div>
</div>

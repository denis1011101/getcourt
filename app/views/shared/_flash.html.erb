<% flash.each do |type, msg| %>
  <% color = { notice: "bg-green-50 text-green-900 border-green-200 dark:bg-green-500/10 dark:text-green-200 dark:border-green-500/20",
               alert: "bg-red-50 text-red-900 border-red-200 dark:bg-red-500/10 dark:text-red-200 dark:border-red-500/20" }[type.to_sym] || "bg-blue-50 text-blue-900 border-blue-200 dark:bg-blue-500/10 dark:text-blue-200 dark:border-blue-500/20" %>
  <div class="mb-2 rounded-md border px-4 py-3 <%= color %>"><%= msg %></div>
<% end %>
<% flash.each do |type, msg| %>
  <% color = { notice: "bg-green-50 text-green-900 border-green-200",
               alert: "bg-red-50 text-red-900 border-red-200" }[type.to_sym] || "bg-blue-50 text-blue-900 border-blue-200" %>
  <div class="mb-2 rounded-md border px-4 py-3 <%= color %>"><%= msg %></div>
<% end %>
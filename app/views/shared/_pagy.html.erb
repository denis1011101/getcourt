<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-center gap-1 mt-8 select-none" aria-label="Pagination">

    <%# Prev button %>
    <% if pagy.prev %>
      <%= link_to pagy_url_for(pagy, pagy.prev),
            class: "flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 hover:border-indigo-300 hover:text-indigo-600 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Prev
      <% end %>
    <% else %>
      <span class="flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium text-gray-300 cursor-not-allowed">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Prev
      </span>
    <% end %>

    <%# Page numbers %>
    <% pagy.series.each do |item| %>
      <% if item == :gap %>
        <span class="px-1 py-2 text-sm text-gray-400 leading-none">…</span>
      <% elsif item.is_a?(String) %>
        <span class="w-9 h-9 flex items-center justify-center rounded-full text-sm font-semibold bg-indigo-600 text-white border border-indigo-600">
          <%= item %>
        </span>
      <% else %>
        <%= link_to item.to_s, pagy_url_for(pagy, item),
              class: "w-9 h-9 flex items-center justify-center rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 hover:border-indigo-300 hover:text-indigo-600 transition" %>
      <% end %>
    <% end %>

    <%# Next button %>
    <% if pagy.next %>
      <%= link_to pagy_url_for(pagy, pagy.next),
            class: "flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 hover:border-indigo-300 hover:text-indigo-600 transition" do %>
        Next
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>
    <% else %>
      <span class="flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium text-gray-300 cursor-not-allowed">
        Next
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    <% end %>

  </nav>
<% end %>

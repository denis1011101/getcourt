<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-center gap-1 mt-8 select-none" aria-label="<%= t("shared.pagy.label") %>">

    <%# Prev button %>
    <% if pagy.previous %>
      <%= link_to pagy_url_for(pagy, pagy.previous),
            class: "flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 dark:border-white/10 dark:bg-slate-800 dark:text-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        <%= t("common.prev") %>
      <% end %>
    <% else %>
      <span class="flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium text-gray-300 dark:text-slate-600 cursor-not-allowed">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        <%= t("common.prev") %>
      </span>
    <% end %>

    <%# Page numbers (Pagy 43 compatible) %>
    <% start_page = [pagy.page - 2, 1].max %>
    <% end_page = [start_page + 4, pagy.pages].min %>
    <% start_page = [end_page - 4, 1].max %>

    <% if start_page > 1 %>
      <%= link_to "1", pagy_url_for(pagy, 1),
            class: "w-9 h-9 flex items-center justify-center rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 dark:border-white/10 dark:bg-slate-800 dark:text-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition" %>
      <% if start_page > 2 %>
        <span class="px-1 py-2 text-sm text-gray-400 dark:text-slate-500 leading-none">…</span>
      <% end %>
    <% end %>

    <% (start_page..end_page).each do |item| %>
      <% if item == pagy.page %>
        <span class="w-9 h-9 flex items-center justify-center rounded-full text-sm font-semibold bg-indigo-600 text-white border border-indigo-600">
          <%= item %>
        </span>
      <% else %>
        <%= link_to item.to_s, pagy_url_for(pagy, item),
              class: "w-9 h-9 flex items-center justify-center rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 dark:border-white/10 dark:bg-slate-800 dark:text-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition" %>
      <% end %>
    <% end %>

    <% if end_page < pagy.pages %>
      <% if end_page < pagy.pages - 1 %>
        <span class="px-1 py-2 text-sm text-gray-400 dark:text-slate-500 leading-none">…</span>
      <% end %>
      <%= link_to pagy.pages.to_s, pagy_url_for(pagy, pagy.pages),
            class: "w-9 h-9 flex items-center justify-center rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 dark:border-white/10 dark:bg-slate-800 dark:text-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition" %>
    <% end %>

    <%# Next button %>
    <% if pagy.next %>
      <%= link_to pagy_url_for(pagy, pagy.next),
            class: "flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-700 dark:border-white/10 dark:bg-slate-800 dark:text-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition" do %>
        <%= t("common.next") %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>
    <% else %>
      <span class="flex items-center gap-1 px-3 py-2 rounded-full text-sm font-medium text-gray-300 dark:text-slate-600 cursor-not-allowed">
        <%= t("common.next") %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    <% end %>

  </nav>
<% end %>

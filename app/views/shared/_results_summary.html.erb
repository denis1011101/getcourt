<div class="flex items-center justify-between mb-4">
  <div>
    <% if filters.any? %>
      <p class="text-sm text-gray-500" data-testid="results-summary">
        <%= label %> &middot; <%= safe_join(filters, " &middot; ".html_safe) %>
      </p>
    <% else %>
      <p class="text-sm text-gray-500" data-testid="results-summary">
        <%= label %> <%= t("shared.results_summary.available") %>
      </p>
    <% end %>
  </div>

  <%= yield if block_given? %>
</div>

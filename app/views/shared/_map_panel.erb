<%# Shared map panel: yields a map container. Usage: render "shared/map_panel" do ... end %>
<% if geocoding_exceeded? %>
  <div class="mb-2 rounded-md bg-yellow-50 border border-yellow-200 p-2 text-yellow-800 text-sm">
    Google geocoding quota exceeded for today (limit: <%= Geocoding::Quota::DAILY_LIMIT %>). Address lookup via Google is disabled — map unavailable.
  </div>
<% else %>
  <% if user_signed_in? %>
    <%= yield %>
  <% else %>
    <div class="h-40 w-full rounded border bg-gray-50 flex flex-col items-center justify-center text-gray-600 mb-4 p-4">
      <p class="text-sm mb-2"><%= local_assigns[:message].presence || "Map is hidden for unauthenticated users." %></p>
      <%= link_to "Sign in or Sign up to view the map", new_session_path, title: "Sign in or create an account", class: "text-indigo-600 hover:underline" %>
    </div>
  <% end %>
<% end %>
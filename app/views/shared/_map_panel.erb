<%# Shared map panel: yields a map container. Usage: render "shared/map_panel" do ... end %>
<% if geocoding_exceeded? %>
  <div class="mb-2 rounded-md bg-yellow-50 border border-yellow-200 p-2 text-yellow-800 text-sm">
    <%= t("shared.map_panel.quota_exceeded", limit: Geocoding::Quota::DAILY_LIMIT) %>
  </div>
<% else %>
  <% if user_signed_in? %>
    <%= yield %>
  <% else %>
    <div class="h-40 w-full rounded border bg-gray-50 flex flex-col items-center justify-center text-gray-600 mb-4 p-4">
      <p class="text-sm mb-2"><%= local_assigns[:message].presence || t("shared.map_panel.hidden") %></p>
      <%= link_to t("shared.map_panel.sign_in"), new_session_path, title: t("sessions.sign_in_title"), class: "text-indigo-600 dark:text-indigo-400 hover:underline" %>
    </div>
  <% end %>
<% end %>

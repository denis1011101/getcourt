<%= link_to event_path(featured_match), rel: "noopener",
      class: "group block no-underline text-inherit mb-6",
      data: {
        turbo_prefetch: false,
        controller: "featured-match wallchart-analytics",
        action: "click->wallchart-analytics#click",
        featured_match_starts_at_value: featured_match.starts_at.iso8601,
        featured_match_started_text_value: t("featured_match.match_started"),
        featured_match_days_suffix_value: t("featured_match.days_suffix"),
        wallchart_analytics_campaign_value: ApplicationHelper::WALLCHART_CAMPAIGN,
        wallchart_analytics_event_slug_value: featured_match.slug,
        wallchart_analytics_locale_value: I18n.locale,
        wallchart_analytics_view_event_value: "wallchart_banner_viewed",
        wallchart_analytics_click_event_value: "wallchart_banner_clicked"
      } do %>
  <section class="relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md dark:bg-slate-900 dark:border-white/10">
    <div class="flex flex-col md:flex-row md:items-stretch">
      <!-- Make your final prediction — Wallchart '26 (green accent) -->
      <div class="flex-1 px-5 py-3.5 md:px-6">
        <div class="text-[11px] font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400">
          <%= t("wallchart_banner.label") %>
        </div>
        <div class="mt-0.5 text-base md:text-lg font-extrabold tracking-tight text-gray-900 dark:text-white">
          <%= t("wallchart_banner.predict.title") %>
        </div>
        <p class="mt-0.5 text-sm text-gray-500 dark:text-slate-400">
          <%= t("wallchart_banner.predict.body") %>
        </p>
      </div>

      <!-- Countdown to kickoff -->
      <div class="flex flex-row items-center justify-center gap-x-2 px-5 py-3 border-y border-gray-200 md:flex-col md:gap-x-0 md:border-y-0 md:border-x dark:border-white/10"
           aria-label="<%= featured_match_countdown_label(featured_match) %>">
        <% if featured_match.status == "finished" %>
          <span class="flex flex-col items-center text-center">
            <span class="text-sm md:text-base font-bold text-gray-900 dark:text-white"><%= t("featured_match.match_finished") %></span>
            <% if featured_match.result.present? %>
              <span class="mt-0.5 text-xs text-gray-500 dark:text-slate-400"><%= featured_match.result %></span>
            <% end %>
          </span>
        <% elsif featured_match.starts_at.future? %>
          <span class="text-[11px] font-semibold tracking-wide text-gray-400 dark:text-slate-500" data-featured-match-target="days"></span>
          <span class="font-mono text-2xl md:text-3xl font-bold leading-none tabular-nums text-gray-900 dark:text-white" data-featured-match-target="time">--:--:--</span>
        <% else %>
          <span class="text-sm md:text-base font-bold text-center text-gray-900 dark:text-white"><%= t("featured_match.match_started") %></span>
        <% end %>
      </div>

      <!-- Watch the final together — Moment hookah space (blue accent + logo) -->
      <div class="flex flex-1 items-center gap-3 px-5 py-3.5 md:px-6">
        <%= render "shared/moment_logo", classes: "w-10 h-10" %>
        <div>
          <div class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wide text-[#1666c0] dark:text-[#5aa2e6]">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
            <%= t("wallchart_banner.watch.eyebrow") %>
          </div>
          <div class="mt-0.5 text-base md:text-lg font-extrabold tracking-tight text-gray-900 dark:text-white">
            <%= t("wallchart_banner.watch.title") %>
          </div>
          <p class="mt-0.5 text-sm text-gray-500 dark:text-slate-400">
            <%= t("wallchart_banner.watch.body") %>
          </p>
        </div>
      </div>
    </div>
  </section>
<% end %>

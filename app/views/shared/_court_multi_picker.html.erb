<% courts = Array(local_assigns[:courts]) %>
<% locations = court_picker_locations(courts) %>
<% selected_ids = Array(local_assigns[:selected_ids]).map(&:to_i) %>
<% user = local_assigns[:user] %>
<% selected_city = local_assigns[:selected_city].presence || (default_court_city(locations[:cities_by_country][""], user) if user) %>
<% selected_country = locations[:city_country][selected_city].to_s if selected_city %>
<% show_filters = locations[:countries].size > 1 || locations[:cities_by_country][""].size > 1 %>
<% id_prefix = local_assigns[:id_prefix].presence || "court" %>
<% max_height_class = local_assigns[:max_height_class].presence || "max-h-72" %>
<% param_name = local_assigns[:param_name] %>

<div data-controller="court-multi-picker"
     data-court-multi-picker-country-cities-value="<%= json_escape(locations[:cities_by_country].to_json) %>"
     data-court-multi-picker-city-placeholder-value="<%= t("games.form.court_city_any") %>"
     data-court-multi-picker-count-label-value="<%= t("tournaments.form.courts_selected", count: "%{count}") %>">
  <% if show_filters %>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div>
        <%= label_tag "#{id_prefix}_country", t("games.form.court_country"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= select_tag nil, options_for_select(locations[:countries], selected_country),
              include_blank: t("games.form.court_country_any"), id: "#{id_prefix}_country",
              class: "mt-1 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
              data: { "court-multi-picker-target": "country", action: "court-multi-picker#countryChanged" } %>
      </div>
      <div>
        <%= label_tag "#{id_prefix}_city", t("games.form.court_city"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= select_tag nil, options_for_select(locations[:cities_by_country][selected_country] || locations[:cities_by_country][""] || [], selected_city),
              include_blank: t("games.form.court_city_any"), id: "#{id_prefix}_city",
              class: "mt-1 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
              data: { "court-multi-picker-target": "city", action: "court-multi-picker#filter" } %>
      </div>
    </div>
  <% end %>

  <%= search_field_tag nil, nil, placeholder: t("tournaments.form.courts_search_placeholder"),
        id: "#{id_prefix}_search", autocomplete: "off",
        aria: { label: t("tournaments.form.courts_search_placeholder") },
        class: "mt-3 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
        data: { "court-multi-picker-target": "search", action: "input->court-multi-picker#filter" } %>

  <div class="mt-3 flex items-center justify-between gap-3">
    <span class="text-xs text-gray-500 dark:text-slate-400" data-court-multi-picker-target="count"></span>
    <button type="button" hidden data-court-multi-picker-target="clear" data-action="court-multi-picker#clear"
            class="text-xs text-indigo-600 hover:underline dark:text-indigo-400"><%= t("tournaments.form.courts_clear") %></button>
  </div>

  <%= hidden_field_tag param_name, "", id: nil %>
  <div class="mt-2 <%= max_height_class %> overflow-y-auto rounded-md border border-gray-200 p-3 dark:border-white/10">
    <% groups = courts.group_by { |c| c.city_name.to_s } %>
    <% groups.each do |city_name, city_courts| %>
      <% if city_name.present? && groups.size > 1 %>
        <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-gray-500 first:mt-0 dark:text-slate-400"
           data-court-multi-picker-target="group" data-city="<%= city_name %>"><%= city_name %></p>
      <% end %>
      <% city_courts.each do |court| %>
        <label class="mt-1 flex items-center text-sm text-gray-700 dark:text-slate-300 cursor-pointer"
               data-court-multi-picker-target="option"
               data-city="<%= court.city_name %>"
               data-country="<%= locations[:city_country][court.city_name] %>"
               data-name="<%= court.name.to_s.downcase %>">
          <%= check_box_tag param_name, court.id, selected_ids.include?(court.id),
                id: "#{id_prefix}_#{court.id}", class: "h-4 w-4 text-indigo-600 rounded border-gray-300 dark:border-white/15",
                data: { action: "court-multi-picker#toggled" } %>
          <span class="ml-2">
            <%= court.name %>
            <% if court.city_name.present? && groups.size <= 1 %>
              <span class="text-gray-500 dark:text-slate-400">(<%= court.city_name %>)</span>
            <% end %>
          </span>
        </label>
      <% end %>
    <% end %>
    <p hidden data-court-multi-picker-target="empty" class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.form.courts_none_found") %></p>
  </div>
</div>

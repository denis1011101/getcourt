<%# Newcomers land on the game list with no city, no Telegram and no profile, and
    nothing points at the account. Same checklist shape as the one on a game card. %>
<% onboarding = UserOnboardingPresenter.new(user: current_user) %>
<% if onboarding.visible? %>
  <section class="mb-6 rounded-xl border border-indigo-200 bg-indigo-50/70 p-4 dark:border-indigo-400/20 dark:bg-indigo-500/10" data-testid="user-onboarding">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= t("users.onboarding.title") %></h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-slate-400"><%= t("users.onboarding.description") %></p>
      </div>
      <%= button_to t("users.onboarding.dismiss"), dismiss_onboarding_account_path, method: :post,
            class: "shrink-0 rounded-md px-2 py-1 text-xs text-gray-500 hover:bg-white/60 dark:text-slate-400 dark:hover:bg-white/10" %>
    </div>

    <div class="mt-3">
      <div class="flex items-center justify-between text-xs text-gray-600 dark:text-slate-400">
        <span><%= t("users.onboarding.progress", done: onboarding.completed_count, total: onboarding.total_count) %></span>
        <span><%= onboarding.progress_percent %>%</span>
      </div>
      <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/70 dark:bg-slate-700">
        <div class="h-full rounded-full bg-indigo-600 dark:bg-indigo-400" style="width: <%= onboarding.progress_percent %>%"></div>
      </div>
    </div>

    <ul class="mt-4 space-y-2">
      <% onboarding.items.each do |item| %>
        <li class="flex flex-col gap-2 rounded-md bg-white p-3 sm:flex-row sm:items-center sm:justify-between dark:bg-slate-800/80" data-testid="user-onboarding-<%= item.key %>">
          <div class="flex gap-3">
            <span class="mt-0.5 <%= item.completed ? "text-emerald-600 dark:text-emerald-400" : "text-gray-400 dark:text-slate-500" %>" aria-hidden="true"><%= item.completed ? "✓" : "○" %></span>
            <div>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= t("users.onboarding.items.#{item.key}.title") %></p>
              <p class="text-xs text-gray-600 dark:text-slate-400"><%= t("users.onboarding.items.#{item.key}.description") %></p>
            </div>
          </div>
          <% unless item.completed %>
            <%= link_to t("users.onboarding.items.#{item.key}.action"), item.path,
                  class: "inline-flex shrink-0 items-center justify-center rounded-md border border-indigo-300 px-3 py-2 text-sm font-medium text-indigo-700 transition hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

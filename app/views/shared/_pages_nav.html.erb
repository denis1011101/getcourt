<div class="mt-6 flex flex-wrap gap-3 text-sm">
  <% [
    [ t("layout.nav.coaches"),        coaches_path ],
    [ t("layout.nav.contacts"),       contacts_path ],
    [ t("layout.nav.statistics"),     tennis_life_statistics_path ],
    [ t("layout.nav.ntrp_guide"),     ntrp_level_guide_path ],
    [ t("layout.nav.formats_rules"),  tennis_formats_and_rules_path ],
    [ t("layout.nav.partnership"),    partnership_path ],
    [ t("layout.nav.api"),            api_and_mcp_path ],
    [ t("layout.nav.privacy_policy"), privacy_policy_path ],
    [ t("layout.nav.mission"),        mission_path ],
  ].each do |label, path| %>
    <% unless current_page?(path) %>
      <%= link_to label, path, class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300" %>
    <% end %>
  <% end %>
</div>

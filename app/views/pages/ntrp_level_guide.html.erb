<% content_for :meta_title, t("pages.ntrp.meta_title") %>
<% content_for :meta_description, t("pages.ntrp.meta_description") %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= json_escape({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": t("pages.ntrp.faq_q1"),
          "acceptedAnswer": {
            "@type": "Answer",
            "text": t("pages.ntrp.faq_a1")
          }
        },
        {
          "@type": "Question",
          "name": t("pages.ntrp.faq_q2"),
          "acceptedAnswer": {
            "@type": "Answer",
            "text": t("pages.ntrp.faq_a2")
          }
        }
      ]
    }.to_json).html_safe %>
  </script>
<% end %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 p-6 shadow-sm mb-6">
    <h1 class="text-2xl font-semibold mb-4"><%= t("pages.ntrp.title") %></h1>

    <p class="text-gray-700 dark:text-slate-300 mb-4">
      <%= t("pages.ntrp.intro") %>
    </p>

    <%# ── Interactive Quiz ── %>
    <div class="mb-6"
         data-controller="ntrp-quiz"
         data-ntrp-quiz-descriptions-value="<%= json_escape(t("pages.ntrp.levels").to_json) %>">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.ntrp.quiz_title") %></h2>
      <p class="text-gray-600 dark:text-slate-400 text-sm mb-3"><%= t("pages.ntrp.quiz_subtitle") %></p>

      <button data-ntrp-quiz-target="startBtn" data-action="ntrp-quiz#start"
              class="px-5 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium">
        <%= t("pages.ntrp.start_quiz") %>
      </button>

      <div data-ntrp-quiz-target="quizSection" class="hidden">
        <%# Q1: Rally consistency %>
        <div data-ntrp-quiz-target="question" class="border dark:border-white/10 rounded-lg p-4">
          <p class="font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.ntrp.quiz.q1") %></p>
          <div class="space-y-2">
            <button data-action="ntrp-quiz#answer" data-score="2.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q1_a1") %></button>
            <button data-action="ntrp-quiz#answer" data-score="3.0" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q1_a2") %></button>
            <button data-action="ntrp-quiz#answer" data-score="3.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q1_a3") %></button>
            <button data-action="ntrp-quiz#answer" data-score="4.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q1_a4") %></button>
          </div>
        </div>

        <%# Q2: Serve %>
        <div data-ntrp-quiz-target="question" class="hidden border dark:border-white/10 rounded-lg p-4">
          <p class="font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.ntrp.quiz.q2") %></p>
          <div class="space-y-2">
            <button data-action="ntrp-quiz#answer" data-score="2.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q2_a1") %></button>
            <button data-action="ntrp-quiz#answer" data-score="3.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q2_a2") %></button>
            <button data-action="ntrp-quiz#answer" data-score="4.0" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q2_a3") %></button>
            <button data-action="ntrp-quiz#answer" data-score="5.0" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q2_a4") %></button>
          </div>
        </div>

        <%# Q3: Net play %>
        <div data-ntrp-quiz-target="question" class="hidden border dark:border-white/10 rounded-lg p-4">
          <p class="font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.ntrp.quiz.q3") %></p>
          <div class="space-y-2">
            <button data-action="ntrp-quiz#answer" data-score="2.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q3_a1") %></button>
            <button data-action="ntrp-quiz#answer" data-score="3.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q3_a2") %></button>
            <button data-action="ntrp-quiz#answer" data-score="4.0" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q3_a3") %></button>
            <button data-action="ntrp-quiz#answer" data-score="5.0" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q3_a4") %></button>
          </div>
        </div>

        <%# Q4: Movement %>
        <div data-ntrp-quiz-target="question" class="hidden border dark:border-white/10 rounded-lg p-4">
          <p class="font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.ntrp.quiz.q4") %></p>
          <div class="space-y-2">
            <button data-action="ntrp-quiz#answer" data-score="3.0" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q4_a1") %></button>
            <button data-action="ntrp-quiz#answer" data-score="3.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q4_a2") %></button>
            <button data-action="ntrp-quiz#answer" data-score="4.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q4_a3") %></button>
            <button data-action="ntrp-quiz#answer" data-score="5.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q4_a4") %></button>
          </div>
        </div>

        <%# Q5: Match play %>
        <div data-ntrp-quiz-target="question" class="hidden border dark:border-white/10 rounded-lg p-4">
          <p class="font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.ntrp.quiz.q5") %></p>
          <div class="space-y-2">
            <button data-action="ntrp-quiz#answer" data-score="3.0" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q5_a1") %></button>
            <button data-action="ntrp-quiz#answer" data-score="3.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q5_a2") %></button>
            <button data-action="ntrp-quiz#answer" data-score="4.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q5_a3") %></button>
            <button data-action="ntrp-quiz#answer" data-score="5.5" class="w-full text-left px-4 py-2 border dark:border-white/10 rounded hover:bg-gray-50 dark:hover:bg-white/5 text-sm dark:text-slate-300"><%= t("pages.ntrp.quiz.q5_a4") %></button>
          </div>
        </div>
      </div>

      <%# Result %>
      <div data-ntrp-quiz-target="result" class="hidden border-2 border-indigo-200 dark:border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/10 rounded-lg p-5">
        <p class="text-lg font-semibold text-indigo-900 mb-1"><%= t("pages.ntrp.result_label") %> <span data-ntrp-quiz-target="resultLevel" class="text-2xl">—</span></p>
        <p data-ntrp-quiz-target="resultDescription" class="text-gray-700 dark:text-slate-300 mb-3"></p>
        <div class="flex gap-3">
          <button data-action="ntrp-quiz#restart" class="text-sm text-indigo-600 transition-colors hover:text-indigo-800 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300"><%= t("pages.ntrp.retake_quiz") %></button>
          <%= link_to t("pages.ntrp.find_players"), root_path, class: "text-sm font-medium text-indigo-600 transition-colors hover:text-indigo-800 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300" %>
        </div>
      </div>
    </div>

    <%# ── Detailed level table ── %>
    <div class="mb-6">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.ntrp.chart_title") %></h2>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-50 dark:bg-slate-700/50">
              <th class="border dark:border-white/10 px-3 py-2 text-left font-medium text-gray-700 dark:text-slate-300 w-20"><%= t("pages.ntrp.chart.level") %></th>
              <th class="border dark:border-white/10 px-3 py-2 text-left font-medium text-gray-700 dark:text-slate-300"><%= t("pages.ntrp.chart.groundstrokes") %></th>
              <th class="border dark:border-white/10 px-3 py-2 text-left font-medium text-gray-700 dark:text-slate-300"><%= t("pages.ntrp.chart.serve_return") %></th>
              <th class="border dark:border-white/10 px-3 py-2 text-left font-medium text-gray-700 dark:text-slate-300"><%= t("pages.ntrp.chart.tactics") %></th>
            </tr>
          </thead>
          <tbody class="text-gray-700 dark:text-slate-300">
            <tr>
              <td class="border dark:border-white/10 px-3 py-2 font-semibold">2.5&ndash;3.0</td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r1_g") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r1_s") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r1_t") %></td>
            </tr>
            <tr class="bg-gray-50 dark:bg-slate-700/50">
              <td class="border dark:border-white/10 px-3 py-2 font-semibold">3.5</td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r2_g") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r2_s") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r2_t") %></td>
            </tr>
            <tr>
              <td class="border dark:border-white/10 px-3 py-2 font-semibold">4.0</td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r3_g") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r3_s") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r3_t") %></td>
            </tr>
            <tr class="bg-gray-50 dark:bg-slate-700/50">
              <td class="border dark:border-white/10 px-3 py-2 font-semibold">4.5</td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r4_g") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r4_s") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r4_t") %></td>
            </tr>
            <tr>
              <td class="border dark:border-white/10 px-3 py-2 font-semibold">5.0</td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r5_g") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r5_s") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r5_t") %></td>
            </tr>
            <tr class="bg-gray-50 dark:bg-slate-700/50">
              <td class="border dark:border-white/10 px-3 py-2 font-semibold">5.5</td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r6_g") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r6_s") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r6_t") %></td>
            </tr>
            <tr>
              <td class="border dark:border-white/10 px-3 py-2 font-semibold">6.0+</td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r7_g") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r7_s") %></td>
              <td class="border dark:border-white/10 px-3 py-2"><%= t("pages.ntrp.chart.r7_t") %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="text-gray-700 dark:text-slate-300 mb-4">
      <%= t("pages.ntrp.validate_note") %>
    </p>

    <%# ── CTA ── %>
    <div class="bg-indigo-50 dark:bg-indigo-500/10 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-gray-800 dark:text-slate-200 text-sm"><%= t("pages.ntrp.cta_text") %></p>
      <%= link_to t("pages.ntrp.cta"), root_path, class: "inline-block px-5 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium text-center" %>
    </div>
  </div>

  <%= render "shared/pages_nav" %>
</div>

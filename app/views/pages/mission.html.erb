<% content_for :meta_title, "Our Mission — GetCourt" %>
<% content_for :meta_description, "Our mission is to unite tennis enthusiasts and build the world’s largest community so everyone can find an opponent within 24 hours and discover new courts daily." %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="bg-white rounded-lg border p-6 shadow-sm">
    <h1 class="text-2xl font-semibold mb-4">Our Mission</h1>

    <p class="text-gray-700 mb-6">
      We connect tennis lovers and aim to build the world’s largest community of players. Our goal is that anyone can find an opponent within 24 hours and discover new courts every day.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
      <div class="space-y-3">
        <h2 class="text-lg font-medium text-gray-900">Find opponents fast</h2>
        <p class="text-gray-600">Create or join games and meet opponents nearby — we want you on court within 24 hours.</p>
      </div>

      <div class="space-y-3">
        <h2 class="text-lg font-medium text-gray-900">Discover new courts</h2>
        <p class="text-gray-600">Explore and bookmark courts, learn where people play and try new locations every day.</p>
      </div>
    </div>

    <div class="mb-6">
      <h2 class="text-lg font-medium text-gray-900 mb-2">How you can help</h2>
      <ul class="list-disc list-inside text-gray-600 space-y-2">
        <li>Create and invite players to games.</li>
        <li>Report bugs and request features on GitHub.</li>
        <li>Share and add courts so others can find them.</li>
      </ul>
    </div>

    <ul class="divide-y border-t border-b">
      <li class="p-4 flex items-center justify-between">
        <div>
          <p class="font-medium">Open-source</p>
          <p class="text-sm text-gray-600">Contribute, report issues or suggest features on GitHub.</p>
        </div>
        <div>
          <%= link_to "GitHub", "https://github.com/denis1011101/getcourt", target: "_blank", rel: "noopener", class: "text-sm text-indigo-600 hover:underline" %>
        </div>
      </li>
    </ul>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to new_game_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-500" do %>
        Create a game
      <% end %>

      <%= link_to courts_path, class: "inline-flex items-center rounded-md border px-4 py-2 text-gray-700 hover:bg-gray-50" do %>
        Explore courts
      <% end %>

      <%= link_to contacts_path, class: "inline-flex items-center rounded-md px-4 py-2 text-sm text-indigo-600 hover:underline" do %>
        Contact us
      <% end %>
    </div>
  </div>
</div>

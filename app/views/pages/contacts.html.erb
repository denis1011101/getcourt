<% content_for :meta_title, "Contact — GetCourt" %>
<% content_for :meta_description, "Contact the GetCourt team — report bugs, request features or ask questions." %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 p-6 shadow-sm">
    <h1 class="text-2xl font-semibold mb-4">Contact</h1>

    <p class="text-gray-700 dark:text-slate-300 mb-4">
      Email:
      <a href="mailto:denisdenis9331@gmail.com?subject=GetCourt%20Contact"
         class="text-indigo-600 hover:underline">denisdenis9331@gmail.com</a>
    </p>

    <div class="mb-4">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-1">Report bugs & request features</h2>
      <p class="text-gray-600 dark:text-slate-400">
        Please open an issue on GitHub:
        <a href="https://github.com/denis1011101/getcourt/issues" target="_blank" rel="noopener"
           class="text-indigo-600 hover:underline">github.com/denis1011101/getcourt</a>
      </p>
    </div>

    <p class="text-sm text-gray-500 dark:text-slate-400 mt-4">
      Typical response time: 1–3 business days. By contacting us you agree that we may store your message for the purposes of support and follow-up.
    </p>
  </div>

  <%= render "shared/pages_nav" %>
</div>

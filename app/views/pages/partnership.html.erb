<% content_for :meta_title, "Partnership Opportunities with GetCourt" %>
<% content_for :meta_description, "Partner with GetCourt: launch online court booking, reach active tennis players, and grow your sports business. Contact us today." %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= json_escape({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Partnership Opportunities with GetCourt",
      "description": "Partner with GetCourt for online court booking, player outreach, and sports brand advertising.",
      "publisher": { "@type": "Organization", "name": "GetCourt" }
    }.to_json).html_safe %>
  </script>
<% end %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="bg-white rounded-lg border p-6 shadow-sm mb-6">
    <h1 class="text-2xl font-semibold mb-2">Partnership Opportunities for Courts and Sports Brands</h1>
    <p class="text-gray-600 mb-6">Grow your business by connecting with active tennis players on GetCourt.</p>

    <%# ── Benefits ── %>
    <div class="grid sm:grid-cols-3 gap-4 mb-8">
      <div class="border rounded-lg p-4 text-center">
        <div class="w-10 h-10 mx-auto mb-2 bg-indigo-100 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Automate bookings</h3>
        <p class="text-xs text-gray-600">Receive booking requests directly via Telegram, email, or any messenger you use.</p>
      </div>
      <div class="border rounded-lg p-4 text-center">
        <div class="w-10 h-10 mx-auto mb-2 bg-green-100 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Reach active players</h3>
        <p class="text-xs text-gray-600">Get exposure to a growing community of tennis players looking for courts and games.</p>
      </div>
      <div class="border rounded-lg p-4 text-center">
        <div class="w-10 h-10 mx-auto mb-2 bg-amber-100 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Increase court usage</h3>
        <p class="text-xs text-gray-600">Fill empty time slots by making your court discoverable to nearby players.</p>
      </div>
    </div>

    <%# ── How it works ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 mb-3">How booking integration works</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 mb-2">Lead forwarding</h3>
          <p class="text-sm text-gray-700">A player requests a booking on GetCourt. We forward the request (player name, date, time) to you via Telegram, email, or another channel. You confirm or decline.</p>
        </div>
        <div class="border rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 mb-2">Slot-based flow</h3>
          <p class="text-sm text-gray-700">You provide your available time slots. Players see and select from your free slots directly on GetCourt. You receive a confirmed booking with all details.</p>
        </div>
      </div>
    </div>

    <%# ── Other collaboration ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 mb-3">Other collaboration ideas</h2>
      <ul class="list-disc pl-5 text-gray-700 text-sm space-y-1">
        <li>Equipment analytics and player statistics integrations</li>
        <li>Advertising on GetCourt for sports and tennis brands (targeted to active players)</li>
        <li>Co-branded events and tournament sponsorships</li>
        <li>Any other partnership idea you would like to discuss</li>
      </ul>
    </div>

    <%# ── Contact form ── %>
    <div class="border-2 border-indigo-200 rounded-lg p-5 bg-indigo-50" id="contact">
      <h2 class="text-lg font-medium text-gray-900 mb-3">Get in touch</h2>
      <% if flash[:notice] %>
        <div class="bg-green-100 border border-green-300 text-green-800 rounded-md p-3 mb-4 text-sm"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="bg-red-100 border border-red-300 text-red-800 rounded-md p-3 mb-4 text-sm"><%= flash[:alert] %></div>
      <% end %>
      <%= form_with url: partnership_inquiry_path, method: :post, local: true, class: "space-y-3" do |f| %>
        <%# honeypot field — hidden from real users, filled by bots %>
        <div class="hidden" aria-hidden="true">
          <%= f.text_field :website, tabindex: "-1", autocomplete: "off" %>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <%= f.label :name, "Your name *", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "John Smith" %>
          </div>
          <div>
            <%= f.label :organization, "Court / Organization", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :organization, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "Tennis Club" %>
          </div>
        </div>
        <div>
          <%= f.label :email, "Email *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "you@example.com" %>
        </div>
        <div>
          <%= f.label :message, "Message", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :message, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "Tell us about your court or idea..." %>
        </div>
        <%= f.submit "Send inquiry", class: "px-5 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium cursor-pointer" %>
      <% end %>
      <p class="text-xs text-gray-500 mt-2">Or email us directly at <a href="mailto:denisdenis9331@gmail.com?subject=GetCourt%20Partnership" class="text-indigo-600 hover:underline">denisdenis9331@gmail.com</a></p>
    </div>
  </div>

  <%# ── Related pages ── %>
  <div class="text-sm text-gray-500 flex gap-4">
    <%= link_to "NTRP Level Guide", ntrp_level_guide_path, class: "hover:text-indigo-600" %>
    <%= link_to "Tennis Formats & Rules", tennis_formats_and_rules_path, class: "hover:text-indigo-600" %>
  </div>
</div>

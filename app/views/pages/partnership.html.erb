<% content_for :meta_title, t("pages.partnership.meta_title") %>
<% content_for :meta_description, t("pages.partnership.meta_description") %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= json_escape({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": t("pages.partnership.meta_title"),
      "description": t("pages.partnership.schema_description"),
      "publisher": { "@type": "Organization", "name": "GetCourt" }
    }.to_json).html_safe %>
  </script>
<% end %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 p-6 shadow-sm mb-6">
    <h1 class="text-2xl font-semibold mb-2"><%= t("pages.partnership.title") %></h1>
    <p class="text-gray-600 dark:text-slate-400 mb-6"><%= t("pages.partnership.subtitle") %></p>

    <%# ── Benefits ── %>
    <div class="grid sm:grid-cols-3 gap-4 mb-8">
      <div class="border dark:border-white/10 rounded-lg p-4 text-center">
        <div class="w-10 h-10 mx-auto mb-2 bg-indigo-100 dark:bg-indigo-500/15 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.partnership.automate_title") %></h3>
        <p class="text-xs text-gray-600 dark:text-slate-400"><%= t("pages.partnership.automate_text") %></p>
      </div>
      <div class="border dark:border-white/10 rounded-lg p-4 text-center">
        <div class="w-10 h-10 mx-auto mb-2 bg-green-100 dark:bg-green-500/15 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.partnership.reach_title") %></h3>
        <p class="text-xs text-gray-600 dark:text-slate-400"><%= t("pages.partnership.reach_text") %></p>
      </div>
      <div class="border dark:border-white/10 rounded-lg p-4 text-center">
        <div class="w-10 h-10 mx-auto mb-2 bg-amber-100 dark:bg-amber-500/15 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.partnership.usage_title") %></h3>
        <p class="text-xs text-gray-600 dark:text-slate-400"><%= t("pages.partnership.usage_text") %></p>
      </div>
    </div>

    <%# ── How it works ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.partnership.integration_title") %></h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.partnership.lead_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.partnership.lead_text") %></p>
        </div>
        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.partnership.slots_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.partnership.slots_text") %></p>
        </div>
      </div>
    </div>

    <%# ── Coaches ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.partnership.coaches_title") %></h2>
      <p class="text-sm text-gray-600 dark:text-slate-400 mb-3"><%= t("pages.partnership.coaches_text") %></p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.partnership.listed_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.partnership.listed_text_html", link: link_to(t("layout.nav.coaches"), coaches_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline")).html_safe %></p>
        </div>
        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.partnership.ai_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.partnership.ai_text") %></p>
        </div>
      </div>
      <p class="mt-3 text-sm text-gray-600 dark:text-slate-400"><%= t("pages.partnership.listed_note") %></p>
    </div>

    <%# ── Other collaboration ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.partnership.other_title") %></h2>
      <ul class="list-disc pl-5 text-gray-700 dark:text-slate-300 text-sm space-y-1">
        <li><%= t("pages.partnership.other_analytics") %></li>
        <li><%= t("pages.partnership.other_ads") %></li>
        <li><%= t("pages.partnership.other_events") %></li>
        <li><%= t("pages.partnership.other_any") %></li>
      </ul>
    </div>

    <%# ── Contact form ── %>
    <div class="border-2 border-indigo-200 dark:border-indigo-500/30 rounded-lg p-5 bg-indigo-50 dark:bg-indigo-500/10" id="contact">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-3"><%= t("pages.partnership.contact_title") %></h2>
      <% if flash[:notice] %>
        <div class="bg-green-100 dark:bg-green-500/15 border border-green-300 text-green-800 rounded-md p-3 mb-4 text-sm"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="bg-red-100 border border-red-300 text-red-800 rounded-md p-3 mb-4 text-sm"><%= flash[:alert] %></div>
      <% end %>
      <%= form_with url: partnership_inquiry_path, method: :post, local: true, class: "space-y-3" do |f| %>
        <%# honeypot field — hidden from real users, filled by bots %>
        <div class="hidden" aria-hidden="true">
          <%= f.text_field :website, tabindex: "-1", autocomplete: "off" %>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <%= f.label :name, t("pages.partnership.form_name"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1" %>
            <%= f.text_field :name, required: true, class: "w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: t("pages.partnership.form_name_placeholder") %>
          </div>
          <div>
            <%= f.label :organization, t("pages.partnership.form_org"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1" %>
            <%= f.text_field :organization, class: "w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: t("pages.partnership.form_org_placeholder") %>
          </div>
        </div>
        <div>
          <%= f.label :email, t("pages.partnership.form_email"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1" %>
          <%= f.email_field :email, required: true, class: "w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "you@example.com" %>
        </div>
        <div>
          <%= f.label :message, t("pages.partnership.form_message"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1" %>
          <%= f.text_area :message, rows: 3, class: "w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: t("pages.partnership.form_message_placeholder") %>
        </div>
        <%= f.submit t("pages.partnership.form_submit"), class: "px-5 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium cursor-pointer" %>
      <% end %>
      <p class="text-xs text-gray-500 dark:text-slate-400 mt-2"><%= t("pages.partnership.email_direct_html", email: mail_to("denisdenis9331@gmail.com", "denisdenis9331@gmail.com", subject: "GetCourt Partnership", class: "text-indigo-600 dark:text-indigo-400 hover:underline")).html_safe %></p>
    </div>
  </div>

  <%= render "shared/pages_nav" %>
</div>

<% content_for :meta_title, t("pages.formats.meta_title") %>
<% content_for :meta_description, t("pages.formats.meta_description") %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= json_escape({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": t("pages.formats.schema_headline"),
      "description": t("pages.formats.schema_description"),
      "publisher": { "@type": "Organization", "name": "GetCourt" }
    }.to_json).html_safe %>
  </script>
<% end %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 p-6 shadow-sm mb-6">
    <h1 class="text-2xl font-semibold mb-2"><%= t("pages.formats.title") %></h1>
    <p class="text-gray-600 dark:text-slate-400 mb-6"><%= t("pages.formats.subtitle") %></p>

    <%# ── King of the Court ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.formats.king.title") %></h2>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.players_4_8") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.courts_1") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.singles_or_doubles") %></span>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <p class="text-gray-700 dark:text-slate-300 mb-2">
            <%= t("pages.formats.king.body") %>
          </p>
          <h3 class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-3 mb-1"><%= t("pages.formats.scoring") %></h3>
          <ul class="list-disc pl-5 text-gray-700 dark:text-slate-300 text-sm space-y-1">
            <li><%= t("pages.formats.king.score_1") %></li>
            <li><%= t("pages.formats.king.score_2") %></li>
            <li><%= t("pages.formats.king.score_3") %></li>
          </ul>
          <h3 class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-3 mb-1"><%= t("pages.formats.king.variations") %></h3>
          <ul class="list-disc pl-5 text-gray-700 dark:text-slate-300 text-sm space-y-1">
            <li><%= t("pages.formats.king.var_1_html") %></li>
            <li><%= t("pages.formats.king.var_2_html") %></li>
          </ul>
        </div>
        <div class="flex justify-center">
          <%# Court diagram: King of the Court %>
          <svg viewBox="0 0 240 320" class="w-48 h-auto" xmlns="http://www.w3.org/2000/svg">
            <%# Court outline %>
            <rect x="10" y="10" width="220" height="300" fill="#4a7c59" stroke="#fff" stroke-width="2" rx="2"/>
            <%# Net %>
            <line x1="10" y1="160" x2="230" y2="160" stroke="#fff" stroke-width="3"/>
            <%# Service boxes %>
            <rect x="40" y="70" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <rect x="120" y="70" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <rect x="40" y="160" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <rect x="120" y="160" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <%# Center service line %>
            <line x1="120" y1="70" x2="120" y2="250" stroke="#fff" stroke-width="1.5"/>
            <%# Baselines %>
            <line x1="10" y1="70" x2="230" y2="70" stroke="#fff" stroke-width="1.5"/>
            <line x1="10" y1="250" x2="230" y2="250" stroke="#fff" stroke-width="1.5"/>
            <%# King side label %>
            <rect x="30" y="20" width="180" height="30" fill="rgba(99,102,241,0.3)" rx="4"/>
            <text x="120" y="40" text-anchor="middle" fill="#fff" font-size="13" font-weight="bold"><%= t("pages.formats.king.diagram_side") %></text>
            <%# King player %>
            <circle cx="120" cy="90" r="10" fill="#6366f1"/>
            <text x="120" y="94" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold">K</text>
            <%# Challenger %>
            <circle cx="120" cy="230" r="10" fill="#f59e0b"/>
            <text x="120" y="234" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold">C</text>
            <%# Waiting players %>
            <circle cx="80" cy="280" r="8" fill="#9ca3af"/>
            <circle cx="120" cy="290" r="8" fill="#9ca3af"/>
            <circle cx="160" cy="280" r="8" fill="#9ca3af"/>
            <text x="120" y="310" text-anchor="middle" fill="#fff" font-size="9"><%= t("pages.formats.king.diagram_waiting") %></text>
            <%# Arrow showing rotation %>
            <path d="M 160 280 Q 200 270 200 240" fill="none" stroke="#f59e0b" stroke-width="1.5" marker-end="url(#arrow)"/>
            <defs><marker id="arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#f59e0b"/></marker></defs>
          </svg>
        </div>
      </div>
    </div>

    <%# ── 2 vs 2 with Two Balls ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.formats.two_balls.title") %></h2>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.players_4") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.courts_1") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.doubles") %></span>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <p class="text-gray-700 dark:text-slate-300 mb-2">
            <%= t("pages.formats.two_balls.body_html") %>
          </p>
          <h3 class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-3 mb-1"><%= t("pages.formats.scoring") %></h3>
          <ul class="list-disc pl-5 text-gray-700 dark:text-slate-300 text-sm space-y-1">
            <li><%= t("pages.formats.two_balls.score_1_html") %></li>
            <li><%= t("pages.formats.two_balls.score_2") %></li>
            <li><%= t("pages.formats.two_balls.score_3") %></li>
          </ul>
          <h3 class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-3 mb-1"><%= t("pages.formats.two_balls.safety_title") %></h3>
          <p class="text-gray-700 dark:text-slate-300 text-sm"><%= t("pages.formats.two_balls.safety_body") %></p>
        </div>
        <div class="flex justify-center">
          <svg viewBox="0 0 240 320" class="w-48 h-auto" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="220" height="300" fill="#4a7c59" stroke="#fff" stroke-width="2" rx="2"/>
            <line x1="10" y1="160" x2="230" y2="160" stroke="#fff" stroke-width="3"/>
            <rect x="40" y="70" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <rect x="120" y="70" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <rect x="40" y="160" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <rect x="120" y="160" width="80" height="90" fill="none" stroke="#fff" stroke-width="1.5"/>
            <line x1="120" y1="70" x2="120" y2="250" stroke="#fff" stroke-width="1.5"/>
            <line x1="10" y1="70" x2="230" y2="70" stroke="#fff" stroke-width="1.5"/>
            <line x1="10" y1="250" x2="230" y2="250" stroke="#fff" stroke-width="1.5"/>
            <%# Team A (blue) — serving side %>
            <circle cx="70" cy="230" r="10" fill="#6366f1"/>
            <text x="70" y="234" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold">A</text>
            <circle cx="170" cy="230" r="10" fill="#6366f1"/>
            <text x="170" y="234" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold">A</text>
            <%# Team B (amber) %>
            <circle cx="70" cy="90" r="10" fill="#f59e0b"/>
            <text x="70" y="94" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold">B</text>
            <circle cx="170" cy="90" r="10" fill="#f59e0b"/>
            <text x="170" y="94" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold">B</text>
            <%# Two balls from one side %>
            <circle cx="75" cy="175" r="5" fill="#d4f542" stroke="#fff" stroke-width="1"/>
            <circle cx="155" cy="165" r="5" fill="#d4f542" stroke="#fff" stroke-width="1"/>
            <text x="120" y="155" text-anchor="middle" fill="#fff" font-size="8"><%= t("pages.formats.two_balls.diagram_balls") %></text>
            <%# Arrow from serving side %>
            <path d="M 70 220 Q 75 195 75 185" fill="none" stroke="#d4f542" stroke-width="1.5" marker-end="url(#arrowBall)"/>
            <path d="M 170 220 Q 160 195 155 175" fill="none" stroke="#d4f542" stroke-width="1.5" marker-end="url(#arrowBall)"/>
            <defs><marker id="arrowBall" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#d4f542"/></marker></defs>
          </svg>
        </div>
      </div>
    </div>

    <%# ── 3 Pairs Format ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.formats.three_pairs.title") %></h2>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.players_3") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.courts_1") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.singles") %></span>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <p class="text-gray-700 dark:text-slate-300 mb-2">
            <%= t("pages.formats.three_pairs.body") %>
          </p>
          <h3 class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-3 mb-1"><%= t("pages.formats.three_pairs.scoreboard_title") %></h3>
          <p class="text-gray-700 dark:text-slate-300 text-sm mb-1"><%= t("pages.formats.three_pairs.scoreboard_body") %></p>
          <ul class="list-disc pl-5 text-gray-700 dark:text-slate-300 text-sm space-y-1">
            <li><%= t("pages.formats.three_pairs.rule_1") %></li>
            <li><%= t("pages.formats.three_pairs.rule_2") %></li>
            <li><%= t("pages.formats.three_pairs.rule_3") %></li>
          </ul>
          <h3 class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-3 mb-1"><%= t("pages.formats.three_pairs.why_title") %></h3>
          <p class="text-gray-700 dark:text-slate-300 text-sm"><%= t("pages.formats.three_pairs.why_body") %></p>
        </div>
        <div class="flex justify-center items-start pt-2">
          <%# Scoreboard diagram %>
          <div class="w-48">
            <div class="rounded border border-gray-300 dark:border-white/20 overflow-hidden text-sm font-mono">
              <div class="bg-gray-200 dark:bg-slate-700 text-gray-700 dark:text-slate-300 text-xs px-2 py-1 font-semibold"><%= t("pages.formats.three_pairs.scoreboard_title") %></div>
              <div class="divide-y divide-gray-200 dark:divide-white/10">
                <div class="flex items-center px-2 py-1.5 bg-white dark:bg-slate-800">
                  <span class="flex-1 text-xs text-gray-800 dark:text-slate-200"><%= t("pages.formats.three_pairs.pair_ab") %></span>
                  <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400">6 — 4</span>
                </div>
                <div class="flex items-center px-2 py-1.5 bg-white dark:bg-slate-800">
                  <span class="flex-1 text-xs text-gray-800 dark:text-slate-200"><%= t("pages.formats.three_pairs.pair_ac") %></span>
                  <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400">3 — 6</span>
                </div>
                <div class="flex items-center px-2 py-1.5 bg-white dark:bg-slate-800">
                  <span class="flex-1 text-xs text-gray-800 dark:text-slate-200"><%= t("pages.formats.three_pairs.pair_bc") %></span>
                  <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400">6 — 2</span>
                </div>
              </div>
            </div>
            <p class="text-xs text-gray-500 dark:text-slate-400 mt-2 text-center"><%= t("pages.formats.three_pairs.diagram_note") %></p>
          </div>
        </div>
      </div>
    </div>

    <%# ── Round Robin ── %>
    <div class="mb-6">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-2"><%= t("pages.formats.round_robin.title") %></h2>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.players_4_8") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.courts_1_2") %></span>
        <span class="inline-block bg-gray-100 dark:bg-slate-700/50 text-gray-700 dark:text-slate-300 text-xs font-medium px-2 py-1 rounded"><%= t("pages.formats.singles") %></span>
      </div>
      <p class="text-gray-700 dark:text-slate-300 mb-2">
        <%= t("pages.formats.round_robin.body") %>
      </p>
      <h3 class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-3 mb-1"><%= t("pages.formats.scoring") %></h3>
      <ul class="list-disc pl-5 text-gray-700 dark:text-slate-300 text-sm space-y-1">
        <li><%= t("pages.formats.round_robin.score_1") %></li>
        <li><%= t("pages.formats.round_robin.score_2") %></li>
      </ul>
      <p class="text-gray-700 dark:text-slate-300 text-sm mt-2"><%= t("pages.formats.round_robin.note") %></p>
    </div>

    <%# ── Drills ── %>
    <div class="mb-8">
      <h2 class="text-lg font-medium text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.formats.drills.title") %></h2>
      <p class="text-sm text-gray-600 dark:text-slate-400 mb-4"><%= t("pages.formats.drills.subtitle") %></p>

      <div class="space-y-4">
        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.formats.drills.d1_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.formats.drills.d1_body") %></p>
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%= t("pages.formats.drills.d1_meta") %></p>
        </div>

        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.formats.drills.d2_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.formats.drills.d2_body") %></p>
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%= t("pages.formats.drills.d2_meta") %></p>
        </div>

        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.formats.drills.d3_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.formats.drills.d3_body") %></p>
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%= t("pages.formats.drills.d3_meta") %></p>
        </div>

        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.formats.drills.d4_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.formats.drills.d4_body") %></p>
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%= t("pages.formats.drills.d4_meta") %></p>
        </div>

        <div class="border dark:border-white/10 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 mb-1"><%= t("pages.formats.drills.d5_title") %></h3>
          <p class="text-sm text-gray-700 dark:text-slate-300"><%= t("pages.formats.drills.d5_body") %></p>
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%= t("pages.formats.drills.d5_meta") %></p>
        </div>
      </div>
    </div>

    <%# ── CTA ── %>
    <div class="bg-indigo-50 dark:bg-indigo-500/10 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-gray-800 dark:text-slate-200 text-sm"><%= t("pages.formats.cta_text") %></p>
      <%= link_to t("pages.formats.cta"), new_game_path, class: "inline-block px-5 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium text-center" %>
    </div>
  </div>

  <%= render "shared/pages_nav" %>
</div>

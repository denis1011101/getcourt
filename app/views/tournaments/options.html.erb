<% content_for :meta_robots, "noindex, follow" %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-semibold"><%= t("tournaments.options.title") %></h1>
      <p class="text-gray-600 dark:text-slate-400"><%= t("tournaments.options.subtitle") %></p>
    </div>
    <%= link_to t("tournaments.options.back"), tournaments_path, class: "shrink-0 inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
  </div>

  <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 p-6 shadow-sm">
    <h2 class="text-lg font-medium mb-2 text-gray-900 dark:text-slate-100">
      <%= link_to (@tournament.name.presence || t("layout.nav.tournaments")), tournament_path(@tournament), class: "hover:underline" %>
    </h2>

    <p class="text-sm text-gray-600 dark:text-slate-400 mb-4">
      <strong><%= t("tournaments.show.players") %>:</strong> <%= @tournament.players_count || "—" %>
      &nbsp;•&nbsp;
      <strong><%= t("tournaments.show.format") %>:</strong>
      <%= @tournament.format.present? ? t("tournaments.formats.#{@tournament.format}", default: @tournament.format.to_s.titleize) : "—" %>
      &nbsp;•&nbsp;
      <strong><%= t("tournaments.show.type") %>:</strong> <%= t("tournaments.types.#{@tournament.tournament_type}") %>
      <% if @tournament.start_date.present? || @tournament.end_date.present? %>
        &nbsp;•&nbsp;
        <strong><%= t("tournaments.show.date") %>:</strong>
        <%= [ @tournament.start_date, @tournament.end_date ].compact.map { |date| date.strftime("%d.%m.%Y") }.join(" — ") %>
      <% end %>
    </p>

    <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
      <strong><%= t("tournaments.options.joined") %>:</strong>
      <% joined = @tournament.approved_participants.includes(:user) %>
      <%= joined.any? ? joined.map(&:display_name).join(", ") : t("tournaments.options.none") %>
    </div>

    <% if @variants.present? %>
      <div class="grid grid-cols-1 gap-4">
        <% @variants.each_with_index do |variant, index| %>
          <div class="border dark:border-white/10 rounded-lg p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="font-medium text-gray-900 dark:text-slate-100"><%= t("tournaments.options.option", number: index + 1) %></h3>
              <span class="text-sm text-gray-500 dark:text-slate-400">
                <%= t("tournaments.options.slots", count: variant[:size]) %> — <%= t("tournaments.options.byes", count: variant[:byes]) %>
              </span>
            </div>

            <% if variant[:byes].to_i.positive? %>
              <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/15 dark:text-amber-200">
                <%= t("tournaments.form.bracket_warning",
                      players: @tournament.players_count,
                      byes: variant[:byes],
                      missing: variant[:byes],
                      size: variant[:size]) %>
              </div>
            <% end %>

            <% if variant[:rounds].present? %>
              <% variant[:rounds].each_with_index do |round, round_index| %>
                <div class="mt-3">
                  <div class="text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("tournaments.options.round", number: round_index + 1) %></div>
                  <ul class="mt-1 text-sm text-gray-600 dark:text-slate-400 list-disc list-inside">
                    <% round.each do |pair| %>
                      <li><%= Array(pair).join(" #{t('tournaments.show.vs')} ") %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            <% end %>

            <% ready = @tournament.players_count.to_i.positive? &&
                       @tournament.approved_participants_count == @tournament.players_count.to_i &&
                       !@tournament.games.exists? %>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <%= form_with url: select_bracket_tournament_path(@tournament), method: :post, local: true do |f| %>
                <%= hidden_field_tag :variant, index %>
                <%= f.submit t("tournaments.options.select_bracket"),
                      class: "inline-flex items-center rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition cursor-pointer #{'opacity-50 cursor-not-allowed' unless ready}",
                      disabled: !ready %>
              <% end %>

              <%= link_to t("tournaments.options.preview"), tournament_path(@tournament),
                    class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
            </div>

            <% unless ready %>
              <p class="mt-2 text-xs text-gray-500 dark:text-slate-400"><%= t("tournaments.options.not_ready") %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed dark:border-white/10 p-6 text-center text-gray-500 dark:text-slate-400">
        <%= t("tournaments.options.empty") %>
      </div>
    <% end %>

    <% if @tournament.persisted? && @tournament.games.exists? %>
      <div class="mt-4">
        <%= button_to t("tournaments.options.reset_bracket"), reset_bracket_tournament_path(@tournament), method: :post,
              form: { data: { turbo_confirm: t("tournaments.options.reset_confirm") } },
              class: "inline-flex items-center rounded-md border border-amber-300 px-3 py-2 text-sm font-medium text-amber-700 transition hover:bg-amber-50 dark:border-amber-400/30 dark:text-amber-200 dark:hover:bg-amber-500/10" %>
      </div>
    <% end %>
  </div>
</div>

<% content_for :meta_robots, "noindex, follow" %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-semibold"><%= t("tournaments.new.title") %></h1>
      <p class="text-gray-600 dark:text-slate-400"><%= t("tournaments.new.subtitle") %></p>
    </div>
    <%= link_to t("tournaments.new.back"), tournaments_path, class: "shrink-0 inline-flex items-center rounded-md border border-gray-300 dark:border-white/10 px-3 py-2 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-white/5 transition" %>
  </div>

  <%= render "form", tournament: @tournament %>
</div>

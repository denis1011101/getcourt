<div class="border p-4 rounded bg-white">
  <h4 class="font-medium text-lg">
    <%= link_to (tournament.name.presence || "Tournament"), tournament_path(tournament) %>
  </h4>
  <div class="text-sm text-gray-600 mt-1">
    Players: <%= tournament.players_count || "—" %> • Joined: <%= tournament.tournament_participants.count %>
  </div>
  <div class="mt-3">
    <%= link_to "Options", options_tournaments_path(tournament_id: tournament.id), class: "text-sm text-indigo-600 hover:underline" %>
  </div>
</div>

<% tournament_name = @tournament.name.presence || t("layout.nav.tournaments") %>
<% is_organizer = @tournament.organizer?(current_user) %>
<% my_participation = @tournament.participant_for(current_user) %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 dark:text-slate-400 mb-4">
    <%= link_to t("layout.nav.home"), root_path, class: "hover:text-gray-700 dark:hover:text-slate-300" %> &rsaquo;
    <%= link_to t("layout.nav.tournaments"), tournaments_path, class: "hover:text-gray-700 dark:hover:text-slate-300" %> &rsaquo;
    <span class="text-gray-900 dark:text-slate-100"><%= tournament_name %></span>
  </nav>

  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-semibold"><%= tournament_name %></h1>
      <p class="text-gray-600 dark:text-slate-400"><%= t("tournaments.show.subtitle") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if is_organizer %>
        <%= link_to t("tournaments.show.bracket_options"), options_tournaments_path(tournament_id: @tournament.id),
              class: "inline-flex items-center rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
        <%= link_to t("common.edit"), edit_tournament_path(@tournament),
              class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
        <%= button_to t("common.delete"), tournament_path(@tournament), method: :delete,
              form: { data: { turbo_confirm: t("tournaments.show.delete_confirm") } },
              class: "inline-flex items-center rounded-md border border-red-200 px-3 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50 dark:border-red-400/30 dark:text-red-300 dark:hover:bg-red-500/10" %>
      <% else %>
        <%= link_to t("tournaments.show.back"), tournaments_path,
              class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 p-6 shadow-sm">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.format") %></p>
        <p class="text-lg font-medium text-gray-900 dark:text-slate-100">
          <%= @tournament.format.present? ? t("tournaments.formats.#{@tournament.format}", default: @tournament.format.to_s.titleize) : "—" %>
        </p>
      </div>

      <div>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.type") %></p>
        <p class="text-lg font-medium text-gray-900 dark:text-slate-100"><%= t("tournaments.types.#{@tournament.tournament_type}") %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.players") %></p>
        <p class="text-lg font-medium text-gray-900 dark:text-slate-100">
          <%= @tournament.approved_participants_count %> / <%= @tournament.players_count.to_i.positive? ? @tournament.players_count : "?" %>
        </p>
      </div>

      <% if @tournament.start_date.present? %>
        <div>
          <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.start") %></p>
          <p class="text-lg font-medium text-gray-900 dark:text-slate-100">
            <%= @tournament.start_date.strftime("%d.%m.%Y") %>
            <% if @tournament.time.present? %>
              <span class="text-base text-gray-500 dark:text-slate-400"><%= @tournament.time.strftime("%H:%M") %></span>
            <% end %>
          </p>
        </div>
      <% end %>

      <% if @tournament.end_date.present? %>
        <div>
          <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.end_date") %></p>
          <p class="text-lg font-medium text-gray-900 dark:text-slate-100"><%= @tournament.end_date.strftime("%d.%m.%Y") %></p>
        </div>
      <% end %>

      <% if @tournament.courts.any? %>
        <div class="sm:col-span-2">
          <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.courts") %></p>
          <p class="text-lg font-medium text-indigo-700 dark:text-indigo-400">
            <%= safe_join(@tournament.courts.map { |court| link_to court.name, court_path(court), class: "transition-colors hover:text-indigo-800 hover:underline dark:hover:text-indigo-300" }, ", ") %>
          </p>
        </div>
      <% end %>

      <% if @tournament.games_count.present? %>
        <div>
          <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.planned_games") %></p>
          <p class="text-lg font-medium text-gray-900 dark:text-slate-100"><%= @tournament.games_count %></p>
        </div>
      <% end %>
    </div>

    <!-- Participants section -->
    <div class="border-t dark:border-white/10 pt-4 mt-4">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-2"><%= t("tournaments.show.participants") %></h2>
      <% if @participants.any? %>
        <div class="flex flex-wrap gap-2">
          <% @participants.each do |participant| %>
            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm <%= participant.pending? ? 'bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-200' : 'bg-gray-100 text-gray-700 dark:bg-slate-700/50 dark:text-slate-300' %>">
              <svg class="w-4 h-4 text-gray-400 dark:text-slate-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
              </svg>
              <%= participant.display_name %>
              <% if participant.pending? %>
                <span class="text-xs">· <%= t("tournaments.show.pending") %></span>
              <% end %>

              <% if is_organizer %>
                <span class="inline-flex items-center gap-1">
                  <% if participant.pending? %>
                    <%= button_to t("tournaments.show.approve"), tournament_participant_path(@tournament, participant), method: :patch,
                          class: "text-xs font-medium text-green-700 hover:underline dark:text-green-300" %>
                  <% end %>
                  <%= button_to t("tournaments.show.reject"), tournament_participant_path(@tournament, participant), method: :delete,
                        form: { data: { turbo_confirm: t("tournaments.show.remove_confirm") } },
                        class: "text-xs font-medium text-red-600 hover:underline dark:text-red-300" %>
                </span>
              <% end %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("tournaments.show.no_participants") %></p>
      <% end %>

      <!-- Join/Leave buttons -->
      <div class="mt-3">
        <% if !user_signed_in? %>
          <%= link_to t("tournaments.show.sign_in_to_join"), new_session_path,
                class: "inline-flex items-center rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
        <% elsif my_participation.present? %>
          <% if my_participation.pending? %>
            <p class="mb-2 text-sm text-amber-700 dark:text-amber-200"><%= t("tournaments.show.join_pending") %></p>
          <% end %>
          <%= button_to t("tournaments.show.leave"), leave_tournament_path(@tournament), method: :post,
                form: { data: { turbo_confirm: t("tournaments.show.leave_confirm") } },
                class: "inline-flex items-center rounded-full border border-red-200 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 transition dark:border-red-400/30 dark:text-red-300 dark:hover:bg-red-500/10" %>
        <% else %>
          <%= button_to ((@tournament.full? && !is_organizer) ? t("tournaments.show.request_join") : t("tournaments.show.join")),
                join_tournament_path(@tournament), method: :post,
                class: "inline-flex items-center rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Standings -->
  <div class="mt-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100 mb-4"><%= t("tournaments.show.standings") %></h2>
    <% if @standings.any? %>
      <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 shadow-sm overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-white/10">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">#</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.player") %></th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.wins") %></th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.losses") %></th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.sets") %></th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.games") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-white/10">
            <% @standings.each_with_index do |row, idx| %>
              <tr class="<%= idx == 0 ? 'bg-yellow-50 dark:bg-yellow-500/10' : '' %>">
                <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-slate-100"><%= idx + 1 %></td>
                <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-slate-100"><%= row[:user].name.presence || row[:user].email %></td>
                <td class="px-4 py-3 text-sm text-center text-green-700 font-semibold dark:text-green-300"><%= row[:wins] %></td>
                <td class="px-4 py-3 text-sm text-center text-red-600 dark:text-red-300"><%= row[:losses] %></td>
                <td class="px-4 py-3 text-sm text-center text-gray-600 dark:text-slate-400"><%= row[:sets_won] %>-<%= row[:sets_lost] %></td>
                <td class="px-4 py-3 text-sm text-center text-gray-600 dark:text-slate-400"><%= row[:games_won] %>-<%= row[:games_lost] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed dark:border-white/10 p-6 text-center text-gray-500 dark:text-slate-400">
        <%= t("tournaments.show.standings_empty") %>
      </div>
    <% end %>
  </div>

  <!-- Matches -->
  <div class="mt-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100 mb-4"><%= t("tournaments.show.matches") %></h2>
    <% if @matches.any? %>
      <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 shadow-sm overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-white/10">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase">#</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.player_a") %></th>
              <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.score") %></th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.player_b") %></th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-400 uppercase"><%= t("tournaments.show.date") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-white/10">
            <% @matches.each_with_index do |match, idx| %>
              <% team_a = [ match.player_a, match.player_a2 ].compact.map { |player| player.name.presence || player.email }.join(" / ") %>
              <% team_b = [ match.player_b, match.player_b2 ].compact.map { |player| player.name.presence || player.email }.join(" / ") %>
              <tr>
                <td class="px-4 py-3 text-sm text-gray-500 dark:text-slate-400"><%= idx + 1 %></td>
                <td class="px-4 py-3 text-sm font-medium <%= match.result == 'player_a' ? 'text-green-700 dark:text-green-300' : 'text-gray-900 dark:text-slate-100' %>">
                  <%= team_a %>
                  <% if match.result == "player_a" %>
                    <span class="text-xs text-green-600 dark:text-green-300"><%= t("tournaments.show.wins") %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-center font-mono font-medium text-gray-900 dark:text-slate-100"><%= match.score %></td>
                <td class="px-4 py-3 text-sm text-right font-medium <%= match.result == 'player_b' ? 'text-green-700 dark:text-green-300' : 'text-gray-900 dark:text-slate-100' %>">
                  <% if match.result == "player_b" %>
                    <span class="text-xs text-green-600 dark:text-green-300"><%= t("tournaments.show.wins") %></span>
                  <% end %>
                  <%= team_b %>
                </td>
                <td class="px-4 py-3 text-sm text-right text-gray-500 dark:text-slate-400"><%= match.played_at&.strftime("%d.%m %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed dark:border-white/10 p-6 text-center text-gray-500 dark:text-slate-400">
        <%= t("tournaments.show.matches_empty") %>
      </div>
    <% end %>

  </div>

  <!-- Tournament games: every match is also a regular game -->
  <div class="mt-8">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100"><%= t("tournaments.show.tournament_games") %></h2>
        <p class="text-sm text-gray-500 dark:text-slate-400 max-w-2xl"><%= t("tournaments.show.tournament_games_subtitle") %></p>
      </div>
      <% if @games.any? %>
        <%= link_to t("tournaments.show.open_in_games"), root_path(tournament_games: "1"),
              class: "shrink-0 inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      <% end %>
    </div>

    <% if @games.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <% @games.each do |game| %>
          <%= render partial: "games/card", locals: { game: game } %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed dark:border-white/10 p-6 text-center text-gray-500 dark:text-slate-400">
        <%= t("tournaments.show.tournament_games_empty") %>
      </div>
    <% end %>
  </div>

  <!-- Add match: for matches played outside the generated schedule -->
  <% if is_organizer %>
    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100"><%= t("tournaments.show.add_match") %></h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 max-w-2xl mb-4"><%= t("tournaments.show.add_match_hint") %></p>

      <% if @tournament.started? %>
        <% participant_options = @tournament.approved_participants.includes(:user).map { |participant| [ participant.display_name, participant.user_id ] } %>
        <% doubles = @tournament.doubles? %>
        <% select_classes = "block w-44 rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 shadow-sm text-sm" %>
        <% side_a_label = doubles ? t("games.show.team_a") : t("tournaments.show.player_a") %>
        <% side_b_label = doubles ? t("games.show.team_b") : t("tournaments.show.player_b") %>
        <div class="bg-white dark:bg-slate-800/80 rounded-lg border dark:border-white/10 p-4 shadow-sm">
          <%= form_tag add_match_tournament_path(@tournament), method: :post, class: "space-y-4" do %>
            <div class="flex flex-wrap items-end gap-3">
              <div>
                <label class="block text-xs text-gray-500 dark:text-slate-400 mb-1"><%= doubles ? t("tournaments.show.team_a_player", number: 1) : t("tournaments.show.player_a") %></label>
                <%= select_tag :player_a_id, options_for_select(participant_options), include_blank: t("tournaments.show.select"), class: select_classes %>
              </div>
              <% if doubles %>
                <div>
                  <label class="block text-xs text-gray-500 dark:text-slate-400 mb-1"><%= t("tournaments.show.team_a_player", number: 2) %></label>
                  <%= select_tag :player_a2_id, options_for_select(participant_options), include_blank: t("tournaments.show.select"), class: select_classes %>
                </div>
              <% end %>
              <div class="flex items-end pb-2 text-gray-400 dark:text-slate-500 font-medium"><%= t("tournaments.show.vs") %></div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-slate-400 mb-1"><%= doubles ? t("tournaments.show.team_b_player", number: 1) : t("tournaments.show.player_b") %></label>
                <%= select_tag :player_b_id, options_for_select(participant_options), include_blank: t("tournaments.show.select"), class: select_classes %>
              </div>
              <% if doubles %>
                <div>
                  <label class="block text-xs text-gray-500 dark:text-slate-400 mb-1"><%= t("tournaments.show.team_b_player", number: 2) %></label>
                  <%= select_tag :player_b2_id, options_for_select(participant_options), include_blank: t("tournaments.show.select"), class: select_classes %>
                </div>
              <% end %>
            </div>

            <div>
              <label class="block text-xs text-gray-500 dark:text-slate-400 mb-1"><%= t("tournaments.show.score") %></label>
              <%= render "games/score_board", field_name: "score", top_label: side_a_label, bottom_label: side_b_label %>
            </div>

            <%= submit_tag t("tournaments.show.add_match"), class: "inline-flex items-center rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition cursor-pointer" %>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-lg border border-amber-200 dark:border-amber-500/30 bg-amber-50 dark:bg-amber-500/15 p-4 text-sm text-amber-700 dark:text-amber-200">
          <% if @tournament.starts_at.present? %>
            <%= t("tournaments.show.add_match_locked_at", date: @tournament.starts_at.strftime("%d.%m.%Y %H:%M")) %>
          <% else %>
            <%= t("tournaments.show.add_match_locked") %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="max-w-5xl mx-auto px-4 py-6">
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-4">
    <%= link_to "Home", root_path, class: "hover:text-gray-700" %> &rsaquo;
    <%= link_to "Tournaments", tournaments_path, class: "hover:text-gray-700" %> &rsaquo;
    <span class="text-gray-900"><%= @tournament.name.presence || "Tournament" %></span>
  </nav>

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold"><%= @tournament.name.presence || "Tournament" %></h1>
      <p class="text-gray-600">Tournament details and results.</p>
    </div>
    <% if user_signed_in? && @tournament.user_id == current_user.id %>
      <%= link_to options_tournaments_path(tournament_id: @tournament.id), class: "inline-flex items-center gap-1.5 rounded-full bg-purple-600 px-5 py-2 text-sm font-medium text-white hover:bg-purple-700 transition" do %>
        Bracket options
      <% end %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg border p-6 shadow-sm">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <p class="text-sm text-gray-500">Format</p>
        <p class="text-lg font-medium text-gray-900"><%= @tournament.format&.humanize || "—" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500">Players</p>
        <p class="text-lg font-medium text-gray-900">
          <%= @tournament.tournament_participants.count %> / <%= @tournament.players_count || "?" %>
        </p>
      </div>

      <% if @tournament.start_date.present? %>
        <div>
          <p class="text-sm text-gray-500">Start</p>
          <p class="text-lg font-medium text-gray-900">
            <%= @tournament.start_date.strftime("%B %d, %Y") %>
            <% if @tournament.time.present? %>
              <span class="text-base text-gray-500"><%= @tournament.time.strftime("%H:%M") %></span>
            <% end %>
          </p>
        </div>
      <% end %>

      <% if @tournament.end_date.present? %>
        <div>
          <p class="text-sm text-gray-500">End date</p>
          <p class="text-lg font-medium text-gray-900"><%= @tournament.end_date.strftime("%B %d, %Y") %></p>
        </div>
      <% end %>

      <% if @tournament.respond_to?(:courts) && @tournament.courts.any? %>
        <div class="sm:col-span-2">
          <p class="text-sm text-gray-500">Courts</p>
          <p class="text-lg font-medium text-gray-900"><%= @tournament.courts.map(&:name).to_sentence %></p>
        </div>
      <% end %>

      <% if @tournament.respond_to?(:games_count) && @tournament.games_count.present? %>
        <div>
          <p class="text-sm text-gray-500">Planned games</p>
          <p class="text-lg font-medium text-gray-900"><%= @tournament.games_count %></p>
        </div>
      <% end %>
    </div>

    <!-- Participants section -->
    <div class="border-t pt-4 mt-4">
      <h2 class="text-sm font-semibold text-gray-700 mb-2">Participants</h2>
      <% participants = @tournament.tournament_participants.includes(:user) %>
      <% if participants.any? %>
        <div class="flex flex-wrap gap-2">
          <% participants.each do |tp| %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700">
              <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
              </svg>
              <%= tp.name.presence || tp.user&.name.presence || tp.user&.email || "Player" %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No participants yet.</p>
      <% end %>

      <!-- Join/Leave buttons -->
      <% if user_signed_in? %>
        <div class="mt-3">
          <% is_participant = @tournament.tournament_participants.exists?(user: current_user) %>
          <% if is_participant %>
            <%= link_to "Leave tournament", leave_tournament_path(@tournament), method: :post, data: { turbo_method: :post, turbo_confirm: "Leave this tournament?" },
                        class: "inline-flex items-center rounded-full border border-red-200 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 transition" %>
          <% elsif @tournament.user_id != current_user.id %>
            <%= link_to "Join tournament", join_tournament_path(@tournament), method: :post, data: { turbo_method: :post },
                        class: "inline-flex items-center rounded-full bg-purple-600 px-4 py-2 text-sm font-medium text-white hover:bg-purple-700 transition" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Tournament Game Results -->
  <div class="mt-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Game Results</h2>
    </div>

    <% games = @tournament.games.includes(:court).order(:created_at).to_a %>
    <% game_ids = games.map(&:id) %>
    <% matches_by_game_id = game_ids.empty? ? {} : Match.where(game_id: game_ids).index_by(&:game_id) %>
    <% stat_entries_by_game_id = game_ids.empty? ? {} : PlayerStatisticEntry.where(game_id: game_ids).index_by(&:game_id) %>
    <% if games.any? %>
      <div class="bg-white rounded-lg border shadow-sm overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">#</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Score</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Hours</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Added</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% games.each_with_index do |game, idx| %>
              <% match = matches_by_game_id[game.id] %>
              <% stat_entry = stat_entries_by_game_id[game.id] %>
              <% hours_key = @tournament.format == "doubles" ? "doubles_hours" : "singles_hours" %>
              <% hours_val = stat_entry&.data&.dig(hours_key) %>
              <tr>
                <td class="px-4 py-3 text-sm text-gray-900"><%= idx + 1 %></td>
                <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= match&.score.presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-gray-700"><%= hours_val ? "#{hours_val}h" : "—" %></td>
                <td class="px-4 py-3 text-sm text-gray-500"><%= game.created_at.strftime("%d.%m %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed p-8 text-center text-gray-500">
        No game results yet.
      </div>
    <% end %>

    <!-- Add game result form -->
    <% if user_signed_in? && @tournament.user_id == current_user.id %>
      <div class="mt-4">
        <% if @tournament.started? %>
          <div class="bg-white rounded-lg border p-4 shadow-sm">
            <h3 class="text-sm font-semibold text-gray-700 mb-3">Add game result</h3>
            <%= form_tag add_game_result_tournament_path(@tournament), method: :post, class: "flex flex-wrap items-end gap-3" do %>
              <div>
                <label class="block text-xs text-gray-500 mb-1">Participant</label>
                <% participant_options = @tournament.tournament_participants.includes(:user).map { |tp| [tp.name.presence || tp.user&.name.presence || tp.user&.email || "Player", tp.user_id] } %>
                <%= select_tag :user_id, options_for_select(participant_options), include_blank: "Select", class: "block w-48 rounded-md border-gray-300 shadow-sm text-sm" %>
              </div>
              <div>
                <label class="block text-xs text-gray-500 mb-1">Score</label>
                <%= text_field_tag :score, nil, placeholder: "6-4 6-3", class: "block w-40 rounded-md border-gray-300 shadow-sm text-sm" %>
              </div>
              <div>
                <label class="block text-xs text-gray-500 mb-1">Hours</label>
                <%= number_field_tag :hours, nil, step: 0.5, min: 0, placeholder: "1.5", class: "block w-24 rounded-md border-gray-300 shadow-sm text-sm" %>
              </div>
              <%= submit_tag "Add result", class: "inline-flex items-center rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition cursor-pointer" %>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-700">
            Statistics will be available after the tournament starts
            <% if @tournament.start_date.present? %>
              (<%= @tournament.start_date.strftime("%B %d, %Y") %><% if @tournament.time.present? %> at <%= @tournament.time.strftime("%H:%M") %><% end %>).
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

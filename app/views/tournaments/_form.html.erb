<%= form_with model: tournament, url: tournaments_path, local: true do |f| %>
  <div class="bg-white dark:bg-slate-800/80 shadow sm:rounded-lg p-6">
    <div class="grid grid-cols-1 gap-6">
      <div>
        <%= f.label :name, "Tournament name", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= f.text_field :name, maxlength: 200, class: "mt-1 block w-full rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 shadow-sm" %>
      </div>

      <div>
        <%= f.label :players_count, "Number of players", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= f.number_field :players_count, min: 2, class: "mt-1 block w-32 rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 shadow-sm" %>
      </div>

      <div>
        <%= f.label :games_count, "Number of games", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <div class="mt-1 flex items-center gap-4">
          <%= f.number_field :games_count, min: 1, class: "block w-32 rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 shadow-sm", id: "tournament_games_count_field", disabled: tournament.games_count.nil? && tournament.persisted? %>
          <label class="inline-flex items-center text-sm text-gray-600 dark:text-slate-400">
            <%= check_box_tag "games_count_unknown", "1", tournament.games_count.nil?,
                  class: "form-checkbox h-4 w-4 text-indigo-600",
                  onchange: "var field = document.getElementById('tournament_games_count_field'); field.disabled = this.checked; if(this.checked) field.value = '';" %>
            <span class="ml-2">Unknown (will be added during tournament)</span>
          </label>
        </div>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">If unknown, games can be created and added as the tournament progresses.</p>
      </div>

      <div>
        <span class="block text-sm font-medium text-gray-700 dark:text-slate-300">Format</span>
        <div class="mt-2 flex items-center gap-6">
          <label class="inline-flex items-center">
            <%= f.radio_button :format, "singles", class: "form-radio" %>
            <span class="ml-2 text-sm text-gray-700 dark:text-slate-300">Singles (1 on 1)</span>
          </label>
          <label class="inline-flex items-center">
            <%= f.radio_button :format, "doubles", class: "form-radio" %>
            <span class="ml-2 text-sm text-gray-700 dark:text-slate-300">Doubles (2 on 2)</span>
          </label>
        </div>
      </div>

      <div>
        <%= f.label :court_ids, "Select courts", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2">
          <% Court.sorted_for_user(current_user).each do |court| %>
            <label class="inline-flex items-center text-sm text-gray-700 dark:text-slate-300">
              <%= check_box_tag "tournament[court_ids][]", court.id, tournament.court_ids&.include?(court.id), id: "tournament_court_#{court.id}", class: "form-checkbox" %>
              <span class="ml-2"><%= court.name %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :start_date, "Start date", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= f.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 shadow-sm" %>
        </div>
        <div>
          <%= f.label :time, "Start time", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= f.time_field :time, class: "mt-1 block w-full rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 shadow-sm" %>
        </div>
        <div>
          <%= f.label :end_date, "End date (optional)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= f.date_field :end_date, class: "mt-1 block w-full rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 shadow-sm" %>
        </div>
      </div>

      <div class="flex items-center justify-between mt-4">
        <%= link_to "Cancel", tournaments_path, class: "text-sm text-gray-600 dark:text-slate-400 hover:underline" %>
        <%= f.submit "Next — Bracket options", class: "btn" %>
      </div>
    </div>
  </div>
<% end %>

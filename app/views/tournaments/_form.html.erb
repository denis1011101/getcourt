<%= form_with model: tournament, url: tournaments_path, local: true do |f| %>
  <div class="bg-white shadow sm:rounded-lg p-6">
    <div class="grid grid-cols-1 gap-6">
      <div>
        <%= f.label :name, "Tournament name", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, maxlength: 200, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <div>
        <%= f.label :players_count, "Number of players", class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :players_count, min: 2, class: "mt-1 block w-32 rounded-md border-gray-300 shadow-sm" %>
      </div>

      <div>
        <span class="block text-sm font-medium text-gray-700">Format</span>
        <div class="mt-2 flex items-center gap-6">
          <label class="inline-flex items-center">
            <%= f.radio_button :format, "singles", class: "form-radio" %>
            <span class="ml-2 text-sm text-gray-700">Singles (1 on 1)</span>
          </label>
          <label class="inline-flex items-center">
            <%= f.radio_button :format, "doubles", class: "form-radio" %>
            <span class="ml-2 text-sm text-gray-700">Doubles (2 on 2)</span>
          </label>
        </div>
      </div>

      <div>
        <%= f.label :court_ids, "Select courts", class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2">
          <% Court.all.each do |court| %>
            <label class="inline-flex items-center text-sm text-gray-700">
              <%= check_box_tag "tournament[court_ids][]", court.id, tournament.court_ids&.include?(court.id), id: "tournament_court_#{court.id}", class: "form-checkbox" %>
              <span class="ml-2"><%= court.name %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :start_date, "Start date", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= f.label :end_date, "End date (optional)", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :end_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
      </div>

      <div class="flex items-center justify-between mt-4">
        <%= link_to "Cancel", tournaments_path, class: "text-sm text-gray-600 hover:underline" %>
        <%= f.submit "Next — Bracket options", class: "btn" %>
      </div>
    </div>
  </div>
<% end %>

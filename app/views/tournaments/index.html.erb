<div class="max-w-5xl mx-auto px-4 py-2">
  <%= render "shared/page_header",
      title: "Tournaments",
      description: "Create and manage tournaments.",
      action_text: "Create tournament",
      action_path: new_tournament_path %>

  <!-- Filter chips -->
  <% if user_signed_in? %>
    <div class="mb-5 -mx-4 px-4">
      <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
        <% my_active = params[:my_tournaments].present? %>
        <%= link_to tournaments_path(my_tournaments: my_active ? nil : "1"),
              class: "flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                     #{my_active ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25'}" do %>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
            </svg>
            My Tournaments
          </span>
        <% end %>

        <% if my_active %>
          <%= link_to tournaments_path, class: "flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 transition" do %>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              Reset
            </span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @tournaments.empty? %>
    <div class="rounded-lg border border-dashed p-8 text-center text-gray-500 dark:border-white/10 dark:text-slate-400">
      <% if params[:my_tournaments].present? %>
        You don't have any tournaments yet.
      <% else %>
        No tournaments yet.
      <% end %>
      <div class="mt-4">
        <%= link_to "Create tournament", new_tournament_path,
              class: "inline-flex items-center gap-1.5 rounded-full bg-purple-600 px-5 py-2 text-sm font-medium text-white hover:bg-purple-700 transition" %>
      </div>
    </div>
  <% else %>
    <div class="flex items-center justify-between mb-4">
      <p class="text-sm text-gray-500 dark:text-slate-400">
        <%= @tournaments.size %> tournament<%= @tournaments.size == 1 ? '' : 's' %>
        <% if params[:my_tournaments].present? %>
          &middot; My Tournaments
        <% end %>
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @tournaments.each do |tournament| %>
        <div>
          <%= render partial: "tournaments/card", locals: { tournament: tournament } %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

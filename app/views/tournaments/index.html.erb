<% content_for :meta_title, t("tournaments.index.meta_title") %>
<% content_for :meta_description, t("tournaments.index.meta_description") %>
<div class="max-w-6xl mx-auto">
  <!-- Hero section -->
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-indigo-600 via-indigo-500 to-purple-500 px-6 py-5 md:px-10 md:py-8 mb-6 text-white ring-1 ring-white/15 shadow-[0_20px_60px_rgba(79,70,229,0.18)] dark:from-indigo-900 dark:via-indigo-800 dark:to-fuchsia-800 dark:ring-white/10 dark:shadow-[0_24px_70px_rgba(15,23,42,0.45)]">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/14 via-white/5 to-transparent dark:from-white/8 dark:via-indigo-400/5 dark:to-transparent"></div>
    <div class="pointer-events-none absolute -top-24 -right-24 w-72 h-72 rounded-full bg-purple-400/20 blur-3xl dark:bg-fuchsia-500/15 animate-pulse [animation-duration:4s]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-16 w-56 h-56 rounded-full bg-indigo-300/15 blur-3xl dark:bg-indigo-400/10"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/30 dark:bg-white/15"></div>
    <!-- Decorative tennis court lines -->
    <svg class="pointer-events-none absolute right-4 md:right-10 top-1/2 -translate-y-1/2 w-24 h-32 md:w-32 md:h-44 opacity-[0.08] dark:opacity-[0.06]" viewBox="0 0 120 160" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="4" y="4" width="112" height="152" rx="2"/>
      <line x1="18" y1="4" x2="18" y2="156"/>
      <line x1="102" y1="4" x2="102" y2="156"/>
      <line x1="4" y1="80" x2="116" y2="80"/>
      <line x1="18" y1="52" x2="102" y2="52"/>
      <line x1="18" y1="108" x2="102" y2="108"/>
      <line x1="60" y1="52" x2="60" y2="108"/>
      <line x1="56" y1="4" x2="64" y2="4"/>
      <line x1="56" y1="156" x2="64" y2="156"/>
    </svg>

    <div class="relative">
      <h1 class="text-xl md:text-3xl font-bold tracking-tight"><%= t("tournaments.index.hero_title") %><span class="inline-flex items-center ml-1" style="vertical-align: -0.02em;"><svg viewBox="0 0 24 24" style="width: 0.26em; height: 0.26em;" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#d4f542"/><path d="M3 8 Q9 12 3 16" fill="none" stroke="white" stroke-width="1.8" opacity="0.7" stroke-linecap="round"/><path d="M21 8 Q15 12 21 16" fill="none" stroke="white" stroke-width="1.8" opacity="0.7" stroke-linecap="round"/></svg></span></h1>
      <p class="mt-1 text-white/90 dark:text-indigo-100 text-sm max-w-xl"><%= t("tournaments.index.hero_subtitle") %></p>
    </div>
  </div>

  <div class="mb-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-slate-100"><%= t("tournaments.index.title") %></h2>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-1"><%= t("tournaments.index.subtitle") %></p>
    </div>

    <!-- Filter chips -->
    <% chip_params = ->(overrides) { request.query_parameters.merge(overrides).reject { |_, value| value.blank? } } %>
    <% chip_classes = ->(active) { "flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition #{active ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25'}" } %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% if user_signed_in? %>
        <% my_active = params[:my_tournaments].present? %>
        <%= link_to tournaments_path(chip_params.call("my_tournaments" => my_active ? nil : "1")), class: chip_classes.call(my_active) do %>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
            </svg>
            <%= t("tournaments.index.my_tournaments") %>
          </span>
        <% end %>
      <% end %>

      <% Tournament::FORMATS.each do |tournament_format| %>
        <% active = params[:tournament_format] == tournament_format %>
        <%= link_to t("tournaments.formats.#{tournament_format}"),
              tournaments_path(chip_params.call("tournament_format" => active ? nil : tournament_format)),
              class: chip_classes.call(active) %>
      <% end %>

      <% Tournament.tournament_types.each_key do |type| %>
        <% active = params[:tournament_type] == type %>
        <%= link_to t("tournaments.types.#{type}"),
              tournaments_path(chip_params.call("tournament_type" => active ? nil : type)),
              class: chip_classes.call(active) %>
      <% end %>

      <% if params[:my_tournaments].present? || params[:tournament_format].present? || params[:tournament_type].present? %>
        <%= link_to tournaments_path, class: "flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 transition" do %>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <%= t("common.reset") %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-between mb-4">
    <p class="text-sm text-gray-500 dark:text-slate-400" data-testid="results-summary">
      <%= t("tournaments.index.count", count: @tournaments.size) %>
    </p>

    <% if user_signed_in? %>
      <%= link_to new_tournament_path, class: "hidden md:inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        <%= t("tournaments.index.new_tournament") %>
      <% end %>
    <% end %>
  </div>

  <!-- Tournaments grid -->
  <% if @tournaments.empty? %>
    <div class="rounded-2xl border-2 border-dashed border-gray-200 p-12 text-center dark:border-white/10">
      <svg class="mx-auto w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M18.75 4.236c.982.143 1.954.317 2.916.52A6.003 6.003 0 0016.27 9.728M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228m0 0a6.003 6.003 0 01-5.54 0"/>
      </svg>
      <p class="text-gray-500 font-medium">
        <%= params[:my_tournaments].present? ? t("tournaments.index.empty_mine") : t("tournaments.index.empty_title") %>
      </p>
      <p class="text-gray-400 text-sm mt-1"><%= t("tournaments.index.empty_subtitle") %></p>
      <% if user_signed_in? %>
        <%= link_to t("tournaments.index.create_tournament"), new_tournament_path,
              class: "inline-flex items-center gap-1.5 mt-4 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @tournaments.each do |tournament| %>
        <%= render partial: "tournaments/card", locals: { tournament: tournament } %>
      <% end %>
    </div>
  <% end %>
</div>

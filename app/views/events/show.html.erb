<% content_for :meta_title, "#{@featured_match.seo_title} | GetCourt" %>
<% content_for :meta_description, @featured_match.seo_description %>
<% content_for :meta_image, @featured_match.og_image_url(host: request.host_with_port, protocol: request.protocol) || meta_image %>
<% content_for :meta_og_type, "website" %>
<% content_for :head do %>
  <%= render "featured_matches/meta", featured_match: @featured_match %>
<% end %>

<div class="max-w-4xl mx-auto">
  <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-5 text-gray-900 dark:text-white"><%= @featured_match.seo_title %></h1>

  <%= render "featured_matches/banner", featured_match: @featured_match %>

  <% if @featured_match.photo_credit.present? %>
    <p class="mt-2 text-xs text-gray-500 dark:text-slate-400">
      <%= t("featured_match.event.photo_credit") %>:
      <% if @featured_match.photo_credit_url.present? %>
        <%= link_to @featured_match.photo_credit, @featured_match.photo_credit_url, target: "_blank", rel: "noopener nofollow", class: "underline" %>
      <% else %>
        <%= @featured_match.photo_credit %>
      <% end %>
    </p>
  <% end %>

  <% if @wallchart_event %>
    <!-- Before kickoff — Wallchart '26 (green accent) -->
    <section class="mt-8 rounded-2xl border border-emerald-200/60 bg-emerald-50 p-6 md:p-8 dark:border-emerald-900/40 dark:bg-emerald-950/20">
      <div class="text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400">Wallchart&nbsp;'26</div>
      <h2 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">
        <%= @wallchart_predictions_open ? t("featured_match.event.wallchart.before_title") : t("featured_match.event.wallchart.locked_title") %>
      </h2>
      <div class="mt-3 space-y-4 text-gray-700 dark:text-slate-300 leading-7">
        <p><%= t("featured_match.event.wallchart.before_p1") %></p>
        <p><%= @wallchart_predictions_open ? t("featured_match.event.wallchart.before_p2") : t("featured_match.event.wallchart.locked_p2") %></p>
      </div>
      <% if @wallchart_predictions_open %>
        <div class="mt-5">
          <%= link_to "https://wallchart26.com/?utm_source=getcourt&utm_medium=event", target: "_blank", rel: "noopener",
                data: wallchart_analytics_data(@featured_match, click_event: "wallchart_prediction_clicked"),
                class: "group inline-flex items-center gap-2 rounded-lg bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white no-underline transition hover:bg-emerald-800" do %>
            <%= t("featured_match.event.wallchart.predict_cta") %>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </section>

    <!-- Watch the final together — Moment hookah space (blue accent + logo) -->
    <section class="mt-8 rounded-2xl border border-sky-200/60 bg-sky-50 p-6 md:p-8 dark:border-sky-900/40 dark:bg-sky-950/20">
      <div class="flex items-center gap-4">
        <%= render "shared/moment_logo", classes: "w-16 h-16" %>
        <div>
          <div class="text-xs font-semibold uppercase tracking-wide text-[#1666c0] dark:text-[#5aa2e6]"><%= t("featured_match.event.wallchart.venue_kind") %></div>
          <h2 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white"><%= t("featured_match.event.wallchart.watch_title") %></h2>
        </div>
      </div>
      <div class="mt-4 text-gray-700 dark:text-slate-300 leading-7">
        <p><%= t("featured_match.event.wallchart.watch_intro") %></p>
        <p class="mt-3 font-semibold text-gray-900 dark:text-white"><%= t("featured_match.event.wallchart.venue_name") %></p>
        <p><%= t("featured_match.event.wallchart.venue_address") %></p>
      </div>
      <div class="mt-5">
        <%= link_to "https://yandex.com/maps/-/CTFs46~-", target: "_blank", rel: "noopener",
              data: wallchart_analytics_data(@featured_match, click_event: "wallchart_map_clicked"),
              class: "inline-flex items-center gap-2 rounded-lg border border-[#1666c0]/40 px-5 py-2.5 text-sm font-semibold text-[#1666c0] no-underline transition hover:bg-[#1666c0] hover:text-white dark:text-[#5aa2e6] dark:hover:text-white" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
          <%= t("featured_match.event.wallchart.maps_cta") %>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="mt-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white"><%= t("featured_match.event.about") %></h2>
      <div class="mt-3 text-gray-700 dark:text-slate-300 leading-7">
        <% if @featured_match.description.present? %>
          <%= simple_format(@featured_match.description) %>
        <% else %>
          <p><%= t("featured_match.event.about_fallback", title: @featured_match.seo_title, date: l(@featured_match.starts_at, format: :long)) %></p>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @featured_match.status == "finished" && @featured_match.result.present? %>
    <section class="mt-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white"><%= t("featured_match.event.result") %></h2>
      <div class="mt-3 text-gray-700 dark:text-slate-300 leading-7">
        <%= simple_format(@featured_match.result) %>
      </div>
    </section>
  <% end %>
</div>

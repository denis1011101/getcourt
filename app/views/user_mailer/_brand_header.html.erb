<%# One header for every HTML email, matching the site logo: "Get" over "Court" with
    the lime ball. Flat indigo instead of the site gradient — Gmail and Outlook drop
    background-clip: text, and the ball is a styled span because they strip SVG. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 16px;">
  <tr>
    <td style="font-size: 22px; font-weight: 700; line-height: 1.05; color: #4f46e5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      Get<br>Court<span style="display: inline-block; width: 7px; height: 7px; margin-left: 3px; border-radius: 50%; background: #d4f542;">&nbsp;</span>
    </td>
  </tr>
</table>

<%# Разметка корта: статика, её незачем гонять через JS. Размеры взяты из
    настоящих: парный корт 10.97 × 23.77 м внутри площадки 18.29 × 36.58 м,
    отсюда viewBox 100 × 200 и все круглые числа ниже. %>
<rect x="0" y="0" width="100" height="200" fill="#166534" />
<rect x="20" y="35" width="60" height="130" fill="#15803D" />

<g stroke="#F8FAFC" stroke-width="0.7" fill="none">
  <%# парные боковые и задние %>
  <rect x="20" y="35" width="60" height="130" />
  <%# одиночные боковые %>
  <line x1="27.5" y1="35" x2="27.5" y2="165" />
  <line x1="72.5" y1="35" x2="72.5" y2="165" />
  <%# линии подачи и центральная %>
  <line x1="27.5" y1="65" x2="72.5" y2="65" />
  <line x1="27.5" y1="135" x2="72.5" y2="135" />
  <line x1="50" y1="65" x2="50" y2="135" />
  <%# метки центра на задних линиях %>
  <line x1="50" y1="35" x2="50" y2="38" />
  <line x1="50" y1="162" x2="50" y2="165" />
</g>

<%# сетка вместе со столбами шире парных линий %>
<line x1="15" y1="100" x2="85" y2="100" stroke="#E2E8F0" stroke-width="1.4" />

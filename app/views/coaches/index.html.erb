<% content_for :meta_description, "Browse tennis coaches and find a trainer in your city." %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold text-gray-900">Coaches</h1>
  <p class="mt-1 text-sm text-gray-600">Find a coach and contact them in chat or by Telegram username.</p>

  <% if @coaches.any? %>
    <div class="mt-5 space-y-3">
      <% @coaches.each do |coach| %>
        <article class="rounded-xl border border-gray-200 bg-white p-4">
          <h2 class="text-base font-semibold text-gray-900">
            <%= coach.name.presence || coach.email %>
          </h2>

          <p class="mt-1 text-sm text-gray-700">
            <span class="font-medium text-gray-800">Sports:</span>
            <%= coach.preferred_sports.present? ? Array(coach.preferred_sports).join(", ") : "Not specified" %>
          </p>

          <p class="mt-1 text-sm text-gray-700">
            <span class="font-medium text-gray-800">City:</span>
            <%= coach.city_name.presence || "Not specified" %>
          </p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-5 rounded-xl border border-dashed border-gray-300 bg-white p-4 text-sm text-gray-600">
      No coaches yet.
    </p>
  <% end %>
</div>

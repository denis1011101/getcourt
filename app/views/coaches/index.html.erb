<% content_for :meta_title, t("coaches.index.meta_title") %>
<% content_for :meta_description, t("coaches.index.meta_description") %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold text-gray-900 dark:text-slate-100"><%= t("coaches.index.title") %></h1>
  <p class="mt-1 text-sm text-gray-600 dark:text-slate-400"><%= t("coaches.index.subtitle") %></p>

  <%= render "shared/location_filters",
        url: coaches_path,
        countries: @countries,
        cities: @cities,
        selected_country: params[:country],
        selected_city: params[:city],
        compact: true %>

  <% location_filtered = params[:country].present? || params[:city].present? %>
  <% active_filters = location_filter_labels %>

  <div class="mt-4 flex items-center justify-between gap-3">
    <p class="text-sm text-gray-500 dark:text-slate-400" data-testid="results-summary">
      <%= t("coaches.index.count", count: @coaches.size) %>
      <% if active_filters.any? %>
        &middot; <%= safe_join(active_filters, " &middot; ".html_safe) %>
      <% end %>
    </p>

    <% if location_filtered %>
      <%= link_to coaches_path, class: "flex-shrink-0 rounded-full px-4 py-1.5 text-sm font-medium border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 transition" do %>
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          <%= t("common.reset") %>
        </span>
      <% end %>
    <% end %>
  </div>

  <% if @coaches.any? %>
    <div class="mt-5 space-y-3">
      <% @coaches.each do |coach| %>
        <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-slate-800/80 p-4">
          <h2 class="text-base font-semibold text-gray-900 dark:text-slate-100">
            <%= coach.name.presence || coach.email %>
            <% tg = coach.telegram_username.to_s.strip.delete_prefix("@") %>
            <% if tg.present? %>
              (<%= link_to tg, "https://t.me/#{tg}", target: "_blank", rel: "noopener nofollow", class: "text-sm font-normal text-indigo-600 dark:text-indigo-400 hover:underline" %>)
            <% end %>
          </h2>

          <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
            <span class="font-medium text-gray-800 dark:text-slate-200"><%= t("coaches.index.sports_label") %>:</span>
            <%= coach.preferred_sports.present? ? Array(coach.preferred_sports).join(", ") : t("common.not_specified") %>
          </p>

          <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
            <span class="font-medium text-gray-800 dark:text-slate-200"><%= t("coaches.index.city_label") %>:</span>
            <%= coach.city_name.presence || t("common.not_specified") %>
          </p>

          <% if coach.court_preferences_note.present? %>
            <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
              <span class="font-medium text-gray-800 dark:text-slate-200"><%= t(".courts_label") %>:</span>
              <%= coach.court_preferences_note %>
            </p>
          <% elsif coach.favorite_courts.any? %>
            <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
              <span class="font-medium text-gray-800 dark:text-slate-200"><%= t(".courts_label") %>:</span>
              <%= safe_join(
                    coach.favorite_courts.map do |court|
                      link_to court.name, court_path(court), class: "text-indigo-600 hover:underline dark:text-indigo-400"
                    end,
                    ", "
                  ) %>
            </p>
          <% end %>

          <% if coach.about_me.present? %>
            <p class="mt-2 text-sm text-gray-600 dark:text-slate-400"><%= coach.about_me %></p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% elsif location_filtered %>
    <div class="mt-6 rounded-lg border border-dashed border-gray-200 dark:border-white/10 p-8 text-center text-sm text-gray-500 dark:text-slate-400">
      <p><%= t("coaches.index.empty_location") %></p>
      <%= link_to t("coaches.index.show_all"), coaches_path, class: "inline-flex items-center gap-1.5 mt-4 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
    </div>
  <% else %>
    <div class="mt-6 space-y-4 text-sm text-gray-600 dark:text-slate-400">
      <p><%= t("coaches.index.empty_html", link: link_to(t("coaches.index.create_account"), new_session_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline")) %></p>

      <div>
        <h2 class="text-base font-semibold text-gray-800 dark:text-slate-200 mb-2"><%= t("coaches.index.how_to_title") %></h2>
        <ul class="list-disc list-inside space-y-1">
          <li><%= t("coaches.index.how_to_1") %></li>
          <li><%= t("coaches.index.how_to_2") %></li>
          <li><%= t("coaches.index.how_to_3") %></li>
        </ul>
      </div>

      <div>
        <h2 class="text-base font-semibold text-gray-800 dark:text-slate-200 mb-2"><%= t("coaches.index.for_coaches_title") %></h2>
        <p><%= t("coaches.index.for_coaches_body") %></p>
      </div>
    </div>
  <% end %>

  <%= render "shared/pages_nav" %>
</div>

<% content_for :meta_title, "Find a Tennis Coach — GetCourt" %>
<% content_for :meta_description, "Find a professional tennis coach near you. Browse instructor profiles, see their sports and city, and contact them directly via Telegram on GetCourt." %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold text-gray-900 dark:text-slate-100">Find a Tennis Coach</h1>
  <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">Browse tennis instructors and contact them directly in chat or by Telegram username.</p>

  <% if @coaches.any? %>
    <div class="mt-5 space-y-3">
      <% @coaches.each do |coach| %>
        <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-slate-800/80 p-4">
          <h2 class="text-base font-semibold text-gray-900 dark:text-slate-100">
            <%= coach.name.presence || coach.email %>
            <% tg = coach.telegram_username.to_s.strip.delete_prefix("@") %>
            <% if tg.present? %>
              (<%= link_to tg, "https://t.me/#{tg}", target: "_blank", rel: "noopener nofollow", class: "text-sm font-normal text-indigo-600 dark:text-indigo-400 hover:underline" %>)
            <% end %>
          </h2>

          <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
            <span class="font-medium text-gray-800 dark:text-slate-200">Sports:</span>
            <%= coach.preferred_sports.present? ? Array(coach.preferred_sports).join(", ") : "Not specified" %>
          </p>

          <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
            <span class="font-medium text-gray-800 dark:text-slate-200">City:</span>
            <%= coach.city_name.presence || "Not specified" %>
          </p>

          <% if coach.court_preferences_note.present? %>
            <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
              <span class="font-medium text-gray-800 dark:text-slate-200"><%= t(".courts_label") %>:</span>
              <%= coach.court_preferences_note %>
            </p>
          <% elsif coach.favorite_courts.any? %>
            <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">
              <span class="font-medium text-gray-800 dark:text-slate-200"><%= t(".courts_label") %>:</span>
              <%= safe_join(
                    coach.favorite_courts.map do |court|
                      link_to court.name, court_path(court), class: "text-indigo-600 hover:underline dark:text-indigo-400"
                    end,
                    ", "
                  ) %>
            </p>
          <% end %>

          <% if coach.about_me.present? %>
            <p class="mt-2 text-sm text-gray-600 dark:text-slate-400"><%= coach.about_me %></p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-6 space-y-4 text-sm text-gray-600 dark:text-slate-400">
      <p>
        No coaches have joined yet. If you are a tennis instructor, you can
        <%= link_to "create an account", new_session_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline" %>
        and enable the coach profile in your account settings — your profile will appear here.
      </p>

      <div>
        <h2 class="text-base font-semibold text-gray-800 dark:text-slate-200 mb-2">How to choose a tennis coach</h2>
        <ul class="list-disc list-inside space-y-1">
          <li>Look for a coach whose skill level matches yours — beginner, intermediate, or advanced.</li>
          <li>Check the city so you can find someone who trains locally or online.</li>
          <li>Reach out directly via Telegram to discuss schedule, price, and format.</li>
        </ul>
      </div>

      <div>
        <h2 class="text-base font-semibold text-gray-800 dark:text-slate-200 mb-2">For coaches</h2>
        <p>
          GetCourt is a free platform for organising tennis games and connecting with players.
          Register, fill in your sport and city, and players in your area will be able to find and contact you.
        </p>
      </div>
    </div>
  <% end %>

  <%= render "shared/pages_nav" %>
</div>

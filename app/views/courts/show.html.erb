<% content_for :meta_title, t("courts.show.meta_title", court: @court.name) %>
<% content_for :meta_description, t("courts.show.meta_description", court: @court.name) %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= json_escape({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t("layout.nav.home"), "item": root_url },
        { "@type": "ListItem", "position": 2, "name": t("layout.nav.courts"), "item": courts_url },
        { "@type": "ListItem", "position": 3, "name": @court.name }
      ]
    }.to_json).html_safe %>
  </script>
<% end %>

<div class="max-w-6xl mx-auto py-4">
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 dark:text-slate-400 mb-4">
    <%= link_to t("layout.nav.home"), root_path, class: "hover:text-gray-700 dark:hover:text-white" %> &rsaquo;
    <%= link_to t("layout.nav.courts"), courts_path, class: "hover:text-gray-700 dark:hover:text-white" %> &rsaquo;
    <span class="text-gray-900 dark:text-slate-100"><%= @court.name %></span>
  </nav>

  <% raw_address = @court.address %>
  <% court_location = (raw_address.present? && raw_address != "Unknown address" && raw_address != "Geocoding error") ? raw_address : @court.city_name.presence %>

  <!-- Court header -->
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-slate-100"><%= @court.name %></h1>
      <% if @court.sport.present? || @court.free? || @court.outdoor? || @court.indoor? || @court.sauna? || @court.surfaces.any? %>
        <p class="mt-2 flex flex-wrap gap-1.5">
          <% if @court.sport.present? %>
            <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-200">
              <%= @court.sport %>
            </span>
          <% end %>
          <% if @court.free? %>
            <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-sm font-medium text-green-700 dark:bg-green-500/15 dark:text-green-300">
              <%= t("courts.index.free_badge") %>
            </span>
          <% end %>
          <% if @court.outdoor? %>
            <span class="inline-flex items-center rounded-full bg-sky-50 px-3 py-1 text-sm font-medium text-sky-700 dark:bg-sky-500/15 dark:text-sky-300">
              <%= t("courts.index.outdoor_badge") %>
            </span>
          <% end %>
          <% if @court.indoor? %>
            <span class="inline-flex items-center rounded-full bg-purple-50 px-3 py-1 text-sm font-medium text-purple-700 dark:bg-purple-500/15 dark:text-purple-300">
              <%= t("courts.index.indoor_badge") %>
            </span>
          <% end %>
          <% if @court.sauna? %>
            <span class="inline-flex items-center rounded-full bg-rose-50 px-3 py-1 text-sm font-medium text-rose-700 dark:bg-rose-500/15 dark:text-rose-300">
              <%= t("courts.index.sauna_badge") %>
            </span>
          <% end %>
          <% @court.surface_labels.each do |surface_label| %>
            <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-sm font-medium text-amber-700 dark:bg-amber-500/15 dark:text-amber-300">
              <%= surface_label %>
            </span>
          <% end %>
        </p>
      <% end %>
      <% if court_location.present? %>
        <p class="mt-1 text-gray-500 dark:text-slate-400 flex items-center gap-1">
          <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 2a6 6 0 00-6 6c0 4.418 6 10 6 10s6-5.582 6-10a6 6 0 00-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z" clip-rule="evenodd"/>
          </svg>
          <%= court_location %>
        </p>
      <% end %>
      <% if @court.rated? %>
        <p class="mt-1 flex items-center gap-1.5 text-sm text-gray-600 dark:text-slate-300">
          <%= render "courts/stars", value: @court.ratings_average.to_f, size: :sm %>
          <span class="font-semibold"><%= number_with_precision(@court.ratings_average, precision: 1) %></span>
          <%= link_to t("courts.ratings.count", count: @court.ratings_count), "#rating", class: "text-gray-400 underline dark:text-slate-500" %>
        </p>
      <% end %>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <% if can_manage?(@court) %>
        <%= link_to t("common.edit"), edit_court_path(@court), class: "inline-flex items-center rounded-full border border-gray-300 dark:border-white/15 px-4 py-2 text-sm font-medium text-gray-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-white/5 transition" %>
      <% end %>
    </div>
  </div>

  <% if @court.pending? %>
    <div class="mb-4 rounded-xl border border-yellow-200 bg-yellow-50 dark:bg-yellow-500/10 dark:border-yellow-500/20 p-4 text-sm text-yellow-800 dark:text-yellow-200">
      <%= t("courts.show.pending_moderation") %>
    </div>
    <% if current_user&.admin? %>
      <div class="mb-4 flex items-center gap-2">
        <%= button_to t("common.approve"), approve_court_path(@court), method: :post, class: "inline-flex items-center rounded-full bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 transition" %>
        <%= button_to t("common.reject"), reject_court_path(@court), method: :post, data: { turbo_confirm: t("courts.show.reject_confirm") }, class: "inline-flex items-center rounded-full bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 transition" %>
      </div>
    <% end %>
  <% end %>

  <% if user_signed_in? && !can_manage?(@court) %>
    <div class="mb-6 rounded-xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-900 dark:border-indigo-500/20 dark:bg-indigo-500/10 dark:text-indigo-100">
      <%= t("courts.suggestions.hint") %>
      <%= link_to t("courts.suggestions.cta"), new_court_correction_path(@court), class: "ml-1 font-semibold underline" %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left column: Map & Details -->
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-white rounded-xl border overflow-hidden dark:bg-slate-800/80 dark:border-white/10">
        <%
          coord_parts = @court.coordinates.to_s.strip.split(/[\s,;]+/)
          valid_coords = coord_parts.size == 2 && coord_parts.all? { |p| p.match?(/\A-?\d+(?:\.\d+)?\z/) }
          lat, lng = coord_parts.map(&:to_f) if valid_coords
          has_valid_coords = valid_coords && lat.between?(-90, 90) && lng.between?(-180, 180) && !(lat.zero? && lng.zero?)
          can_show_map = has_valid_coords && user_signed_in? && !geocoding_exceeded?
          slider_items = @approved_photos.filter_map { |photo| (variant = photo.display_variant) ? [ photo, variant ] : nil }
        %>

        <% if slider_items.any? %>
          <div data-controller="court-photos-slider"
               data-court-photos-slider-lat-value="<%= lat || 0 %>"
               data-court-photos-slider-lng-value="<%= lng || 0 %>"
               data-court-photos-slider-has-map-value="<%= can_show_map ? 'true' : 'false' %>"
               data-action="mouseenter->court-photos-slider#onMouseEnter mouseleave->court-photos-slider#onMouseLeave"
               class="relative select-none group">
            <div data-court-photos-slider-target="viewport"
                 class="relative h-56 w-full overflow-hidden bg-slate-900 cursor-pointer">
              <% slider_items.each_with_index do |(_photo, variant), idx| %>
                <div data-court-photos-slider-target="slide"
                     data-slide-index="<%= idx %>"
                     data-action="click->court-photos-slider#openLightbox keydown.enter->court-photos-slider#openLightbox keydown.space->court-photos-slider#openLightbox:prevent"
                     role="button"
                     tabindex="0"
                     aria-label="<%= t('courts.photos.slide', number: idx + 1) %>"
                     class="absolute inset-0 transition-opacity duration-700 ease-in-out <%= idx.zero? ? 'opacity-100' : 'opacity-0 pointer-events-none' %>">
                  <%= image_tag variant, alt: @court.name, class: "h-full w-full object-cover" %>
                  <div class="absolute bottom-2.5 right-2.5 z-10 rounded-full bg-black/55 px-2 py-1 text-[11px] text-white/90 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 shadow">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9m11.25-5.25v4.5m0-4.5h-4.5m4.5 0L15 9m-11.25 11.25v-4.5m0 4.5h4.5m-4.5 0L9 15m11.25 5.25v-4.5m0 4.5h-4.5m4.5 0L15 15" />
                    </svg>
                    <span><%= t("courts.photos.open_gallery") %></span>
                  </div>
                </div>
              <% end %>

              <% if can_show_map %>
                <div data-court-photos-slider-target="mapSlide"
                     class="absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0 pointer-events-none">
                  <%= render "shared/map_panel" do %>
                    <div data-controller="map-show"
                         data-map-show-lat-value="<%= lat %>"
                         data-map-show-lng-value="<%= lng %>"
                         class="h-full w-full"></div>
                  <% end %>
                  <!-- Transparent overlay to ensure clicking and swiping over map triggers lightbox and slider -->
                  <div data-open-type="map"
                       data-action="click->court-photos-slider#openLightbox keydown.enter->court-photos-slider#openLightbox keydown.space->court-photos-slider#openLightbox:prevent"
                       role="button"
                       tabindex="0"
                       aria-label="<%= t('courts.photos.tab_map') %>"
                       class="absolute inset-0 z-10 cursor-pointer"></div>
                  <div class="absolute bottom-2.5 right-2.5 z-10 pointer-events-none rounded-full bg-black/55 px-2 py-1 text-[11px] text-white/90 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 shadow">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9m11.25-5.25v4.5m0-4.5h-4.5m4.5 0L15 9m-11.25 11.25v-4.5m0 4.5h4.5m-4.5 0L9 15m11.25 5.25v-4.5m0 4.5h-4.5m4.5 0L15 15" />
                    </svg>
                    <span><%= t("courts.photos.open_gallery") %></span>
                  </div>
                </div>
              <% end %>

              <% total_count = slider_items.size + (can_show_map ? 1 : 0) %>
              <% if total_count > 1 %>
                <button type="button"
                        data-action="click->court-photos-slider#prev"
                        aria-label="<%= t('courts.photos.prev') %>"
                        class="absolute left-2.5 top-1/2 -translate-y-1/2 z-20 rounded-full bg-black/45 p-1.5 text-white hover:bg-black/70 hover:scale-105 active:scale-95 transition shadow-sm cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
                  </svg>
                </button>
                <button type="button"
                        data-action="click->court-photos-slider#next"
                        aria-label="<%= t('courts.photos.next') %>"
                        class="absolute right-2.5 top-1/2 -translate-y-1/2 z-20 rounded-full bg-black/45 p-1.5 text-white hover:bg-black/70 hover:scale-105 active:scale-95 transition shadow-sm cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                  </svg>
                </button>

                <div class="absolute bottom-2.5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1.5 rounded-full bg-black/40 px-2.5 py-1 backdrop-blur-sm">
                  <% slider_items.each_with_index do |_, idx| %>
                    <button type="button"
                            data-court-photos-slider-target="dot"
                            data-index="<%= idx %>"
                            data-action="click->court-photos-slider#goTo"
                            aria-label="<%= t('courts.photos.slide', number: idx + 1) %>"
                            class="h-1.5 rounded-full transition-all duration-300 cursor-pointer <%= idx.zero? ? 'w-5 bg-[#ffffff]' : 'w-1.5 bg-white/40' %>"></button>
                  <% end %>
                  <% if can_show_map %>
                    <button type="button"
                            data-court-photos-slider-target="dot"
                            data-index="<%= slider_items.size %>"
                            data-action="click->court-photos-slider#goTo"
                            aria-label="<%= t('courts.photos.tab_map') %>"
                            class="h-1.5 rounded-full transition-all duration-300 w-1.5 bg-white/40 cursor-pointer"></button>
                  <% end %>
                </div>
              <% end %>
            </div>

            <% if can_show_map %>
              <div class="absolute top-2.5 right-2.5 z-20 inline-flex rounded-full bg-black/55 p-0.5 text-xs font-medium backdrop-blur-sm shadow" role="tablist">
                <button type="button"
                        role="tab"
                        aria-selected="true"
                        data-court-photos-slider-target="togglePhotosBtn"
                        data-action="click->court-photos-slider#showPhotos"
                        class="rounded-full px-2.5 py-1 bg-[#ffffff] text-[#0f172a] font-semibold shadow-sm transition cursor-pointer">
                  <%= t("courts.photos.tab_photos") %>
                </button>
                <button type="button"
                        role="tab"
                        aria-selected="false"
                        data-court-photos-slider-target="toggleMapBtn"
                        data-action="click->court-photos-slider#showMap"
                        class="rounded-full px-2.5 py-1 text-white/80 hover:text-white transition cursor-pointer">
                  <%= t("courts.photos.tab_map") %>
                </button>
              </div>
            <% end %>

            <!-- Fullscreen Lightbox Modal -->
            <div data-court-photos-slider-target="lightbox"
                 data-action="click->court-photos-slider#onLightboxBackdropClick"
                 role="dialog"
                 aria-modal="true"
                 tabindex="-1"
                 aria-label="<%= t('courts.photos.title') %>"
                 class="hidden fixed inset-0 z-[70] bg-black/95 backdrop-blur-md flex flex-col justify-between p-4 sm:p-6 transition-all duration-300">
              <div data-lightbox-content class="flex items-center justify-between text-white z-20">
                <div class="flex items-center gap-3">
                  <span class="text-sm font-semibold tracking-wide truncate max-w-[200px] sm:max-w-md"><%= @court.name %></span>
                  <span data-court-photos-slider-target="lightboxCounter"
                        data-counter-template="<%= t('courts.photos.counter', current: '%{current}', total: '%{total}') %>"
                        data-map-label="<%= t('courts.photos.tab_map') %>"
                        class="text-xs font-mono bg-white/10 px-2.5 py-0.5 rounded-full text-white/80"></span>
                </div>

                <div class="flex items-center gap-2">
                  <% if can_show_map %>
                    <div class="inline-flex rounded-full bg-white/10 p-0.5 text-xs font-medium backdrop-blur-sm" role="tablist">
                      <button type="button"
                              role="tab"
                              aria-selected="true"
                              data-court-photos-slider-target="lightboxTogglePhotosBtn"
                              data-action="click->court-photos-slider#showLightboxPhotos"
                              class="rounded-full px-3 py-1 bg-[#ffffff] text-[#0f172a] font-semibold shadow-sm transition cursor-pointer">
                        <%= t("courts.photos.tab_photos") %>
                      </button>
                      <button type="button"
                              role="tab"
                              aria-selected="false"
                              data-court-photos-slider-target="lightboxToggleMapBtn"
                              data-action="click->court-photos-slider#showLightboxMap"
                              class="rounded-full px-3 py-1 text-white/80 hover:text-white transition cursor-pointer">
                        <%= t("courts.photos.tab_map") %>
                      </button>
                    </div>
                  <% end %>

                  <button type="button"
                          data-action="click->court-photos-slider#closeLightbox"
                          aria-label="<%= t('courts.photos.close_gallery') %>"
                          class="h-9 w-9 rounded-full bg-white/15 hover:bg-white/25 text-white flex items-center justify-center transition cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              </div>

              <div class="relative flex-1 flex items-center justify-center my-3 overflow-hidden">
                <% slider_items.each_with_index do |(photo, variant), idx| %>
                  <div data-court-photos-slider-target="lightboxSlide"
                       class="absolute inset-0 flex items-center justify-center transition-opacity duration-300 <%= idx.zero? ? 'opacity-100' : 'opacity-0 pointer-events-none' %>">
                    <%= image_tag (photo.file.attached? ? photo.file : variant),
                                  alt: @court.name,
                                  loading: "lazy",
                                  data: { lightbox_content: true },
                                  class: "max-h-[82vh] max-w-[92vw] object-contain rounded-lg shadow-2xl select-none" %>
                  </div>
                <% end %>

                <% if can_show_map %>
                  <div data-court-photos-slider-target="lightboxMapSlide"
                       class="absolute inset-0 flex items-center justify-center transition-opacity duration-300 opacity-0 pointer-events-none">
                    <div data-lightbox-content
                         data-court-photos-slider-target="lightboxMapContainer"
                         class="h-full w-full max-w-4xl max-h-[82vh] rounded-xl overflow-hidden shadow-2xl border border-white/15"></div>
                  </div>
                <% end %>

                <% if total_count > 1 %>
                  <button type="button"
                          data-lightbox-content
                          data-action="click->court-photos-slider#lightboxPrev"
                          aria-label="<%= t('courts.photos.prev') %>"
                          class="absolute left-2 top-1/2 -translate-y-1/2 z-30 h-11 w-11 rounded-full bg-black/60 hover:bg-black/90 text-white flex items-center justify-center transition hover:scale-105 active:scale-95 shadow-lg border border-white/10 cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                    </svg>
                  </button>
                  <button type="button"
                          data-lightbox-content
                          data-action="click->court-photos-slider#lightboxNext"
                          aria-label="<%= t('courts.photos.next') %>"
                          class="absolute right-2 top-1/2 -translate-y-1/2 z-30 h-11 w-11 rounded-full bg-black/60 hover:bg-black/90 text-white flex items-center justify-center transition hover:scale-105 active:scale-95 shadow-lg border border-white/10 cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </svg>
                  </button>
                <% end %>
              </div>

              <div data-lightbox-content class="flex items-center justify-center gap-2 z-20 py-1 overflow-x-auto max-w-full">
                <% slider_items.each_with_index do |(_photo, variant), idx| %>
                  <button type="button"
                          data-court-photos-slider-target="lightboxDot"
                          data-index="<%= idx %>"
                          data-action="click->court-photos-slider#goToLightbox"
                          aria-label="<%= t('courts.photos.slide', number: idx + 1) %>"
                          class="h-12 w-16 rounded-lg overflow-hidden border-2 transition-all duration-200 flex-shrink-0 cursor-pointer <%= idx.zero? ? 'border-white opacity-100 scale-105' : 'border-transparent opacity-50' %>">
                    <%= image_tag variant, alt: "", class: "h-full w-full object-cover" %>
                  </button>
                <% end %>
                <% if can_show_map %>
                  <button type="button"
                          data-court-photos-slider-target="lightboxDot"
                          data-index="<%= slider_items.size %>"
                          data-action="click->court-photos-slider#goToLightbox"
                          aria-label="<%= t('courts.photos.tab_map') %>"
                          class="h-12 w-16 rounded-lg overflow-hidden border-2 transition-all duration-200 flex-shrink-0 bg-slate-800 flex flex-col items-center justify-center text-white border-transparent opacity-50 cursor-pointer">
                    <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                    <span class="text-[10px] font-medium"><%= t("courts.photos.tab_map") %></span>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% else %>
          <% if can_show_map %>
            <div data-controller="court-photos-slider"
                 data-court-photos-slider-lat-value="<%= lat || 0 %>"
                 data-court-photos-slider-lng-value="<%= lng || 0 %>"
                 data-court-photos-slider-has-map-value="true"
                 class="relative select-none group">
              <div data-court-photos-slider-target="viewport"
                   class="relative">
                <div data-court-photos-slider-target="mapSlide" class="opacity-100">
                  <%= render "shared/map_panel" do %>
                    <div data-controller="map-show"
                         data-map-show-lat-value="<%= lat %>"
                         data-map-show-lng-value="<%= lng %>"
                         class="h-56 w-full"></div>
                  <% end %>
                  <div data-open-type="map"
                       data-action="click->court-photos-slider#openLightbox keydown.enter->court-photos-slider#openLightbox keydown.space->court-photos-slider#openLightbox:prevent"
                       role="button"
                       tabindex="0"
                       aria-label="<%= t('courts.photos.tab_map') %>"
                       class="absolute inset-0 z-10 cursor-pointer"></div>
                </div>

                <div class="absolute bottom-2.5 right-2.5 z-10 pointer-events-none rounded-full bg-black/55 px-2 py-1 text-[11px] text-white/90 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 shadow">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9m11.25-5.25v4.5m0-4.5h-4.5m4.5 0L15 9m-11.25 11.25v-4.5m0 4.5h4.5m-4.5 0L9 15m11.25 5.25v-4.5m0 4.5h-4.5m4.5 0L15 15" />
                  </svg>
                  <span><%= t("courts.photos.open_gallery") %></span>
                </div>
              </div>

              <!-- Fullscreen Lightbox Modal for Map only -->
              <div data-court-photos-slider-target="lightbox"
                   data-action="click->court-photos-slider#onLightboxBackdropClick"
                   role="dialog"
                   aria-modal="true"
                   tabindex="-1"
                   aria-label="<%= t('courts.photos.tab_map') %>"
                   class="hidden fixed inset-0 z-[70] bg-black/95 backdrop-blur-md flex flex-col justify-between p-4 sm:p-6 transition-all duration-300">
                <div data-lightbox-content class="flex items-center justify-between text-white z-20">
                  <div class="flex items-center gap-3">
                    <span class="text-sm font-semibold tracking-wide truncate max-w-[200px] sm:max-w-md"><%= @court.name %></span>
                    <span class="text-xs font-mono bg-white/10 px-2.5 py-0.5 rounded-full text-white/80"><%= t('courts.photos.tab_map') %></span>
                  </div>
                  <button type="button"
                          data-action="click->court-photos-slider#closeLightbox"
                          aria-label="<%= t('courts.photos.close_gallery') %>"
                          class="h-9 w-9 rounded-full bg-white/15 hover:bg-white/25 text-white flex items-center justify-center transition cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>

                <div class="relative flex-1 flex items-center justify-center my-3 overflow-hidden">
                  <div data-lightbox-content
                       data-court-photos-slider-target="lightboxMapSlide"
                       class="h-full w-full max-w-4xl max-h-[82vh] rounded-xl overflow-hidden shadow-2xl border border-white/15">
                    <div data-court-photos-slider-target="lightboxMapContainer" class="h-full w-full"></div>
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <div>
              <%= render "shared/map_panel" do %>
                <% if has_valid_coords %>
                  <div data-controller="map-show"
                       data-map-show-lat-value="<%= lat %>"
                       data-map-show-lng-value="<%= lng %>"
                       class="h-56 w-full"></div>
                <% else %>
                  <div class="h-56 w-full bg-gray-50 dark:bg-slate-700 flex items-center justify-center text-gray-400 dark:text-slate-500">
                    <%= t("courts.show.no_coordinates") %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <div class="p-4 space-y-3">
          <% if court_location.present? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.address") %></p>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-0.5"><%= court_location %></p>
            </div>
          <% end %>

          <% if @court.sport.present? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.sport") %></p>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-0.5"><%= @court.sport %></p>
            </div>
          <% end %>

          <% if @court.surfaces.any? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.surfaces") %></p>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-0.5"><%= @court.surface_labels.join(" · ") %></p>
            </div>
          <% end %>

          <% if @court.sauna? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.sauna") %></p>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-0.5"><%= t("courts.show.sauna_available") %></p>
            </div>
          <% end %>

          <% if lat && lng && !(lat.zero? && lng.zero?) %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.coordinates") %></p>
              <p class="text-sm font-mono text-gray-600 dark:text-slate-400 mt-0.5"><%= lat.round(6) %>, <%= lng.round(6) %></p>
            </div>
          <% end %>

          <% if @court.formatted_contact.present? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.contact") %></p>
              <div class="mt-0.5 space-y-1 text-sm font-medium">
                <% @court.contact_links.each do |contact| %>
                  <p>
                    <% if contact[:href].present? %>
                      <% if contact[:label].present? %><span class="text-gray-600 dark:text-slate-400"><%= contact[:label] %>:</span> <% end %>
                      <%= link_to contact[:value], contact[:href], class: "text-indigo-600 transition-colors hover:text-indigo-800 underline dark:text-indigo-400 dark:hover:text-indigo-300", target: "_blank", rel: "nofollow noopener" %>
                    <% else %>
                      <span class="text-gray-900 dark:text-slate-100"><%= contact[:formatted] %></span>
                    <% end %>
                  </p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%= render "courts/rating", court: @court %>
      <%= render "courts/photos_manage", court: @court %>
    </div>

    <!-- Right column: Games at this court -->
    <div class="lg:col-span-2">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100"><%= t("courts.show.games_at_court") %></h2>
        <div class="flex items-center gap-2">
        <%= link_to t("courts.show.back_to_courts"), courts_path, class: "inline-flex items-center rounded-full border border-gray-300 dark:border-white/15 px-4 py-2 text-sm font-medium text-gray-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-white/5 transition" %>
        <% sign_in_path = (respond_to?(:new_session_path) && new_session_path) || '/sign_in' rescue '/sign_in' %>
        <% if user_signed_in? %>
          <%= link_to new_game_path(court_id: @court.id), class: "inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            <%= t("courts.show.create_game") %>
          <% end %>
        <% else %>
          <%= link_to sign_in_path, class: "inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
            <%= t("courts.show.sign_in_to_create_game") %>
          <% end %>
        <% end %>
        </div>
      </div>

      <% if @court.games.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% @court.games.each do |game| %>
            <%= render partial: "games/card", locals: { game: game } %>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border-2 border-dashed border-gray-200 dark:border-white/10 p-10 text-center">
          <svg class="mx-auto w-10 h-10 text-gray-300 dark:text-slate-600 mb-2" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
          </svg>
          <p class="text-gray-500 dark:text-slate-400 font-medium"><%= t("courts.show.no_games") %></p>
          <p class="text-gray-400 dark:text-slate-500 text-sm mt-1"><%= t("courts.show.no_games_subtitle") %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>

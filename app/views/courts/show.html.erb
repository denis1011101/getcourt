<% content_for :meta_title, t("courts.show.meta_title", court: @court.name) %>
<% content_for :meta_description, t("courts.show.meta_description", court: @court.name) %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= json_escape({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t("layout.nav.home"), "item": root_url },
        { "@type": "ListItem", "position": 2, "name": t("layout.nav.courts"), "item": courts_url },
        { "@type": "ListItem", "position": 3, "name": @court.name }
      ]
    }.to_json).html_safe %>
  </script>
<% end %>

<div class="max-w-6xl mx-auto py-4">
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 dark:text-slate-400 mb-4">
    <%= link_to t("layout.nav.home"), root_path, class: "hover:text-gray-700 dark:hover:text-white" %> &rsaquo;
    <%= link_to t("layout.nav.courts"), courts_path, class: "hover:text-gray-700 dark:hover:text-white" %> &rsaquo;
    <span class="text-gray-900 dark:text-slate-100"><%= @court.name %></span>
  </nav>

  <!-- Court header -->
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-slate-100"><%= @court.name %></h1>
      <% if @court.sport.present? || @court.outdoor? || @court.indoor? || @court.surfaces.any? %>
        <p class="mt-2 flex flex-wrap gap-1.5">
          <% if @court.sport.present? %>
            <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-200">
              <%= @court.sport %>
            </span>
          <% end %>
          <% if @court.outdoor? %>
            <span class="inline-flex items-center rounded-full bg-sky-50 px-3 py-1 text-sm font-medium text-sky-700 dark:bg-sky-500/15 dark:text-sky-300">
              <%= t("courts.index.outdoor_badge") %>
            </span>
          <% end %>
          <% if @court.indoor? %>
            <span class="inline-flex items-center rounded-full bg-purple-50 px-3 py-1 text-sm font-medium text-purple-700 dark:bg-purple-500/15 dark:text-purple-300">
              <%= t("courts.index.indoor_badge") %>
            </span>
          <% end %>
          <% @court.surface_labels.each do |surface_label| %>
            <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-sm font-medium text-amber-700 dark:bg-amber-500/15 dark:text-amber-300">
              <%= surface_label %>
            </span>
          <% end %>
        </p>
      <% end %>
      <% if @court.address.present? && @court.address != "Unknown address" && @court.address != "Geocoding error" %>
        <p class="mt-1 text-gray-500 dark:text-slate-400 flex items-center gap-1">
          <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 2a6 6 0 00-6 6c0 4.418 6 10 6 10s6-5.582 6-10a6 6 0 00-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z" clip-rule="evenodd"/>
          </svg>
          <%= @court.address %>
        </p>
      <% end %>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <% if can_manage?(@court) %>
        <%= link_to t("common.edit"), edit_court_path(@court), class: "inline-flex items-center rounded-full border border-gray-300 dark:border-white/15 px-4 py-2 text-sm font-medium text-gray-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-white/5 transition" %>
      <% end %>
    </div>
  </div>

  <% if @court.pending? %>
    <div class="mb-4 rounded-xl border border-yellow-200 bg-yellow-50 dark:bg-yellow-500/10 dark:border-yellow-500/20 p-4 text-sm text-yellow-800 dark:text-yellow-200">
      <%= t("courts.show.pending_moderation") %>
    </div>
    <% if current_user&.admin? %>
      <div class="mb-4 flex items-center gap-2">
        <%= button_to t("common.approve"), approve_court_path(@court), method: :post, class: "inline-flex items-center rounded-full bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 transition" %>
        <%= button_to t("common.reject"), reject_court_path(@court), method: :post, data: { turbo_confirm: t("courts.show.reject_confirm") }, class: "inline-flex items-center rounded-full bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 transition" %>
      </div>
    <% end %>
  <% end %>

  <% if user_signed_in? && !can_manage?(@court) %>
    <div class="mb-6 rounded-xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-900 dark:border-indigo-500/20 dark:bg-indigo-500/10 dark:text-indigo-100">
      <%= t("courts.suggestions.hint") %>
      <%= link_to t("courts.suggestions.cta"), new_court_correction_path(@court), class: "ml-1 font-semibold underline" %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left column: Map & Details -->
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-white rounded-xl border overflow-hidden dark:bg-slate-800/80 dark:border-white/10">
        <% lat, lng = @court.coordinates.to_s.split(",").map(&:to_f) %>

        <%= render "shared/map_panel" do %>
          <% if lat && lng && !(lat.zero? && lng.zero?) %>
            <div data-controller="map-show"
                 data-map-show-lat-value="<%= lat %>"
                 data-map-show-lng-value="<%= lng %>"
                 class="h-48 w-full"></div>
          <% else %>
            <div class="h-48 w-full bg-gray-50 dark:bg-slate-700 flex items-center justify-center text-gray-400 dark:text-slate-500">
              <%= t("courts.show.no_coordinates") %>
            </div>
          <% end %>
        <% end %>

        <div class="p-4 space-y-3">
          <% if @court.address.present? && @court.address != "Unknown address" %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.address") %></p>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-0.5"><%= @court.address %></p>
            </div>
          <% end %>

          <% if @court.sport.present? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.sport") %></p>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-0.5"><%= @court.sport %></p>
            </div>
          <% end %>

          <% if @court.surfaces.any? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.surfaces") %></p>
              <p class="text-sm font-medium text-gray-900 dark:text-slate-100 mt-0.5"><%= @court.surface_labels.join(" · ") %></p>
            </div>
          <% end %>

          <% if lat && lng && !(lat.zero? && lng.zero?) %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.coordinates") %></p>
              <p class="text-sm font-mono text-gray-600 dark:text-slate-400 mt-0.5"><%= lat.round(6) %>, <%= lng.round(6) %></p>
            </div>
          <% end %>

          <% if @court.formatted_contact.present? %>
            <div>
              <p class="text-xs text-gray-400 dark:text-slate-500 uppercase tracking-wide font-medium"><%= t("courts.show.contact") %></p>
              <div class="mt-0.5 space-y-1 text-sm font-medium">
                <% @court.contact_links.each do |contact| %>
                  <p>
                    <% if contact[:href].present? %>
                      <% if contact[:label].present? %><span class="text-gray-600 dark:text-slate-400"><%= contact[:label] %>:</span> <% end %>
                      <%= link_to contact[:value], contact[:href], class: "text-indigo-600 transition-colors hover:text-indigo-800 underline dark:text-indigo-400 dark:hover:text-indigo-300", target: "_blank", rel: "nofollow noopener" %>
                    <% else %>
                      <span class="text-gray-900 dark:text-slate-100"><%= contact[:formatted] %></span>
                    <% end %>
                  </p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right column: Games at this court -->
    <div class="lg:col-span-2">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100"><%= t("courts.show.games_at_court") %></h2>
        <div class="flex items-center gap-2">
        <%= link_to t("courts.show.back_to_courts"), courts_path, class: "inline-flex items-center rounded-full border border-gray-300 dark:border-white/15 px-4 py-2 text-sm font-medium text-gray-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-white/5 transition" %>
        <% sign_in_path = (respond_to?(:new_session_path) && new_session_path) || '/sign_in' rescue '/sign_in' %>
        <% if user_signed_in? %>
          <%= link_to new_game_path(court_id: @court.id), class: "inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            <%= t("courts.show.create_game") %>
          <% end %>
        <% else %>
          <%= link_to sign_in_path, class: "inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
            <%= t("courts.show.sign_in_to_create_game") %>
          <% end %>
        <% end %>
        </div>
      </div>

      <% if @court.games.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% @court.games.each do |game| %>
            <%= render partial: "games/card", locals: { game: game } %>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border-2 border-dashed border-gray-200 dark:border-white/10 p-10 text-center">
          <svg class="mx-auto w-10 h-10 text-gray-300 dark:text-slate-600 mb-2" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
          </svg>
          <p class="text-gray-500 dark:text-slate-400 font-medium"><%= t("courts.show.no_games") %></p>
          <p class="text-gray-400 dark:text-slate-500 text-sm mt-1"><%= t("courts.show.no_games_subtitle") %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% content_for :meta_title, "#{@court.name} — court and scheduled games" %>
<% content_for :meta_description, "Find and join games at #{@court.name}. Create or join tennis, padel and table tennis matches on GetCourt." %>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold"><%= @court.name %></h1>
      <p class="text-gray-600">Court details, map and scheduled games.</p>
    </div>
    <div class="flex items-center gap-2">
      <% if can_manage?(@court) %>
        <%= link_to "Edit Court", edit_court_path(@court), class: "inline-flex items-center justify-center w-40 rounded-md border border-gray-300 px-4 py-2 text-sm text-indigo-600 hover:bg-gray-50 transition" %>
      <% end %>
      <%= link_to "Back to Courts", courts_path, class: "inline-flex items-center justify-center w-40 rounded-md border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition" %>
    </div>
  </div>

  <div class="bg-white rounded-lg border p-6 shadow-sm">
    <% if @court.pending? %>
      <div class="mb-4 rounded-md border border-yellow-200 bg-yellow-50 p-3 text-sm text-yellow-800">
        This court is under moderation.
      </div>
      <% if current_user&.admin? %>
        <div class="mb-4 flex items-center gap-2">
          <%= button_to "Approve", approve_court_path(@court), method: :post, class: "inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-white hover:bg-green-700 transition" %>
          <%= button_to "Reject", reject_court_path(@court), method: :post, data: { turbo_confirm: "Reject this court?" }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-white hover:bg-red-700 transition" %>
        </div>
      <% end %>
    <% end %>
    <% lat, lng = @court.coordinates.to_s.split(",").map(&:to_f) %>

    <%= render "shared/map_panel" do %>
      <% if lat && lng && !(lat.zero? && lng.zero?) %>
        <div data-controller="map-show"
             data-map-show-lat-value="<%= lat %>"
             data-map-show-lng-value="<%= lng %>"
             class="h-72 w-full rounded border mb-4"></div>
      <% else %>
        <div class="h-72 w-full rounded border bg-gray-50 flex items-center justify-center text-gray-400 mb-4">
          Coordinates not available
        </div>
      <% end %>
    <% end %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div>
        <p class="text-sm text-gray-500">Address</p>
        <p class="text-lg font-medium text-gray-900"><%= @court.address.presence || "Unknown address" %></p>
      </div>

      <div>
        <p class="text-sm text-gray-500">Coordinates</p>
        <p class="text-sm font-mono text-gray-700">
          <%= lat.round(6) rescue "—" %>, <%= lng.round(6) rescue "—" %>
        </p>
      </div>
    </div>

    <% if @court.formatted_contact.present? %>
      <% contact_type = @court.contact_type.to_s %>
      <% contact_value = @court.contact_value.to_s %>
      <% contact_text = @court.formatted_contact %>
      <% digits = contact_value.gsub(/[^\d]/, "") %>
      <% href =
        case contact_type
        when "phone"
          digits.present? ? "tel:+#{digits}" : nil
        when "telegram"
          if contact_value.match?(/\Ahttps?:\/\//)
            contact_value
          else
            username = contact_value.sub(/\A@/, "")
            username.present? ? "https://t.me/#{username}" : nil
          end
        when "whatsapp"
          digits.present? ? "https://wa.me/#{digits}" : nil
        when "viber"
          digits.present? ? "viber://chat?number=+#{digits}" : nil
        else
          nil
        end %>

      <div class="mb-4">
        <p class="text-sm text-gray-500">Contact</p>
        <p class="text-lg font-medium text-indigo-700">
          <% if href.present? %>
            <% if @court.contact_label.present? %><span class="text-gray-900"><%= @court.contact_label %>:</span> <% end %><%= link_to contact_value, href, class: "text-indigo-700 hover:text-indigo-800 underline", target: "_blank", rel: "noopener" %>
          <% else %>
            <%= contact_text %>
          <% end %>
        </p>
      </div>
    <% end %>

    <h2 class="text-lg font-medium mb-3">Games Scheduled</h2>
    <% if @court.games.any? %>
      <ul class="list-none space-y-3 mb-6">
        <% @court.games.each do |game| %>
          <li class="rounded-md border p-3 flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">
                <% ui_date = game.display_date_for_show %>
                <% ui_time = game.next_time || game.time %>
                <% if ui_date.present? || ui_time.present? %>
                  <%= ui_date.present? ? ui_date.strftime("%B %d, %Y") : "Date not set" %>
                  <% if ui_time %>
                    — <span class="font-medium text-gray-900"><%= ui_time.strftime("%I:%M %p") %></span>
                  <% end %>
                <% else %>
                  Not scheduled
                <% end %>
              <p class="text-sm text-gray-600 mt-1">
                <%= pluralize(game.participations.count, "participant") %>
              </p>
            </div>
            <div>
              <%= link_to "View", game_path(game), class: "text-sm font-medium text-indigo-600 hover:text-indigo-700" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-lg border border-dashed p-6 text-center text-gray-500 mb-6">
        No games scheduled for this court.
      </div>
    <% end %>

    <div class="flex items-center gap-3">
      <% sign_in_path = (respond_to?(:new_session_path) && new_session_path) || '/sign_in' rescue '/sign_in' %>
      <% action_text = user_signed_in? ? "Create Game" : "Login to Сreate Пame" %>
      <%= link_to action_text, (user_signed_in? ? new_game_path(court_id: @court.id) : sign_in_path), class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition" %>
      <%= link_to "Back to Courts", courts_path, class: "block inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition" %>
    </div>
  </div>
</div>
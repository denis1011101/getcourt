<%= form_with(model: court, local: true) do |form| %>
  <% if court.errors.any? %>
    <div id="error_explanation" class="mb-4 rounded-md bg-red-50 border border-red-200 p-4 text-red-700">
      <h2 class="font-semibold"><%= t("courts.form.errors", count: court.errors.count) %></h2>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% court.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render "courts/fields", form: form, court: court %>

  <div class="mt-4 flex items-center gap-2">
    <%= form.submit t("courts.form.submit"), class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition" %>
    <%= link_to t("common.cancel"), courts_path, class: "block inline-flex items-center rounded-md border border-gray-300 dark:border-white/10 px-3 py-2 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-white/5 transition" %>
  </div>

  <%# Удаление живёт здесь, а не в карточке списка: слишком легко снести чужой
      корт мимоходом, а до формы правки доходит только тот, кто им управляет. %>
  <% if court.persisted? %>
    <div class="mt-4 pt-4 border-t dark:border-white/10 flex items-center gap-3">
      <%= link_to t("courts.form.view_court"), court_path(court), class: "text-sm text-indigo-600 transition-colors hover:text-indigo-800 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300" %>
      <%= link_to t("courts.form.delete_court"), court_path(court), data: { turbo_method: :delete, turbo_confirm: t("courts.form.delete_confirm") }, class: "text-sm text-red-600 hover:underline" %>
    </div>
  <% end %>
<% end %>

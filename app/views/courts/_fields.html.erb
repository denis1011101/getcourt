<%# Общие поля корта и предложения правок к нему. Карточки в две колонки, как
    у формы игры: слева — что это за корт и где он, справа — удобства и
    контакты. На узком экране идут одна за другой в том же порядке. %>
<% card = "rounded-lg border bg-white p-5 shadow-sm dark:bg-slate-800/80 dark:border-white/10" %>
<% heading = "text-base font-semibold text-gray-900 dark:text-slate-100 mb-3" %>
<div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
  <div class="space-y-6 lg:col-span-7">
    <section class="<%= card %>">
      <h2 class="<%= heading %>"><%= t("courts.form.section_about") %></h2>
      <div class="grid grid-cols-1 gap-4">
        <div>
          <%= form.label :name, class: "block text-sm font-semibold text-gray-800 dark:text-slate-200" %>
          <%= form.text_field :name,
                autofocus: true,
                placeholder: t("courts.form.name_placeholder"),
                class: "mt-1 block w-full rounded-md border border-gray-300 dark:border-white/15 bg-white dark:bg-slate-700 text-lg text-gray-900 dark:text-slate-100 shadow-sm px-3 py-2 placeholder-gray-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("courts.form.name_hint") %></p>
        </div>

        <div>
          <%= form.label :sport, t("courts.show.sport"), class: "block text-sm font-semibold text-gray-800 dark:text-slate-200" %>
          <%= form.select :sport,
                options_for_select(Court::SPORTS.map { |sport| [sport, sport] }, court.sport),
                { include_blank: t("courts.form.sport_blank") },
                class: "mt-1 block w-full rounded-md border border-gray-300 dark:border-white/15 bg-white dark:bg-slate-700 text-gray-900 dark:text-slate-100 shadow-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("courts.form.sport_hint") %></p>
        </div>
      </div>
    </section>

    <section class="<%= card %>">
      <h2 class="<%= heading %>"><%= t("courts.form.map_label") %></h2>
      <div class="space-y-3" data-controller="map-picker"
           data-map-picker-default-lat-value="56.838011"
           data-map-picker-default-lng-value="60.597465">
        <%= render "shared/map_panel" do %>
          <div data-map-picker-target="map" class="h-72 w-full rounded border dark:border-white/10 bg-white dark:bg-slate-700"></div>
        <% end %>
        <div class="flex items-center gap-3">
          <button type="button" class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500" data-action="click->map-picker#geolocate">
            <%= t("courts.form.use_my_location") %>
          </button>
          <span class="text-xs text-gray-500 dark:text-slate-400"><%= t("courts.form.map_hint") %></span>
        </div>

        <%= form.hidden_field :coordinates,
              data: { "map-picker-target": "coordinates", action: "input->map-picker#syncFromInput" } %>
      </div>
    </section>
  </div>

  <div class="space-y-6 lg:col-span-5">
    <section class="<%= card %>">
      <h2 class="<%= heading %>"><%= t("courts.form.section_amenities") %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <% %i[free outdoor indoor sauna].each do |amenity| %>
          <div class="flex items-center gap-2">
            <%= form.check_box amenity, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            <%= form.label amenity, t("courts.form.#{amenity}"), class: "text-sm text-gray-700 dark:text-slate-300" %>
          </div>
        <% end %>
      </div>

      <div class="mt-4">
        <span class="block text-sm font-semibold text-gray-800 dark:text-slate-200"><%= t("courts.form.surfaces") %></span>
        <p class="mt-0.5 mb-2 text-xs text-gray-500 dark:text-slate-400"><%= t("courts.form.surfaces_hint") %></p>
        <%= hidden_field_tag "#{form.object_name}[surfaces][]", "" %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <% Court::SURFACES.each do |surface| %>
            <label class="flex items-center gap-2">
              <%= check_box_tag "#{form.object_name}[surfaces][]", surface, court.surfaces.include?(surface),
                    id: "#{form.object_name}_surface_#{surface}",
                    class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              <span class="text-sm text-gray-700 dark:text-slate-300"><%= t("courts.surfaces.#{surface}") %></span>
            </label>
          <% end %>
        </div>
      </div>
    </section>

    <section class="<%= card %>">
      <div class="flex items-center justify-between gap-3 mb-3">
        <h2 class="text-base font-semibold text-gray-900 dark:text-slate-100"><%= t("courts.form.contacts") %></h2>
        <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("courts.form.contacts_hint") %></p>
      </div>
      <% contact_types = (Court::CONTACT_TYPES + %w[website email]).uniq %>
      <%# Показываем заполненные контакты, но не меньше двух строк: третья — по
          плюсику, чтобы форма не пугала пустыми полями. Пустые строки сервер
          всё равно отбрасывает. %>
      <% filled = court.contact_entries_for_form(Court::MAX_FORM_CONTACTS).select { |entry| entry["contact_value"].present? } %>
      <% entries = filled + Array.new([ 2 - filled.size, 0 ].max) { { "contact_type" => nil, "contact_value" => nil } } %>
      <div data-controller="contact-rows"
           data-contact-rows-max-value="<%= Court::MAX_FORM_CONTACTS %>"
           data-contact-rows-type-label-value="<%= t("courts.form.contact_type", number: "%{number}") %>"
           data-contact-rows-value-label-value="<%= t("courts.form.contact_value", number: "%{number}") %>">
        <div data-contact-rows-target="list">
          <% entries.each do |entry| %>
            <%= render "courts/contact_row", object_name: form.object_name, contact_types: contact_types, entry: entry %>
          <% end %>
        </div>

        <template data-contact-rows-target="template">
          <%= render "courts/contact_row", object_name: form.object_name, contact_types: contact_types,
                entry: { "contact_type" => nil, "contact_value" => nil } %>
        </template>

        <button type="button" data-contact-rows-target="add" data-action="contact-rows#add"
                class="mt-3 inline-flex items-center gap-1 rounded-md border border-indigo-300 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
          + <%= t("courts.form.contact_add") %>
        </button>
      </div>
      <p class="text-xs text-gray-500 dark:text-slate-400 mt-3"><%= t("courts.form.contacts_example") %></p>
    </section>
  </div>
</div>

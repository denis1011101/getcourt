<div class="max-w-5xl mx-auto px-4 py-2">
  <%= render "shared/page_header",
      title: "Tennis Courts",
      description: "Welcome to the Get Court application! Here you can find and manage tennis courts.",
      action_text: "Add New Court",
      action_path: new_court_path %>

  <% if @courts.empty? %>
    <div class="rounded-lg border border-dashed p-8 text-center text-gray-500">
      No courts yet.
    </div>
  <% else %>
    <h2 class="text-lg font-medium mb-3">Available Courts</h2>

    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% @courts.each do |court| %>
        <% addr = court.address %>
        <% unknown = (addr == "Unknown address" || addr == "Geocoding error") %>
        <li class="group rounded-lg border bg-white p-4 shadow-sm hover:shadow-md transition">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-base font-semibold text-gray-900">
                <%= link_to court.name, court_path(court), class: "hover:underline" %>
              </h3>
              <p class="mt-1 text-sm <%= unknown ? 'text-gray-400' : 'text-gray-600' %>">
                <span class="inline-flex items-center gap-1">
                  <svg class="h-4 w-4 <%= unknown ? 'text-gray-300' : 'text-indigo-500' %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 2a6 6 0 00-6 6c0 4.418 6 10 6 10s6-5.582 6-10a6 6 0 00-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z" clip-rule="evenodd"/>
                  </svg>
                  <%= unknown ? "Address unavailable" : addr %>
                </span>
              </p>
            </div>
            <div class="flex items-center gap-3">
              <%= link_to "View", court_path(court), class: "text-sm font-medium text-indigo-600 hover:text-indigo-700" %>
              <% if can_manage?(court) || (current_user && court.user_id == current_user.id) %>
                <%= link_to "Delete", court_path(court),
                  method: :delete,
                  data: { confirm: "Are you sure you want to delete this court?" },
                  class: "text-sm font-medium text-red-600 hover:text-red-800" %>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
<% content_for :meta_title, t("courts.index.meta_title") %>
<% content_for :meta_description, t("courts.index.meta_description") %>
<div class="max-w-6xl mx-auto">
  <!-- Hero section -->
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-indigo-600 via-indigo-500 to-purple-500 px-6 py-8 md:px-10 md:py-12 mb-6 text-white ring-1 ring-white/15 shadow-[0_20px_60px_rgba(79,70,229,0.18)] dark:from-indigo-900 dark:via-indigo-800 dark:to-fuchsia-800 dark:ring-white/10 dark:shadow-[0_24px_70px_rgba(15,23,42,0.45)]">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/14 via-white/5 to-transparent dark:from-white/8 dark:via-indigo-400/5 dark:to-transparent"></div>
    <div class="pointer-events-none absolute -top-24 -right-24 w-72 h-72 rounded-full bg-purple-400/20 blur-3xl dark:bg-fuchsia-500/15 animate-pulse [animation-duration:4s]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-16 w-56 h-56 rounded-full bg-indigo-300/15 blur-3xl dark:bg-indigo-400/10"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/30 dark:bg-white/15"></div>
    <!-- Decorative tennis court lines -->
    <svg class="pointer-events-none absolute right-4 md:right-10 top-1/2 -translate-y-1/2 w-36 h-48 md:w-48 md:h-64 opacity-[0.08] dark:opacity-[0.06]" viewBox="0 0 120 160" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="4" y="4" width="112" height="152" rx="2"/>
      <line x1="18" y1="4" x2="18" y2="156"/>
      <line x1="102" y1="4" x2="102" y2="156"/>
      <line x1="4" y1="80" x2="116" y2="80"/>
      <line x1="18" y1="52" x2="102" y2="52"/>
      <line x1="18" y1="108" x2="102" y2="108"/>
      <line x1="60" y1="52" x2="60" y2="108"/>
      <line x1="56" y1="4" x2="64" y2="4"/>
      <line x1="56" y1="156" x2="64" y2="156"/>
    </svg>

    <div class="relative">
      <h1 class="text-2xl md:text-4xl font-bold tracking-tight"><%= t("courts.index.hero_title") %></h1>
      <p class="mt-2 text-white/90 dark:text-indigo-100 text-sm md:text-base max-w-xl"><%= t("courts.index.hero_subtitle") %></p>

      <%= render "shared/location_filters",
            url: courts_path,
            countries: @countries,
            cities: @cities,
            selected_country: params[:country],
            selected_city: params[:city] %>
    </div>
  </div>

  <div class="mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= t("courts.index.title") %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= t("courts.index.subtitle") %></p>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <%= form_with url: courts_path, method: :get, local: true, class: "contents" do |f| %>
        <% if params[:country].present? %>
          <%= f.hidden_field :country, value: params[:country] %>
        <% end %>
        <% if params[:city].present? %>
          <%= f.hidden_field :city, value: params[:city] %>
        <% end %>
        <% free_active = ActiveModel::Type::Boolean.new.cast(params[:free]) %>
        <button type="submit" name="free" value="<%= free_active ? '' : '1' %>"
                class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                       <%= free_active ? 'bg-green-600 text-white border-green-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25' %>">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l1.5 1.5 3-3.75M12 3H7.5A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h9a2.25 2.25 0 002.25-2.25V5.25A2.25 2.25 0 0016.5 3H12z"/>
            </svg>
            <%= t("courts.index.free_only") %>
          </span>
        </button>

        <% if free_active %>
          <%= link_to courts_path(params.permit(:country, :city).to_h), class: "flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 transition" do %>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              <%= t("common.reset") %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render "shared/results_summary", count: @courts.size, noun: "court", filters: location_filter_labels do %>
    <% if user_signed_in? %>
      <%= link_to new_court_path, class: "hidden md:inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        <%= t("courts.index.add_court") %>
      <% end %>
    <% end %>
  <% end %>

  <% if @courts.empty? %>
    <div class="rounded-2xl border-2 border-dashed border-gray-200 p-12 text-center">
      <p class="text-gray-500 font-medium"><%= t("courts.index.empty") %></p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @courts.each do |court| %>
        <% addr = court.address %>
        <% unknown = (addr == "Unknown address" || addr == "Geocoding error") %>
        <div class="group relative rounded-xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
          <%= link_to "", court_path(court), class: "absolute inset-0 z-0" %>

          <div class="h-1 bg-indigo-500"></div>

          <div class="p-4">
            <h3 class="text-base font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors mb-1">
              <%= court.name %>
            </h3>
            <% if court.sport.present? || court.free? %>
              <p class="mb-2 flex flex-wrap gap-1">
                <% if court.sport.present? %>
                  <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-200">
                    <%= court.sport %>
                  </span>
                <% end %>
                <% if court.free? %>
                  <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-500/15 dark:text-green-300">
                    <%= t("courts.index.free_badge") %>
                  </span>
                <% end %>
              </p>
            <% end %>
            <p class="text-sm <%= unknown ? 'text-gray-400' : 'text-gray-500' %> flex items-center gap-1">
              <svg class="w-3.5 h-3.5 flex-shrink-0 <%= unknown ? 'text-gray-300' : 'text-indigo-400' %>" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 2a6 6 0 00-6 6c0 4.418 6 10 6 10s6-5.582 6-10a6 6 0 00-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z" clip-rule="evenodd"/>
              </svg>
              <span class="truncate"><%= unknown ? t("courts.index.address_unavailable") : addr %></span>
            </p>

            <div class="mt-3 flex items-center justify-between">
              <% games_count = court.respond_to?(:games) ? court.games.size : 0 %>
              <span class="text-xs text-gray-400"><%= t("courts.index.games_count", count: games_count) %></span>
              <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 dark:text-indigo-400 group-hover:underline"><%= t("common.view") %> &rarr;</span>
            </div>
          </div>

          <% if can_manage?(court) || (current_user && court.user_id == current_user.id) %>
            <div class="absolute top-3 right-3 z-10">
              <%= link_to court_path(court),
                method: :delete,
                data: { confirm: t("courts.index.delete_confirm") },
                class: "p-1.5 rounded-full hover:bg-red-50 text-gray-300 hover:text-red-500 transition" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                </svg>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/pagy", pagy: @pagy %>
</div>

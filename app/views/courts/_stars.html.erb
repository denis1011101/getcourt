<%# Звёзды закрашиваем по округлённой оценке, точное число печатаем рядом текстом. %>
<span class="inline-flex items-center gap-0.5" aria-hidden="true">
  <% (1..5).each do |star| %>
    <svg class="<%= size == :sm ? "w-3.5 h-3.5" : "w-5 h-5" %> <%= star <= value.round ? "text-amber-400" : "text-gray-300 dark:text-slate-600" %>" viewBox="0 0 20 20" fill="currentColor">
      <path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.36 4.18h4.4c.97 0 1.37 1.24.59 1.81l-3.56 2.59 1.36 4.18c.3.92-.76 1.69-1.54 1.12L10 14.23l-3.56 2.58c-.78.57-1.84-.2-1.54-1.12l1.36-4.18-3.56-2.59c-.78-.57-.38-1.81.59-1.81h4.4l1.36-4.18z"/>
    </svg>
  <% end %>
</span>

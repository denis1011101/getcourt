<%# Строка контакта: и в списке, и в шаблоне для Stimulus. Номер в подписях
    проставляет контроллер, поэтому здесь он остаётся плейсхолдером. %>
<div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 items-end" data-contact-rows-target="row">
  <div class="sm:col-span-1">
    <label class="block text-sm text-gray-600 dark:text-slate-400" data-contact-rows-target="typeLabel"></label>
    <%= select_tag "#{object_name}[contact_entries][][contact_type]",
          options_for_select(contact_types.map { |type| [type.capitalize, type] }, entry["contact_type"]),
          include_blank: t("courts.form.contact_type_blank"), id: nil,
          class: "mt-1 block w-full rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
  </div>

  <div class="sm:col-span-2">
    <div class="flex items-center justify-between gap-2">
      <label class="block text-sm text-gray-600 dark:text-slate-400" data-contact-rows-target="valueLabel"></label>
      <button type="button" hidden data-contact-rows-target="remove" data-action="contact-rows#remove"
              class="text-xs text-gray-500 hover:text-red-600 hover:underline dark:text-slate-400"><%= t("courts.form.contact_remove") %></button>
    </div>
    <%= text_field_tag "#{object_name}[contact_entries][][contact_value]",
          entry["contact_value"],
          placeholder: t("courts.form.contact_value_placeholder"), id: nil,
          class: "mt-1 block w-full rounded-md border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
  </div>
</div>

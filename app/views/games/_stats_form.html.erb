<% match_groups = PlayerStatistics::MatchGroups.for_game(game) %>
<% saved_hours = PlayerStatistics::SavedHours.for_game(game, user: current_user) %>
<%= form_with url: game_player_statistics_path(game), method: :post, data: { turbo: false }, class: "space-y-4" do %>
  <div data-controller="stats-matches" data-stats-matches-next-index-value="<%= [ match_groups.size, 1 ].max %>" class="space-y-4">
    <div>
      <label class="mb-1 block text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.hours") %></label>
      <%= number_field_tag "statistics[hours]", saved_hours, step: 0.1, min: 0, class: "w-32 rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
    </div>

    <div data-stats-matches-target="container" class="space-y-4">
      <% if match_groups.any? %>
        <% match_groups.each_with_index do |group, i| %>
          <%= render "games/stats_match_block", game: game, index: i, removable: false, group: group %>
        <% end %>
      <% else %>
        <%= render "games/stats_match_block", game: game, index: 0, removable: false %>
      <% end %>
    </div>

    <button type="button"
            data-action="click->stats-matches#add"
            class="inline-flex items-center gap-1 rounded-md border border-indigo-300 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
      + <%= t("games.show.add_game") %>
    </button>

    <template data-stats-matches-target="template">
      <%= render "games/stats_match_block", game: game, index: "__INDEX__", removable: true %>
    </template>
  </div>

  <% if false %>
  <details class="rounded border bg-gray-50 p-3 dark:bg-slate-700/50">
    <summary class="cursor-pointer text-sm font-medium text-gray-700 hover:text-indigo-600 dark:text-slate-300">
      <%= t("games.show.additional_stats") %>
    </summary>
    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
      <% StatisticsPresenter.fields.reject { |f| %i[singles_hours doubles_hours].include?(f[:key]) }.each do |f| %>
        <div>
          <label class="mb-1 block text-xs text-gray-600 dark:text-slate-400"><%= f[:label] %></label>
          <% step = (StatisticsPresenter.field_type(f[:key]) == :float ? 0.1 : 1) %>
          <%= number_field_tag "statistics[#{f[:key]}]", nil, step: step, min: 0, placeholder: f[:example], class: "w-full rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
      <% end %>
    </div>
  </details>
  <% end %>

  <div class="pt-2">
    <%= submit_tag t("games.show.stats_submit"), class: "inline-flex items-center rounded bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-700" %>
  </div>
<% end %>

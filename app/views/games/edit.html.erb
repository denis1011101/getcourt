<% content_for :meta_robots, "noindex, follow" %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold">Edit Game</h1>
      <p class="text-gray-600">Update game details and participants.</p>
    </div>
    <div>
      <%= link_to "Back to Games", root_path, class: "block inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition" %>
    </div>
  </div>

  <%= render "form", game: @game, show_actions: true %>
</div>

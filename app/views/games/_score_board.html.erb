<div data-controller="score-board"
     data-score-board-recognition-url-value="<%= score_recognitions_path %>"
     data-score-board-set-label-value="<%= t("games.show.score_board.set") %>"
     data-score-board-team-a-label-value="<%= t("games.show.team_a") %>"
     data-score-board-team-b-label-value="<%= t("games.show.team_b") %>"
     data-score-board-recognizing-label-value="<%= t("games.show.score_board.recognizing") %>"
     data-score-board-recognition-failed-label-value="<%= t("score_recognitions.errors.recognition_failed") %>"
     data-score-board-invalid-set-label-value="<%= t("games.show.score_board.invalid_set") %>"
     data-score-board-names-hint-template-value="<%= t("games.show.score_board.names_hint", top: "__TOP__", bottom: "__BOTTOM__") %>">
  <%= hidden_field_tag "matches[#{index}][score]", local_assigns[:score].presence, id: nil, data: { score_board_target: "score" } %>

  <div class="overflow-x-auto rounded-md border border-gray-200 p-2 dark:border-white/10">
    <div class="flex min-w-max gap-2">
      <div class="w-32 shrink-0">
        <div class="h-8"></div>
        <div class="flex h-12 items-center gap-1 text-sm font-medium text-gray-700 dark:text-slate-300">
          <span data-score-board-target="topLabel"><%= t("games.show.team_a") %></span>
          <button type="button"
                  data-action="score-board#swap"
                  title="<%= t("games.show.score_board.swap") %>"
                  aria-label="<%= t("games.show.score_board.swap") %>"
                  class="rounded px-1 text-lg text-indigo-600 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-slate-700">⇅</button>
        </div>
        <div class="flex h-12 items-center text-sm font-medium text-gray-700 dark:text-slate-300">
          <span data-score-board-target="bottomLabel"><%= t("games.show.team_b") %></span>
        </div>
      </div>

      <div data-score-board-target="sets" class="flex gap-2"></div>

      <button type="button"
              data-score-board-target="addButton"
              data-action="score-board#addSet"
              class="self-start whitespace-nowrap rounded border border-indigo-300 px-2 py-1 text-xs text-indigo-700 hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
        + <%= t("games.show.score_board.add_set") %>
      </button>
    </div>
  </div>

  <template data-score-board-target="template">
    <div data-score-board-target="set" class="w-24 shrink-0 rounded border border-transparent px-1 pb-1">
      <div class="flex h-8 items-center justify-center gap-1 text-xs text-gray-500 dark:text-slate-400">
        <span data-role="set-label"></span>
        <button type="button"
                data-role="remove-set"
                data-action="score-board#removeSet"
                title="<%= t("games.show.score_board.remove_set") %>"
                aria-label="<%= t("games.show.score_board.remove_set") %>"
                class="rounded px-1 hover:bg-gray-100 dark:hover:bg-slate-700">×</button>
      </div>
      <% %w[top bottom].each do |side| %>
        <div class="flex h-12 items-center justify-center gap-1">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" autocomplete="off"
                 data-role="<%= side %>"
                 data-action="input->score-board#scoreChanged"
                 aria-label="<%= t("games.show.score_board.#{side}_score") %>"
                 class="w-12 rounded border-gray-300 px-1 py-1 text-center text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" autocomplete="off"
                 data-role="tiebreak-<%= side %>"
                 data-action="input->score-board#scoreChanged"
                 aria-label="<%= t("games.show.score_board.tiebreak") %>"
                 class="hidden w-8 rounded border-gray-300 px-0 py-1 text-center text-xs dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
        </div>
      <% end %>
    </div>
  </template>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
    <div>
      <button type="button"
              data-score-board-target="recognizeButton"
              data-action="score-board#choosePhoto"
              class="inline-flex items-center gap-1 rounded-md border border-indigo-300 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50 disabled:opacity-60 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
        📷 <span data-score-board-target="recognizeLabel"><%= t("games.show.score_board.recognize") %></span>
      </button>
      <input type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
             data-score-board-target="photo"
             data-action="change->score-board#recognize"
             class="hidden">
    </div>
    <code data-score-board-target="preview" class="text-sm text-gray-600 dark:text-slate-300">—</code>
  </div>
  <p data-score-board-target="status" role="status" class="mt-1 hidden text-xs text-gray-500 dark:text-slate-400"></p>
</div>

<%# Score entry shared by the game statistics form and the tournament "add match" form. %>
<% field_name = local_assigns.fetch(:field_name) { "matches[#{index}][score]" } %>
<% top_label = local_assigns.fetch(:top_label, t("games.show.team_a")) %>
<% bottom_label = local_assigns.fetch(:bottom_label, t("games.show.team_b")) %>
<div data-controller="score-board"
     data-score-board-recognition-url-value="<%= score_recognitions_path %>"
     data-score-board-set-label-value="<%= t("games.show.score_board.set") %>"
     data-score-board-team-a-label-value="<%= top_label %>"
     data-score-board-team-b-label-value="<%= bottom_label %>"
     data-score-board-recognizing-label-value="<%= t("games.show.score_board.recognizing") %>"
     data-score-board-recognition-failed-label-value="<%= t("score_recognitions.errors.recognition_failed") %>"
     data-score-board-invalid-set-label-value="<%= t("games.show.score_board.invalid_set") %>"
     data-score-board-names-hint-template-value="<%= t("games.show.score_board.names_hint", top: "__TOP__", bottom: "__BOTTOM__") %>">
  <%= hidden_field_tag field_name, local_assigns[:score].presence, id: nil, data: { score_board_target: "score" } %>

  <div class="rounded-md border border-gray-200 p-2 dark:border-white/10">
    <div class="flex items-center gap-2 pb-1">
      <span class="w-12 shrink-0"></span>
      <span data-score-board-target="topLabel" class="min-w-0 flex-1 truncate text-center text-sm font-medium text-gray-700 dark:text-slate-300"><%= top_label %></span>
      <button type="button"
              data-action="score-board#swap"
              title="<%= t("games.show.score_board.swap") %>"
              aria-label="<%= t("games.show.score_board.swap") %>"
              class="w-8 shrink-0 rounded text-center text-lg leading-none text-indigo-600 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-slate-700">⇄</button>
      <span data-score-board-target="bottomLabel" class="min-w-0 flex-1 truncate text-center text-sm font-medium text-gray-700 dark:text-slate-300"><%= bottom_label %></span>
      <span class="w-6 shrink-0"></span>
    </div>

    <div data-score-board-target="sets" class="space-y-1"></div>

    <button type="button"
            data-score-board-target="addButton"
            data-action="score-board#addSet"
            class="mt-2 whitespace-nowrap rounded border border-indigo-300 px-2 py-1 text-xs text-indigo-700 hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
      + <%= t("games.show.score_board.add_set") %>
    </button>
  </div>

  <template data-score-board-target="template">
    <div data-score-board-target="set" class="flex items-center gap-2 rounded border border-transparent px-1 py-1">
      <span data-role="set-label" class="w-12 shrink-0 text-xs text-gray-500 dark:text-slate-400"></span>
      <div class="flex min-w-0 flex-1 items-center justify-center gap-1">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" autocomplete="off"
               data-role="top"
               data-action="input->score-board#scoreChanged"
               aria-label="<%= t("games.show.score_board.top_score") %>"
               class="w-12 rounded border-gray-300 px-1 py-1 text-center text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" autocomplete="off"
               data-role="tiebreak-top"
               data-action="input->score-board#scoreChanged"
               aria-label="<%= t("games.show.score_board.tiebreak") %>"
               class="hidden w-8 rounded border-gray-300 px-0 py-1 text-center text-xs dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
      </div>
      <span class="w-8 shrink-0 text-center text-gray-400 dark:text-slate-500">:</span>
      <div class="flex min-w-0 flex-1 items-center justify-center gap-1">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" autocomplete="off"
               data-role="bottom"
               data-action="input->score-board#scoreChanged"
               aria-label="<%= t("games.show.score_board.bottom_score") %>"
               class="w-12 rounded border-gray-300 px-1 py-1 text-center text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" autocomplete="off"
               data-role="tiebreak-bottom"
               data-action="input->score-board#scoreChanged"
               aria-label="<%= t("games.show.score_board.tiebreak") %>"
               class="hidden w-8 rounded border-gray-300 px-0 py-1 text-center text-xs dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
      </div>
      <button type="button"
              data-role="remove-set"
              data-action="score-board#removeSet"
              title="<%= t("games.show.score_board.remove_set") %>"
              aria-label="<%= t("games.show.score_board.remove_set") %>"
              class="w-6 shrink-0 rounded text-center hover:bg-gray-100 dark:hover:bg-slate-700">×</button>
    </div>
  </template>

  <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("games.show.score_board.tiebreak_hint") %></p>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
    <div>
      <button type="button"
              data-score-board-target="recognizeButton"
              data-action="score-board#choosePhoto"
              class="inline-flex items-center gap-1 rounded-md border border-indigo-300 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50 disabled:opacity-60 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
        📷 <span data-score-board-target="recognizeLabel"><%= t("games.show.score_board.recognize") %></span>
      </button>
      <input type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
             data-score-board-target="photo"
             data-action="change->score-board#recognize"
             class="hidden">
    </div>
    <code data-score-board-target="preview" class="text-sm text-gray-600 dark:text-slate-300">—</code>
  </div>
  <p data-score-board-target="status" role="status" class="mt-1 hidden text-xs text-gray-500 dark:text-slate-400"></p>
</div>

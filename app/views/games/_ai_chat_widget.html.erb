<%# Floating AI chat widget %>
<div data-controller="ai-chat"
     data-ai-chat-url-value="<%= ai_chat_path %>"
     class="fixed bottom-20 right-4 z-50 md:bottom-6 md:right-8 flex flex-col items-end gap-3">

  <%# Chat panel %>
  <div data-ai-chat-target="panel"
       class="hidden w-80 sm:w-96 flex flex-col rounded-[1.5rem] overflow-hidden shadow-[0_20px_60px_rgba(79,70,229,0.25)] ring-1 ring-white/15 dark:shadow-[0_24px_70px_rgba(15,23,42,0.55)]"
       style="max-height: 440px;">

    <%# Header — gradient like the hero %>
    <div class="relative overflow-hidden bg-gradient-to-br from-indigo-600 via-indigo-500 to-purple-500 dark:from-indigo-900 dark:via-indigo-800 dark:to-fuchsia-800 px-4 py-4">
      <%# Decorative grid lines %>
      <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.07]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="ai-grid" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M 24 0 L 0 0 0 24" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#ai-grid)"/>
      </svg>
      <%# Decorative circle %>
      <div class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 rounded-full bg-white/10 blur-xl"></div>

      <div class="relative flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/20 ring-1 ring-white/30 backdrop-blur-sm">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-white leading-tight">Tennis Assistant</p>
            <p class="text-[10px] text-white/60 leading-tight">Powered by AI</p>
          </div>
        </div>
        <button data-action="ai-chat#close"
                class="flex h-7 w-7 items-center justify-center rounded-full bg-white/10 text-white/70 hover:bg-white/20 hover:text-white transition-all"
                aria-label="Close">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <%# Messages area %>
    <div data-ai-chat-target="messages"
         class="flex-1 overflow-y-auto space-y-2.5 bg-gray-50 dark:bg-slate-900 p-4"
         style="min-height: 180px; max-height: 220px;">
      <div class="flex justify-start gap-2">
        <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 mt-0.5">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/>
          </svg>
        </div>
        <div class="max-w-[80%] rounded-2xl rounded-tl-sm bg-white dark:bg-slate-800 text-gray-800 dark:text-slate-200 px-3.5 py-2.5 text-sm shadow-sm ring-1 ring-black/5 dark:ring-white/10">
          Hi! I can help you find opponents, courts or coaches. What are you looking for?
        </div>
      </div>
    </div>

    <%# Quick reply buttons %>
    <div data-ai-chat-target="quickReplies"
         class="flex flex-wrap gap-1.5 bg-gray-50 dark:bg-slate-900 px-4 pb-3">
      <button type="button"
              data-action="ai-chat#quickSend"
              data-ai-chat-message-param="Find me an opponent"
              class="rounded-full border border-indigo-200 dark:border-indigo-500/40 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-indigo-600 dark:text-indigo-400 shadow-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
        🎾 Find opponent
      </button>
      <button type="button"
              data-action="ai-chat#quickSend"
              data-ai-chat-message-param="Find me a court"
              class="rounded-full border border-indigo-200 dark:border-indigo-500/40 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-indigo-600 dark:text-indigo-400 shadow-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
        🏟 Find court
      </button>
      <button type="button"
              data-action="ai-chat#quickSend"
              data-ai-chat-message-param="Find me a coach"
              class="rounded-full border border-indigo-200 dark:border-indigo-500/40 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-indigo-600 dark:text-indigo-400 shadow-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
        👨‍🏫 Find coach
      </button>
      <% if current_user&.admin? %>
        <button type="button"
                data-action="ai-chat#quickSend"
                data-ai-chat-mode-param="insert"
                data-ai-chat-message-param="I'm ready to record historical match results. You can send multiple matches in one message. Please use this format:

Date: 2026-04-08
Hours: 1.5
Team A: @user1
Team B: @user2
Score: 4:2

Date: 2026-04-08
Hours: 2
Team A: @user1, @user2
Team B: @user3, @user4
Score: 6:2 6:3"
                class="rounded-full border border-amber-200 dark:border-amber-500/40 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-amber-700 dark:text-amber-300 shadow-sm hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-colors">
          📝 Record result
        </button>
      <% end %>
    </div>

    <%# Input area %>
    <form data-action="submit->ai-chat#send"
          class="flex items-center gap-2 border-t border-gray-100 dark:border-white/10 bg-white dark:bg-slate-900 p-3">
      <textarea data-ai-chat-target="input"
                data-action="keydown->ai-chat#handleKey"
                rows="1"
                placeholder="Ask me anything..."
                class="flex-1 resize-none rounded-xl border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-slate-800 px-3 py-2 text-sm text-gray-900 dark:text-slate-100 placeholder-gray-400 dark:placeholder-slate-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500/30"></textarea>
      <button type="submit"
              class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-600 to-purple-600 text-white shadow-md hover:from-indigo-500 hover:to-purple-500 transition-all disabled:opacity-50">
        <svg data-ai-chat-target="spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
        </svg>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12zm0 0h7.5"/>
        </svg>
      </button>
    </form>
  </div>

  <%# Toggle button — matches "New" button style + shimmer %>
  <style>
    @keyframes ai-shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .ai-btn-shimmer::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(
        110deg,
        transparent 25%,
        rgba(255,255,255,0.12) 45%,
        rgba(255,255,255,0.18) 50%,
        rgba(255,255,255,0.12) 55%,
        transparent 75%
      );
      background-size: 200% 100%;
      animation: ai-shimmer 5s ease-in-out infinite;
    }
  </style>
  <button data-ai-chat-target="button"
          data-action="ai-chat#toggle"
          class="ai-btn-shimmer relative overflow-hidden flex flex-col items-center justify-center bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-lg transition-colors cursor-pointer"
          style="width:3rem;height:3rem;"
          aria-label="Open AI assistant">
    <span class="relative z-10 text-xs font-bold tracking-wide leading-none">AI</span>
  </button>
</div>

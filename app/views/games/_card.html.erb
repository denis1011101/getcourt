<div class="group relative rounded-xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
  <%= link_to "", game_path(game), class: "absolute inset-0 z-0" %>

  <!-- Color accent bar based on sport -->
  <% sport_colors = { "tennis" => "bg-green-500", "padel" => "bg-blue-500", "table_tennis" => "bg-orange-500", "squash" => "bg-purple-500" } %>
  <div class="h-1 <%= sport_colors[game.sport.to_s.downcase] || 'bg-indigo-500' %>"></div>

  <div class="p-4">
    <!-- Date & Time -->
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600">
          <% display_date = game.display_date_for_show || game.date %>
          <% if display_date %>
            <div class="text-center leading-none">
              <div class="text-[10px] font-medium uppercase"><%= display_date.strftime("%b") %></div>
              <div class="text-base font-bold"><%= display_date.strftime("%d") %></div>
            </div>
          <% else %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25"/>
            </svg>
          <% end %>
        </div>
        <div>
          <% if display_date %>
            <p class="text-sm font-medium text-gray-900"><%= display_date.strftime("%A") %></p>
          <% end %>
          <% game_time = game.next_time || game.time %>
          <% if game_time %>
            <p class="text-xs text-gray-500"><%= game_time.strftime("%I:%M %p") %></p>
          <% end %>
        </div>
      </div>

      <% if can_manage?(game) %>
        <%= link_to edit_game_path(game), class: "relative z-10 p-1.5 rounded-full hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition", title: "Edit" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
          </svg>
        <% end %>
      <% end %>
    </div>

    <!-- Court name -->
    <h3 class="text-base font-semibold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors">
      <%= game.court.name %>
    </h3>

    <!-- Badges row -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      <% required = (game.respond_to?(:players_count) && game.players_count.to_i > 0) ? game.players_count.to_i : 4 %>
      <% approved = game.participations.respond_to?(:approved) ? game.participations.approved : game.participations %>
      <% taken = approved.size %>
      <% spots_left = required - taken %>

      <% if game.respond_to?(:sport) && game.sport.present? %>
        <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">
          <%= game.sport.to_s.titleize %>
        </span>
      <% end %>

      <% skill_attr = %w[min_skill skill_level level].find { |a| game.respond_to?(a) && game.public_send(a).present? } %>
      <% if skill_attr %>
        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700">
          <%= game.public_send(skill_attr).to_s.titleize %>
        </span>
      <% end %>

      <% if game.respond_to?(:with_coach) && game.with_coach? %>
        <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">
          Coach
        </span>
      <% end %>

      <% if game.respond_to?(:recurring) && game.recurring? %>
        <span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700">
          Weekly
        </span>
      <% end %>

      <% if game.respond_to?(:urgent_player_search?) && game.urgent_player_search? %>
        <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-medium text-rose-700">
          Urgent search
        </span>
      <% end %>
    </div>

    <% if game.tournament.present? %>
      <div class="mb-3 text-xs text-gray-500 truncate">
        Tournament:
        <%= link_to (game.tournament.respond_to?(:name) ? game.tournament.name : "##{game.tournament.id}"),
                    tournament_path(game.tournament),
                    class: "relative z-10 font-medium text-indigo-600 hover:text-indigo-800" %>
      </div>
    <% end %>

    <!-- Players bar -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <!-- Player dots -->
        <div class="flex -space-x-1">
          <% [taken, 4].min.times do %>
            <div class="w-6 h-6 rounded-full bg-indigo-100 border-2 border-white flex items-center justify-center">
              <svg class="w-3 h-3 text-indigo-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
              </svg>
            </div>
          <% end %>
          <% if spots_left > 0 %>
            <% [spots_left, 3].min.times do %>
              <div class="w-6 h-6 rounded-full bg-gray-50 border-2 border-dashed border-gray-300 flex items-center justify-center">
                <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
              </div>
            <% end %>
          <% end %>
        </div>
        <span class="text-xs text-gray-500"><%= taken %>/<%= required %></span>
      </div>

      <% if spots_left > 0 %>
        <span class="text-xs font-medium text-green-600"><%= spots_left %> spot<%= spots_left == 1 ? '' : 's' %> left</span>
      <% else %>
        <span class="text-xs font-medium text-red-500">Full</span>
      <% end %>
    </div>
  </div>
</div>

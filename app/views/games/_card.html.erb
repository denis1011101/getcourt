<div class="group relative rounded-xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden dark:border-white/10 dark:bg-slate-800/80">
  <%= link_to "", game_path(game), class: "absolute inset-0 z-0" %>
  <% participations = game.participations.loaded? ? game.participations.target : game.participations.to_a %>
  <% taken = participations.count(&:approved?) %>
  <% required = (game.respond_to?(:players_count) && game.players_count.to_i > 0) ? game.players_count.to_i : 4 %>
  <% spots_left = required - taken %>

  <!-- Color accent bar based on sport -->
  <% sport_colors = { "tennis" => "bg-green-500", "padel" => "bg-blue-500", "table_tennis" => "bg-orange-500", "squash" => "bg-purple-500" } %>
  <div class="h-1 <%= sport_colors[game.sport.to_s.downcase] || 'bg-indigo-500' %>"></div>

  <div class="p-4">
    <!-- Date & Time -->
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/15 dark:text-indigo-300">
          <%# Recurring games show the next occurrence, not the original start date. %>
          <% display_date = game.recurring? ? (game.next_date || game.date) : (game.display_date_for_show || game.date) %>
          <% if display_date %>
            <div class="text-center leading-none">
              <div class="text-[10px] font-medium uppercase"><%= display_date.strftime("%b") %></div>
              <div class="text-base font-bold"><%= display_date.strftime("%d") %></div>
            </div>
          <% else %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25"/>
            </svg>
          <% end %>
        </div>
        <div>
          <% if display_date %>
            <p class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= display_date.strftime("%A") %></p>
          <% end %>
          <% game_time = game.next_time || game.time %>
          <% if game_time %>
            <p class="text-xs text-gray-500 dark:text-slate-400"><%= game_time.strftime("%I:%M %p") %></p>
          <% end %>
        </div>
      </div>

      <% if can_manage?(game) %>
        <%= link_to edit_game_path(game), class: "relative z-10 p-1.5 rounded-full hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition dark:hover:bg-white/10 dark:text-slate-400 dark:hover:text-slate-200", title: t("common.edit") do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
          </svg>
        <% end %>
      <% end %>
    </div>

    <!-- Court name -->
    <h3 class="text-base font-semibold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors dark:text-slate-100">
      <%= game.court.name %>
    </h3>

    <!-- Badges row -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      <% if game.respond_to?(:sport) && game.sport.present? %>
        <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700 dark:bg-slate-700 dark:text-slate-100">
          <%= t("games.sports.#{game.sport.to_s.parameterize(separator: '_')}", default: game.sport.to_s.titleize) %>
        </span>
      <% end %>

      <% skill_attr = %w[min_skill skill_level level].find { |a| game.respond_to?(a) && game.public_send(a).present? } %>
      <% if skill_attr %>
        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/15 dark:text-amber-200">
          <%= game.public_send(skill_attr).to_s.titleize %>
        </span>
      <% end %>

      <% if game.respond_to?(:surface_label) && game.surface_label.present? %>
        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/15 dark:text-amber-300">
          <%= game.surface_label %>
        </span>
      <% end %>

      <% if game.respond_to?(:environment_label) && game.environment_label.present? %>
        <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-medium text-sky-700 dark:bg-sky-500/15 dark:text-sky-300">
          <%= game.environment_label %>
        </span>
      <% end %>

      <% if game.respond_to?(:with_coach) && game.with_coach? %>
        <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/15 dark:text-blue-200">
          <%= t("games.badges.coach") %>
        </span>
      <% end %>

      <% if game.respond_to?(:recurring) && game.recurring? %>
        <span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700 dark:bg-purple-500/15 dark:text-purple-200">
        <%= t("games.badges.weekly") %>
        </span>
      <% end %>

      <% if game.respond_to?(:urgent_player_search?) && game.urgent_player_search? %>
        <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/15 dark:text-rose-200">
    <%= t("games.badges.player_search") %>
        </span>
      <% end %>

      <% if game.court&.coordinates_pair && game.environment.to_s != "indoor" %>
        <%= turbo_frame_tag dom_id(game, :weather), src: game_weather_path(game), loading: "lazy", class: "contents" %>
      <% end %>
    </div>

    <% if game.tournament.present? %>
      <div class="mb-3 flex items-center gap-1.5 text-xs text-gray-500 truncate dark:text-slate-400">
        <span class="inline-flex flex-shrink-0 items-center gap-1 rounded-full bg-purple-50 px-2.5 py-0.5 font-medium text-purple-700 dark:bg-purple-500/15 dark:text-purple-200">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M18.75 4.236c.982.143 1.954.317 2.916.52A6.003 6.003 0 0016.27 9.728M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228m0 0a6.003 6.003 0 01-5.54 0"/>
          </svg>
          <%= t("games.show.tournament") %>
        </span>
        <%= link_to (game.tournament.name.presence || "##{game.tournament.id}"),
                    tournament_path(game.tournament),
                    class: "relative z-10 truncate font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>
      </div>
    <% end %>

    <% if game.comment.present? %>
      <%# One muted line — the full text lives on the game page. %>
      <p class="mb-3 truncate text-xs text-gray-500 dark:text-slate-400" data-testid="game-card-comment">
        <%= truncate(game.comment.squish, length: 80) %>
      </p>
    <% end %>

    <!-- Players bar -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <!-- Player dots -->
        <div class="flex -space-x-1">
          <% [taken, 4].min.times do %>
            <div class="w-6 h-6 rounded-full bg-indigo-100 border-2 border-white flex items-center justify-center dark:bg-indigo-500/20 dark:border-slate-800">
              <svg class="w-3 h-3 text-indigo-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
              </svg>
            </div>
          <% end %>
          <% if spots_left > 0 %>
            <% [spots_left, 3].min.times do %>
              <div class="w-6 h-6 rounded-full bg-gray-50 border-2 border-dashed border-gray-300 flex items-center justify-center dark:bg-slate-700 dark:border-slate-500">
                <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
              </div>
            <% end %>
          <% end %>
        </div>
        <span class="text-xs text-gray-500 dark:text-slate-400"><%= taken %>/<%= required %></span>
      </div>

      <% if spots_left > 0 %>
        <span class="text-xs font-medium text-green-600"><%= t("games.card.spots_left", count: spots_left) %></span>
      <% else %>
        <span class="text-xs font-medium text-red-500"><%= t("games.card.full") %></span>
      <% end %>
    </div>
  </div>
</div>

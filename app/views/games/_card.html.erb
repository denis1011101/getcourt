<div class="rounded-md border p-4 bg-white shadow-sm flex flex-col justify-between">
  <div>
    <p class="text-sm text-gray-500">
      <%= game.display_date_for_show ? game.display_date_for_show.strftime("%B %d, %Y") : (game.date && game.date.strftime("%B %d, %Y")) %>
      <% if game.next_time || game.time %>
        — <span class="font-medium text-gray-900"><%= (game.next_time || game.time)&.strftime("%I:%M %p") %></span>
      <% end %>
    </p>

    <p class="text-sm text-gray-600 mt-2">
      <%= link_to game.court.name, court_path(game.court), class: "text-indigo-600 hover:underline" %>
    </p>

    <p class="text-sm text-gray-700 mt-3">
      <% required = (game.respond_to?(:players_count) && game.players_count.to_i > 0) ? game.players_count.to_i : 4 %>
      <span class="inline-block rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-800">
        <%= "#{game.participations.count}/#{required} players" %>
      </span>

      <%# render badges from controller helper %>
      <% game_badges(game).each do |b| %>
        <span class="<%= b[:classes] %>"><%= b[:text] %></span>
      <% end %>
    </p>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <%= link_to "View", game_path(game), class: "text-sm font-medium text-indigo-600 hover:text-indigo-700" %>
    <% if can_manage?(game) %>
      <%= link_to "Edit", edit_game_path(game), class: "text-sm text-gray-600 hover:underline" %>
    <% end %>
  </div>
</div>
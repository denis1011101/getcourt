<% approved_count = @game.participations.respond_to?(:approved) ? @game.participations.approved.count : @game.participations.count %>
<% content_for :meta_title, t("games.show.meta_title", court: @game.court&.name, date: l((@game.next_date || @game.date).to_date, format: :long)) %>
<% content_for :meta_description, t("games.show.meta_description", count: approved_count, court: @game.court&.name) %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= json_escape({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": root_url },
        { "@type": "ListItem", "position": 2, "name": "Games", "item": root_url },
        { "@type": "ListItem", "position": 3, "name": "Game #{display_date(@game)}" }
      ]
    }.to_json).html_safe %>
  </script>
<% end %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 dark:text-slate-400 mb-4">
    <%= link_to t("layout.nav.home"), root_path, class: "hover:text-gray-700 dark:hover:text-white" %> &rsaquo;
    <%= link_to t("layout.nav.games"), root_path, class: "hover:text-gray-700 dark:hover:text-white" %> &rsaquo;
    <span class="text-gray-900 dark:text-slate-100"><%= t("games.show.game_on", date: display_date(@game)) %></span>
  </nav>

  <div class="flex items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-semibold"><%= t("games.show.title") %></h1>
      <p class="text-gray-600 dark:text-slate-400"><%= t("games.show.subtitle") %></p>
    </div>
    <%= link_to t("games.show.back_to_games"),
                root_path,
                class: "shrink-0 inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
  </div>

  <div class="bg-white rounded-lg border p-6 shadow-sm dark:bg-slate-800/80 dark:border-white/10">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("games.show.date") %></p>
        <p class="text-lg font-medium text-gray-900 dark:text-slate-100">
          <% game_badges(@game).each do |b| %>
            <% badge_text = b[:text].to_s %>
            <% badge_classes =
                 case badge_text.downcase
                 when /coach/
                   "inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/15 dark:text-blue-200"
                 when /weekly/
                   "inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700 dark:bg-purple-500/15 dark:text-purple-200"
                 when /urgent/
                   "inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/15 dark:text-rose-200"
                 when /spot/, %r{\A\d+/\d+\z}
                   "inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/15 dark:text-rose-200"
                 else
                   "inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700 dark:bg-slate-700 dark:text-slate-100"
                 end %>
            <span class="<%= badge_classes %>"><%= badge_text %></span>
          <% end %>
          <%= display_date(@game) %>
        </p>
      </div>

      <div>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("games.show.time") %></p>
        <p class="text-lg font-medium text-gray-900 dark:text-slate-100"><%= display_time(@game) %></p>
      </div>

      <% if @game.respond_to?(:duration_minutes) && @game.duration_minutes.to_i > 0 %>
        <div>
          <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("games.show.duration") %></p>
          <p class="text-lg font-medium text-gray-900 dark:text-slate-100"><%= format_duration_minutes(@game.duration_minutes) %></p>
        </div>
      <% end %>

      <div class="sm:col-span-2">
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("games.show.court") %></p>
        <p class="text-lg font-medium text-indigo-700 dark:text-indigo-400">
          <%= link_to @game.court.name, court_path(@game.court), class: "transition-colors hover:text-indigo-800 hover:underline dark:hover:text-indigo-300" %>
        </p>
      </div>
    </div>

    <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-2"><%= t("games.show.participants") %></h2>
    <%= render "participations/list", game: @game %>
    <%= render "participations/controls", game: @game %>

    <% if current_user.present? && (current_user == @game.user || (current_user.respond_to?(:admin?) && current_user.admin?)) %>
      <div class="mt-4 space-y-4">
        <div class="rounded-md border border-gray-200 p-3 dark:border-white/10">
          <p class="mb-2 text-sm font-semibold text-gray-700 dark:text-slate-300">Invite players</p>
          <%= form_with url: game_invitations_path(@game), method: :post, local: true, class: "flex flex-col gap-2 sm:flex-row" do %>
            <%= text_field_tag :usernames,
                  nil,
                  placeholder: "@alice @bob",
                  class: "flex-1 rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
            <%= submit_tag "Send invites",
                  class: "inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700" %>
          <% end %>
        </div>

        <div class="rounded-md border border-gray-200 p-3 dark:border-white/10">
          <p class="mb-2 text-sm text-gray-500 dark:text-slate-400">
            Tap this to add a "looking for players" label to the game and send a notification to GetCourt members in your city's Telegram chat.
          </p>
          <%= button_to (@game.urgent_player_search? ? "Cancel players search" : "Announce players search"),
                toggle_urgent_player_search_game_path(@game),
                method: :post,
                class: "inline-flex items-center rounded-md border border-indigo-300 px-3 py-2 text-sm font-medium text-indigo-700 transition hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60" %>
        </div>
      </div>
    <% end %>

    <% if @game.prebooking_enabled? %>
      <%= render "prebookings", game: @game %>
    <% end %>

    <% can_fill_stats = false %>
    <% if current_user.present? %>
      <% can_fill_stats = (current_user == @game.user || (current_user.respond_to?(:admin?) && current_user.admin?)) %>
      <% unless can_fill_stats %>
        <% scope = @game.participations.respond_to?(:approved) ? @game.participations.approved : @game.participations %>
        <% can_fill_stats = scope.exists?(user_id: current_user.id) %>
      <% end %>
    <% end %>
    <% game_started =
         if @game.respond_to?(:started_for_ui?)
           @game.started_for_ui?
         elsif @game.respond_to?(:starts_at) && @game.starts_at.present?
           @game.starts_at <= Time.current
         elsif @game.respond_to?(:date) && @game.date.present?
           @game.date <= Date.current
         else
           true
         end %>

    <div class="mt-6 border-t dark:border-white/10 pt-4">
      <% last_reset = @game.last_participations_reset_at %>
      <% stats_filled =
           if last_reset.present?
             PlayerStatisticEntry.where(game: @game).where("recorded_at >= ?", last_reset.beginning_of_day).exists? ||
               Match.where(game_id: @game.id).where("played_at >= ?", last_reset.beginning_of_day).exists?
           else
             PlayerStatisticEntry.where(game: @game).exists? || Match.where(game_id: @game.id).exists?
           end %>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("games.show.enter_statistics") %></h2>
        <% if stats_filled %>
          <span class="text-xs font-medium text-green-700 bg-green-50 dark:bg-green-500/15 dark:text-green-200 px-2 py-1 rounded"><%= t("games.show.statistics_saved") %></span>
        <% else %>
          <span class="text-xs font-medium text-amber-700 bg-amber-50 dark:bg-amber-500/15 dark:text-amber-200 px-2 py-1 rounded">
            <%= game_started ? "Fill in the statistics" : "Fill in the statistics after game starts" %>
          </span>
        <% end %>
      </div>

      <% if can_fill_stats && game_started %>
        <%= render "games/stats_form", game: @game %>
      <% else %>
        <p class="text-gray-600 dark:text-slate-400 text-sm"><%= t("games.show.stats_locked") %></p>
      <% end %>
    </div>
  </div>
</div>

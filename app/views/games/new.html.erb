<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold">Create New Game</h1>
      <p class="text-gray-600">Set date, time and place for a new game.</p>
    </div>
    <div>
      <%= link_to "Back to Games", games_path, class: "text-sm text-gray-600 hover:underline" %>
    </div>
  </div>

  <div class="bg-white rounded-lg border p-6 shadow-sm">
    <%= render "form", game: @game %>
  </div>
</div>

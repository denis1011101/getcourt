<% participants = [] %>
<% participants << game.user if game.respond_to?(:user) %>
<% if game.respond_to?(:participations) %>
  <% scope = game.participations.respond_to?(:approved) ? game.participations.approved : game.participations %>
  <% participants.concat(scope.includes(:user).map(&:user)) %>
  <% guest_participations = scope.respond_to?(:guests) ? scope.guests : scope.select(&:guest?) %>
<% else %>
  <% guest_participations = [] %>
<% end %>
<% group = local_assigns[:group] %>
<% prefill_a_ids = group ? group[:team_a_ids] : [] %>
<% prefill_b_ids = group ? group[:team_b_ids] : [] %>
<% prefill_a_guests = group ? group[:team_a_guest_names] : [] %>
<% prefill_b_guests = group ? group[:team_b_guest_names] : [] %>
<% participants = participants.compact.uniq { |u| u.id } %>
<% extra_ids = (prefill_a_ids + prefill_b_ids) - participants.map(&:id) %>
<% participants += User.where(id: extra_ids).to_a if extra_ids.any? %>
<% addable_users = User.where.not(id: participants.map(&:id)).where.not(name: [nil, ""]).order(:name).limit(200) %>

<div data-stats-match-block class="rounded border border-gray-200 p-3 dark:border-white/10">
  <% if group && group[:group_id] %>
    <%= hidden_field_tag "matches[#{index}][group_id]", group[:group_id], id: nil %>
  <% end %>
  <div class="mb-3 flex items-center justify-between">
    <h3 class="text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("games.show.match_block_title", number: index.is_a?(Integer) ? index + 1 : "__NUMBER__") %></h3>
    <% if removable %>
      <button type="button"
              data-action="click->stats-matches#remove"
              aria-label="<%= t("games.show.remove_match") %>"
              class="rounded px-2 py-1 text-sm text-gray-500 hover:bg-gray-100 dark:text-slate-300 dark:hover:bg-slate-700">
        x
      </button>
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-4 border-b pb-4 dark:border-white/10 sm:grid-cols-2">
    <div>
      <h4 class="mb-2 text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("games.show.team_a") %></h4>
      <div class="space-y-1">
        <% participants.each do |u| %>
          <% label = u.respond_to?(:name) && u.name.present? ? u.name : u.email %>
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
            <%= check_box_tag "matches[#{index}][team_a_user_ids][]", u.id, prefill_a_ids.include?(u.id), class: "rounded border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
            <span><%= label %></span>
          </label>
        <% end %>
        <% guest_participations.each do |gp| %>
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
            <%= check_box_tag "matches[#{index}][team_a_guest_names][]", gp.guest_name, prefill_a_guests.include?(gp.guest_name), class: "rounded border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
            <span><%= gp.guest_name %> (<%= t("games.show.guest_badge") %>)</span>
          </label>
        <% end %>
      </div>
      <div class="mt-3">
        <label class="mb-1 block text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.guest_label") %></label>
        <%= text_field_tag "matches[#{index}][team_a_guests]", (prefill_a_guests - guest_participations.map(&:guest_name)).join(", ").presence, placeholder: t("games.show.guest_placeholder"), class: "w-full rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
      </div>
      <div class="mt-3"
           data-controller="team-players"
           data-team-players-field-name-value="matches[<%= index %>][team_a_user_ids][]">
        <label class="mb-1 block text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.add_player_label") %></label>
        <div class="flex items-center gap-2">
          <select data-team-players-target="select"
                  class="w-full rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
            <option value=""><%= t("games.show.add_player_prompt") %></option>
            <% addable_users.each do |u| %>
              <option value="<%= u.id %>"><%= u.name %></option>
            <% end %>
          </select>
          <button type="button"
                  aria-label="<%= t("games.show.add_team_player") %>"
                  data-action="click->team-players#add"
                  class="inline-flex items-center gap-1 rounded-md border border-indigo-300 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
            +
          </button>
        </div>
        <div data-team-players-target="list" class="mt-2 space-y-1"></div>
      </div>
    </div>

    <div>
      <h4 class="mb-2 text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("games.show.team_b") %></h4>
      <div class="space-y-1">
        <% participants.each do |u| %>
          <% label = u.respond_to?(:name) && u.name.present? ? u.name : u.email %>
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
            <%= check_box_tag "matches[#{index}][team_b_user_ids][]", u.id, prefill_b_ids.include?(u.id), class: "rounded border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
            <span><%= label %></span>
          </label>
        <% end %>
        <% guest_participations.each do |gp| %>
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
            <%= check_box_tag "matches[#{index}][team_b_guest_names][]", gp.guest_name, prefill_b_guests.include?(gp.guest_name), class: "rounded border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
            <span><%= gp.guest_name %> (<%= t("games.show.guest_badge") %>)</span>
          </label>
        <% end %>
      </div>
      <div class="mt-3">
        <label class="mb-1 block text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.guest_label") %></label>
        <%= text_field_tag "matches[#{index}][team_b_guests]", (prefill_b_guests - guest_participations.map(&:guest_name)).join(", ").presence, placeholder: t("games.show.guest_placeholder"), class: "w-full rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
      </div>
      <div class="mt-3"
           data-controller="team-players"
           data-team-players-field-name-value="matches[<%= index %>][team_b_user_ids][]">
        <label class="mb-1 block text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.add_player_label") %></label>
        <div class="flex items-center gap-2">
          <select data-team-players-target="select"
                  class="w-full rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100">
            <option value=""><%= t("games.show.add_player_prompt") %></option>
            <% addable_users.each do |u| %>
              <option value="<%= u.id %>"><%= u.name %></option>
            <% end %>
          </select>
          <button type="button"
                  aria-label="<%= t("games.show.add_team_player") %>"
                  data-action="click->team-players#add"
                  class="inline-flex items-center gap-1 rounded-md border border-indigo-300 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60">
            +
          </button>
        </div>
        <div data-team-players-target="list" class="mt-2 space-y-1"></div>
      </div>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-1 gap-3 lg:grid-cols-[10rem_minmax(0,1fr)]">
    <div>
      <span class="mb-2 block text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.winner") %></span>
      <label class="mb-1 flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
        <%= radio_button_tag "matches[#{index}][winner_team]", "a", group && group[:winner] == "a" %>
        <span><%= t("games.show.team_a") %></span>
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
        <%= radio_button_tag "matches[#{index}][winner_team]", "b", group && group[:winner] == "b" %>
        <span><%= t("games.show.team_b") %></span>
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
        <%= radio_button_tag "matches[#{index}][winner_team]", "draw", group && group[:winner] == "draw" %>
        <span><%= t("games.show.draw") %></span>
      </label>
    </div>

    <div class="min-w-0">
      <label class="mb-1 block text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.score") %></label>
      <%= render "games/score_board", index: index, score: group ? group[:score] : nil %>
    </div>
  </div>
</div>

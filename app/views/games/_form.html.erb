<%= form_with(model: game, local: true) do |form| %>
  <% if game.errors.any? %>
    <div id="error_explanation" class="mb-4 rounded-md bg-red-50 border border-red-200 p-4 text-red-700">
      <h2 class="font-semibold"><%= pluralize(game.errors.count, "error") %> prohibited this game from being saved:</h2>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% game.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-lg border p-6 shadow-sm">
    <div class="mb-4">
      <label class="inline-flex items-center gap-2">
        <%= form.check_box :recurring, { class: "h-4 w-4 text-indigo-600" }, "1", "0" %>
        <span class="text-sm text-gray-700">Repeat weekly</span>
      </label>
      <p class="mt-1 text-xs text-gray-500">If checked, this date and time will recur every week.</p>
    </div>

    <div class="mb-4">
      <label class="inline-flex items-center gap-2">
        <%= form.check_box :with_coach, { class: "h-4 w-4 text-indigo-600" }, "1", "0" %>
        <span class="text-sm text-gray-700">With coach</span>
      </label>
      <p class="mt-1 text-xs text-gray-500">If checked, this game will be held with a coach.</p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :date, "Date", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :date, value: game.date, class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= form.label :time, "Time", class: "block text-sm font-medium text-gray-700" %>
        <%= form.time_field :time, value: game.time, class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :players_count, "Players", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :players_count,
              options_for_select([[2,2],[4,4]], (game.players_count || 4)),
              {}, class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">Select required number of players (2 or 4).</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :sport, "Sport", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :sport,
              options_for_select(User::SPORTS.map { |s| [s, s] }, (game.respond_to?(:sport) ? game.sport : nil)),
              { include_blank: "— select sport —" },
              class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :skill_level, "Required level", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :skill_level,
              options_for_select(User::SKILL_LEVELS.map { |l| [l.titleize, l] }, (game.respond_to?(:skill_level) ? game.skill_level : nil)),
              { include_blank: "Any level" },
              class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="space-y-3"
         data-controller="court-picker"
         data-court-picker-default-lat-value="56.838011"
         data-court-picker-default-lng-value="60.597465"
         data-court-picker-courts-value="<%= json_escape(Court.all.map { |c|
           lat, lng = c.coordinates.to_s.split(',').map(&:to_f)
           { id: c.id, name: c.name, lat: lat, lng: lng }
         }.to_json) %>">
      <div>
        <%= form.label :court_id, "Place", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :court_id, Court.all, :id, :name,
              {}, { class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                   data: { "court-picker-target": "select", action: "change->court-picker#selectChanged" } } %>
        <p class="mt-1 text-xs text-gray-500">Choose court from list or click marker on the map.</p>
      </div>

      <div>
        <%= render "shared/map_panel" do %>
          <div data-court-picker-target="map" class="h-72 w-full rounded border bg-white mb-2"></div>
        <% end %>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= form.submit (game.persisted? ? "Update Game" : "Create Game"),
            class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition" %>
      <%= link_to "Cancel", games_path, class: "block inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition" %>
    </div>
  </div>
<% end %>
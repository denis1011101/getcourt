<%= form_with(model: game, local: true) do |form| %>
  <% if game.errors.any? %>
    <div id="error_explanation" class="mb-4 rounded-md bg-red-50 border border-red-200 p-4 text-red-700 dark:bg-red-500/10 dark:border-red-500/20 dark:text-red-300">
      <h2 class="font-semibold"><%= pluralize(game.errors.count, "error") %> prohibited this game from being saved:</h2>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% game.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% tournament = game.tournament %>
  <div class="bg-white rounded-lg border p-6 shadow-sm dark:bg-slate-800/80 dark:border-white/10">
    <%# A tournament game follows the tournament schedule, so the standalone options are hidden. %>
    <% if tournament.present? %>
      <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/15 dark:text-amber-200">
        <p><%= t("games.form.tournament_notice") %></p>
        <p class="mt-1">
          <%= link_to (tournament.name.presence || t("layout.nav.tournaments")), tournament_path(tournament), class: "font-medium underline" %>
        </p>
      </div>
    <% else %>
      <div class="mb-4">
        <%# recurring toggle — Apply button removed, Stimulus will submit hidden turbo form %>
        <label class="inline-flex items-center gap-2">
          <%= form.check_box :recurring,
                { class: "h-4 w-4 text-indigo-600", id: "game_recurring",
                  data: { controller: "recurring", action: "change->recurring#toggle" } },
                "1", "0" %>
          <span class="text-sm text-gray-700 dark:text-slate-300">Repeat weekly</span>
        </label>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">If checked, this date and time will recur every week.</p>
      </div>

      <div class="mb-4">
        <label class="inline-flex items-center gap-2">
          <%= hidden_field_tag "game[prebooking_enabled]", "0", id: nil %>
          <%= check_box_tag "game[prebooking_enabled]", "1", game.prebooking_enabled?,
                class: "h-4 w-4 text-indigo-600", id: "game_prebooking_enabled", disabled: !game.recurring? %>
          <span class="text-sm text-gray-700 dark:text-slate-300">Enable prebooking</span>
        </label>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">Players can reserve slots for upcoming dates.</p>
        <% unless game.recurring? %>
          <p class="mt-1 text-xs text-gray-600 dark:text-slate-400">Prebooking can be enabled only for repeating (weekly) games. Check "Repeat weekly" to enable prebooking.</p>
        <% end %>
      </div>

      <div class="mb-4">
        <label class="inline-flex items-center gap-2">
          <%= form.check_box :with_coach, { class: "h-4 w-4 text-indigo-600" }, "1", "0" %>
          <span class="text-sm text-gray-700 dark:text-slate-300">With coach</span>
        </label>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">If checked, this game will be held with a coach.</p>
      </div>

      <div class="mb-4">
        <label class="inline-flex items-center gap-2">
          <%= form.check_box :urgent_player_search, { class: "h-4 w-4 text-indigo-600" }, "1", "0" %>
          <span class="text-sm text-gray-700 dark:text-slate-300">Players search</span>
        </label>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">Show this game in "Games looking for player" and notify users with enabled nearby alerts.</p>
      </div>
    <% end %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :date, "Date", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <% tournament_range = [ tournament&.start_date, tournament&.end_date ].compact %>
        <%= form.date_field :date, value: game.date,
              min: tournament&.start_date, max: tournament&.end_date,
              class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        <% if tournament_range.any? %>
          <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">
            <%= t("games.form.tournament_dates_hint", range: tournament_range.uniq.map { |day| day.strftime("%d.%m.%Y") }.join(" — ")) %>
          </p>
        <% end %>
      </div>
      <div>
        <%= form.label :time, "Time", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= form.time_field :time, value: game.time, class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :players_count, "Players", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= form.select :players_count,
              options_for_select([[2,2],[4,4]], (game.players_count || 4)),
              {}, class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">Select required number of players (2 or 4).</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :sport, "Sport", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= form.select :sport,
              options_for_select(SportCatalog::SPORTS.map { |s| [s, s] }, (game.respond_to?(:sport) ? game.sport : nil)),
              { include_blank: "— select sport —" },
              class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :skill_level, "Required level", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= form.select :skill_level,
              options_for_select(User::SKILL_LEVELS.map { |l| [l.titleize, l] }, (game.respond_to?(:skill_level) ? game.skill_level : nil)),
              { include_blank: "Any level" },
              class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <%= form.label :duration_minutes, "Duration (optional)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= form.select :duration_minutes,
              options_for_select(
                [
                  ["1h", 60],
                  ["1h 30m", 90],
                  ["2h", 120],
                  ["2h 30m", 150],
                  ["3h", 180],
                  ["4h", 240]
                ],
                (game.respond_to?(:duration_minutes) ? game.duration_minutes : nil)
              ),
              { include_blank: "— not specified —" },
              class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">Approximate or exact playing time. Helps others see how long the court will be busy.</p>
      </div>
    </div>

    <% sorted_courts = tournament&.courts&.any? ? tournament.courts.to_a : Court.sorted_for_user(current_user) %>
    <div class="space-y-3"
         data-controller="court-picker"
         data-court-picker-default-lat-value="56.838011"
         data-court-picker-default-lng-value="60.597465"
         data-court-picker-courts-value="<%= json_escape(sorted_courts.map { |c|
           lat, lng = c.coordinates.to_s.split(',').map(&:to_f)
           { id: c.id, name: c.name, lat: lat, lng: lng, surfaces: c.surfaces, environments: c.environments }
         }.to_json) %>"
         data-court-picker-surface-labels-value="<%= json_escape(Court::SURFACES.index_with { |s| t("courts.surfaces.#{s}") }.to_json) %>"
         data-court-picker-environment-labels-value="<%= json_escape(Game::ENVIRONMENTS.index_with { |e| t("courts.index.#{e}_badge") }.to_json) %>"
         data-court-picker-surface-selected-value="<%= game.surface %>"
         data-court-picker-environment-selected-value="<%= game.environment %>">
      <div>
        <%= form.label :court_id, "Place", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= form.collection_select :court_id, sorted_courts, :id, :name,
              {}, { class: "mt-1 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                   data: { "court-picker-target": "select", action: "change->court-picker#selectChanged" } } %>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">
          <%= tournament&.courts&.any? ? t("games.form.tournament_courts_hint") : "Choose court from list or click marker on the map." %>
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= form.label :surface, t("games.form.surface"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= form.select :surface, [], { include_blank: t("games.form.surface_any") },
                class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                data: { "court-picker-target": "surfaceSelect" } %>
          <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("games.form.surface_hint") %></p>
        </div>

        <div>
          <%= form.label :environment, t("games.form.environment"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= form.select :environment, [], { include_blank: t("games.form.environment_any") },
                class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                data: { "court-picker-target": "environmentSelect" } %>
          <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("games.form.environment_hint") %></p>
        </div>
      </div>

      <div>
        <%= render "shared/map_panel" do %>
          <div data-court-picker-target="map" class="h-72 w-full rounded border bg-white mb-2 dark:bg-slate-700"></div>
        <% end %>
      </div>
    </div>

    <div class="mt-4">
      <%= form.label :comment, t("games.form.comment"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= form.text_area :comment, rows: 3, maxlength: 500, placeholder: t("games.form.comment_placeholder"),
            class: "mt-2 block w-full rounded-md border border-gray-300 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("games.form.comment_hint") %></p>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= form.submit (game.persisted? ? "Update Game" : "Create Game"),
            class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition" %>
      <%= link_to "Cancel", root_path, class: "block inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 transition dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
    </div>

    <% if local_assigns.fetch(:show_actions, false) && game.persisted? %>
      <div class="mt-4 pt-4 border-t flex items-center gap-3">
        <%= link_to "View Game", game_path(game), class: "text-sm text-indigo-600 transition-colors hover:text-indigo-800 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300" %>
        <% if can_manage?(game) %>
          <%= link_to "Delete Game", game_path(game), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-sm text-red-600 hover:underline" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<% content_for :meta_title, @games_meta_title %>
<% content_for :meta_description, @games_meta_description %>
<% content_for :canonical_url, @canonical_games_url %>
<div class="max-w-6xl mx-auto">
  <%= render "shared/homepage_banner", featured_match: @featured_match %>

  <!-- Hero section -->
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-indigo-600 via-indigo-500 to-purple-500 px-6 py-5 md:px-10 md:py-8 mb-6 text-white ring-1 ring-white/15 shadow-[0_20px_60px_rgba(79,70,229,0.18)] dark:from-indigo-900 dark:via-indigo-800 dark:to-fuchsia-800 dark:ring-white/10 dark:shadow-[0_24px_70px_rgba(15,23,42,0.45)]">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/14 via-white/5 to-transparent dark:from-white/8 dark:via-indigo-400/5 dark:to-transparent"></div>
    <div class="pointer-events-none absolute -top-24 -right-24 w-72 h-72 rounded-full bg-purple-400/20 blur-3xl dark:bg-fuchsia-500/15 animate-pulse [animation-duration:4s]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-16 w-56 h-56 rounded-full bg-indigo-300/15 blur-3xl dark:bg-indigo-400/10"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/30 dark:bg-white/15"></div>
    <!-- Decorative tennis court lines -->
    <svg class="pointer-events-none absolute right-4 md:right-10 top-1/2 -translate-y-1/2 w-24 h-32 md:w-32 md:h-44 opacity-[0.08] dark:opacity-[0.06]" viewBox="0 0 120 160" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="4" y="4" width="112" height="152" rx="2"/>
      <line x1="18" y1="4" x2="18" y2="156"/>
      <line x1="102" y1="4" x2="102" y2="156"/>
      <line x1="4" y1="80" x2="116" y2="80"/>
      <line x1="18" y1="52" x2="102" y2="52"/>
      <line x1="18" y1="108" x2="102" y2="108"/>
      <line x1="60" y1="52" x2="60" y2="108"/>
      <line x1="56" y1="4" x2="64" y2="4"/>
      <line x1="56" y1="156" x2="64" y2="156"/>
    </svg>

    <div class="relative">
      <h1 class="text-xl md:text-3xl font-bold tracking-tight"><%= t("games.index.hero_title") %><span class="inline-flex items-center ml-1" style="vertical-align: -0.02em;"><svg viewBox="0 0 24 24" style="width: 0.26em; height: 0.26em;" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#d4f542"/><path d="M3 8 Q9 12 3 16" fill="none" stroke="white" stroke-width="1.8" opacity="0.7" stroke-linecap="round"/><path d="M21 8 Q15 12 21 16" fill="none" stroke="white" stroke-width="1.8" opacity="0.7" stroke-linecap="round"/></svg></span></h1>
      <p class="mt-1 text-white/90 dark:text-indigo-100 text-sm max-w-xl"><%= t("games.index.hero_subtitle") %></p>

      <%= render "shared/location_filters",
            url: root_path,
            countries: @countries,
            cities: @cities,
            selected_country: params[:country],
            selected_city: params[:city] %>
    </div>
  </div>

  <div class="mb-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900"><%= t("games.index.title") %></h2>
      <p class="text-sm text-gray-500 mt-1"><%= t("games.index.subtitle") %></p>
    </div>

    <!-- Filter chips -->
    <div class="mt-4 flex flex-wrap gap-2">
      <%= form_with url: root_path, method: :get, local: true, id: "filter-form", class: "contents" do |f| %>
        <!-- Hidden fields to preserve other filters -->
        <% if params[:country].present? %>
          <%= f.hidden_field :country, value: params[:country] %>
        <% end %>
        <% if params[:city].present? %>
          <%= f.hidden_field :city, value: params[:city] %>
        <% end %>
        <% if params[:sport].present? %>
          <%= f.hidden_field :sport, value: params[:sport] %>
        <% end %>
        <% if params[:skill_level].present? %>
          <%= f.hidden_field :skill_level, value: params[:skill_level] %>
        <% end %>
        <% if params[:with_spots].present? %>
          <%= f.hidden_field :with_spots, value: params[:with_spots] %>
        <% end %>
        <% if params[:my_games].present? %>
          <%= f.hidden_field :my_games, value: params[:my_games] %>
        <% end %>
        <% if params[:looking_for_players].present? %>
          <%= f.hidden_field :looking_for_players, value: params[:looking_for_players] %>
        <% end %>
        <% if params[:tournament_games].present? %>
          <%= f.hidden_field :tournament_games, value: params[:tournament_games] %>
        <% end %>

        <!-- My Games chip (only for authenticated users) -->
        <% if user_signed_in? %>
          <% my_active = params[:my_games].present? %>
          <button type="submit" name="my_games" value="<%= my_active ? '' : '1' %>"
                  class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                         <%= my_active ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25' %>">
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
              </svg>
              <%= t("games.index.my_games") %>
            </span>
          </button>
        <% end %>

        <!-- Sport chips -->
        <% sports_list = @sports.present? ? @sports : [] %>
        <% sports_list.each do |sport| %>
          <% active = params[:sport] == sport %>
          <button type="submit" name="sport" value="<%= active ? '' : sport %>"
                  class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                         <%= active ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25' %>">
            <%= sport.titleize %>
          </button>
        <% end %>

        <!-- Skill level chips -->
        <% skill_list = @skill_levels.present? ? @skill_levels : [] %>
        <% skill_list.each do |level| %>
          <% active = params[:skill_level] == level %>
          <button type="submit" name="skill_level" value="<%= active ? '' : level %>"
                  class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                         <%= active ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25' %>">
            <%= level.titleize %>
          </button>
        <% end %>

        <!-- Free spots chip -->
        <% spots_active = params[:with_spots].present? %>
        <button type="submit" name="with_spots" value="<%= spots_active ? '' : '1' %>"
                class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                       <%= spots_active ? 'bg-green-600 text-white border-green-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25' %>">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
            </svg>
            <%= t("games.index.free_spots") %>
          </span>
        </button>

        <!-- Looking for players chip -->
        <% looking_active = params[:looking_for_players].present? %>
        <button type="submit" name="looking_for_players" value="<%= looking_active ? '' : '1' %>"
                class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                       <%= looking_active ? 'bg-amber-500 text-white border-amber-500' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25' %>">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 19l2 2m-2-2a3 3 0 10-4.243-4.243A3 3 0 0019 19z"/>
            </svg>
            <%= t("games.index.looking_for_players") %>
          </span>
        </button>

        <!-- Tournament games chip -->
        <% tournament_active = params[:tournament_games].present? %>
        <button type="submit" name="tournament_games" value="<%= tournament_active ? '' : '1' %>"
                class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                       <%= tournament_active ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400 dark:bg-slate-800 dark:text-slate-200 dark:border-white/10 dark:hover:border-white/25' %>">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M18.75 4.236c.982.143 1.954.317 2.916.52A6.003 6.003 0 0016.27 9.728M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228m0 0a6.003 6.003 0 01-5.54 0"/>
            </svg>
            <%= t("games.index.tournament_games") %>
          </span>
        </button>
      <% end %>

      <% if params[:country].present? || params[:sport].present? || params[:skill_level].present? || params[:city].present? || params[:with_spots].present? || params[:my_games].present? || params[:looking_for_players].present? || params[:tournament_games].present? %>
        <%= link_to root_path, class: "flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 transition" do %>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <%= t("common.reset") %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Active filter summary -->
  <% active_filters = location_filter_labels %>
  <% active_filters << params[:sport]&.titleize if params[:sport].present? %>
  <% active_filters << params[:skill_level]&.titleize if params[:skill_level].present? %>
  <% active_filters << t("games.index.free_spots") if params[:with_spots].present? %>
  <% active_filters << t("games.index.my_games") if params[:my_games].present? %>
  <% active_filters << t("games.index.looking_for_players") if params[:looking_for_players].present? %>
  <% active_filters << t("games.index.tournament_games") if params[:tournament_games].present? %>

  <%= render "shared/results_summary", count: @games.size, noun: "game", filters: active_filters do %>
    <% if user_signed_in? %>
      <%= link_to new_game_path, class: "hidden md:inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        <%= t("games.index.new_game") %>
      <% end %>
    <% end %>
  <% end %>

  <!-- Games grid -->
  <% if @games.empty? %>
    <div class="rounded-2xl border-2 border-dashed border-gray-200 p-12 text-center dark:border-white/10">
      <svg class="mx-auto w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
      </svg>
      <p class="text-gray-500 font-medium"><%= t("games.index.empty_title") %></p>
      <p class="text-gray-400 text-sm mt-1"><%= t("games.index.empty_subtitle") %></p>
      <% if user_signed_in? %>
        <%= link_to t("games.index.create_game"), new_game_path, class: "inline-flex items-center gap-1.5 mt-4 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @games.each do |game| %>
        <%= render partial: "games/card", locals: { game: game } %>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/pagy", pagy: @pagy %>
</div>

<%= render "games/ai_chat_widget" %>

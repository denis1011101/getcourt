<div class="max-w-5xl mx-auto px-4 py-2">
  <% sign_in_path = (respond_to?(:new_session_path) && new_session_path) || '/sign_in' rescue '/sign_in' %>
  <% action_text = user_signed_in? ? "Add New Game" : "Login to Add Game" %>
   <%= render "shared/page_header",
       title: "Scheduled Games",
       description: "Manage and track upcoming matches.",
      action_text: action_text,
      action_path: (user_signed_in? ? new_game_path : sign_in_path) %>

  <%= form_with url: games_path, method: :get, local: true, class: "mb-4 rounded-lg border bg-white p-4" do |f| %>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
      <%= f.select :sport, options_for_select(@sports, params[:sport]), { include_blank: "All sports" }, class: "w-full rounded border-gray-300" %>
      <%= f.select :skill_level, options_for_select(@skill_levels, params[:skill_level]), { include_blank: "All levels" }, class: "w-full rounded border-gray-300" %>
      <%= f.select :city, options_for_select(@cities, params[:city]), { include_blank: "All cities" }, class: "w-full rounded border-gray-300" %>
      <label class="inline-flex items-center gap-2 rounded border border-gray-300 px-3 py-2 text-sm text-gray-700">
        <%= f.check_box :with_spots, { checked: params[:with_spots].present? }, "1", nil %>
        Only with free spots
      </label>
    </div>
    <div class="mt-3 flex gap-2">
      <%= f.submit "Apply filters", class: "rounded bg-indigo-600 px-4 py-2 text-white" %>
      <%= link_to "Reset", games_path, class: "rounded border border-gray-300 px-4 py-2 text-gray-700" %>
    </div>
  <% end %>

  <% if @games.empty? %>
    <div class="rounded-lg border border-dashed p-8 text-center text-gray-500">
      No games scheduled yet.
    </div>
  <% else %>
    <h2 class="text-lg font-medium mb-3">Upcoming Games</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @games.each do |game| %>
      <div>
        <%= render partial: "games/card", locals: { game: game } %>

        <% if game.tournament.present? %>
          <div class="mt-2 text-sm text-gray-600">
            Tournament:
            <%= link_to (game.tournament.respond_to?(:name) ? game.tournament.name : "##{game.tournament.id}"),
                        tournament_path(game.tournament),
                        class: "font-medium text-indigo-600" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
</div>

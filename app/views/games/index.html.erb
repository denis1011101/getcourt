<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold">Scheduled Games</h1>
      <p class="text-gray-600">Manage and track upcoming matches.</p>
    </div>
    <%= link_to 'Add New Game', new_game_path, class: 'inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition' %>
  </div>

  <% if @games.empty? %>
    <div class="rounded-lg border border-dashed p-8 text-center text-gray-500">
      No games scheduled yet.
    </div>
  <% else %>
    <h2 class="text-lg font-medium mb-3">Upcoming Games</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @games.each do |game| %>
        <%= render partial: "games/card", locals: { game: game } %>
      <% end %>
    </div>
  <% end %>
</div>
<div class="max-w-5xl mx-auto px-4 py-2">
  <% sign_in_path = (respond_to?(:new_session_path) && new_session_path) || '/sign_in' rescue '/sign_in' %>
  <% action_text = user_signed_in? ? "Add New Game" : "Login to Add Game" %>
   <%= render "shared/page_header",
       title: "Scheduled Games",
       description: "Manage and track upcoming matches.",
      action_text: action_text,
      action_path: (user_signed_in? ? new_game_path : sign_in_path) %>

  <% if @games.empty? %>
    <div class="rounded-lg border border-dashed p-8 text-center text-gray-500">
      No games scheduled yet.
    </div>
  <% else %>
    <h2 class="text-lg font-medium mb-3">Upcoming Games</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @games.each do |game| %>
      <div>
        <%= render partial: "games/card", locals: { game: game } %>

        <% if game.tournament.present? %>
          <div class="mt-2 text-sm text-gray-600">
            Tournament:
            <%= link_to (game.tournament.respond_to?(:name) ? game.tournament.name : "##{game.tournament.id}"),
                        tournament_path(game.tournament),
                        class: "font-medium text-indigo-600" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
</div>
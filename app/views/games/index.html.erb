<% content_for :meta_title, "GetCourt — Find Tennis, Padel & Squash Games Near You" %>
<% content_for :meta_description, "Join or create tennis, padel, table tennis and squash games. Find players and courts near you. Quick setup with Telegram reminders." %>
<div class="max-w-6xl mx-auto">
  <!-- Hero section -->
  <div class="rounded-2xl bg-gradient-to-br from-indigo-600 via-indigo-500 to-purple-500 px-6 py-8 md:px-10 md:py-12 mb-6 text-white">
    <h1 class="text-2xl md:text-4xl font-bold tracking-tight">Find your next game</h1>
    <p class="mt-2 text-indigo-100 text-sm md:text-base max-w-xl">Tennis, padel, table tennis — join a match near you or create your own.</p>

    <!-- Inline search bar -->
    <div class="mt-5 flex flex-col sm:flex-row gap-2 max-w-2xl">
      <%= form_with url: root_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-2 w-full" do |f| %>
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <%= f.select :city, options_for_select(@cities, params[:city]), { include_blank: "Any city" },
              class: "w-full rounded-full pl-9 pr-4 py-2.5 text-gray-900 text-sm bg-white border-0 focus:ring-2 focus:ring-white/50 appearance-none" %>
        </div>
        <%= f.submit "Search", class: "rounded-full bg-white px-6 py-2.5 text-sm font-semibold text-indigo-600 hover:bg-indigo-50 transition cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- Horizontal filter chips -->
  <div class="mb-5 -mx-4 px-4">
    <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
      <%= form_with url: root_path, method: :get, local: true, id: "filter-form", class: "contents" do |f| %>
        <!-- Hidden fields to preserve other filters -->
        <% if params[:city].present? %>
          <%= f.hidden_field :city, value: params[:city] %>
        <% end %>
        <% if params[:sport].present? %>
          <%= f.hidden_field :sport, value: params[:sport] %>
        <% end %>
        <% if params[:skill_level].present? %>
          <%= f.hidden_field :skill_level, value: params[:skill_level] %>
        <% end %>
        <% if params[:with_spots].present? %>
          <%= f.hidden_field :with_spots, value: params[:with_spots] %>
        <% end %>
        <% if params[:my_games].present? %>
          <%= f.hidden_field :my_games, value: params[:my_games] %>
        <% end %>

        <!-- My Games chip (only for authenticated users) -->
        <% if user_signed_in? %>
          <% my_active = params[:my_games].present? %>
          <button type="submit" name="my_games" value="<%= my_active ? '' : '1' %>"
                  class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                         <%= my_active ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400' %>">
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
              </svg>
              My Games
            </span>
          </button>
        <% end %>

        <!-- Sport chips -->
        <% sports_list = @sports.present? ? @sports : [] %>
        <% sports_list.each do |sport| %>
          <% active = params[:sport] == sport %>
          <button type="submit" name="sport" value="<%= active ? '' : sport %>"
                  class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                         <%= active ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400' %>">
            <%= sport.titleize %>
          </button>
        <% end %>

        <!-- Skill level chips -->
        <% skill_list = @skill_levels.present? ? @skill_levels : [] %>
        <% skill_list.each do |level| %>
          <% active = params[:skill_level] == level %>
          <button type="submit" name="skill_level" value="<%= active ? '' : level %>"
                  class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                         <%= active ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400' %>">
            <%= level.titleize %>
          </button>
        <% end %>

        <!-- Free spots chip -->
        <% spots_active = params[:with_spots].present? %>
        <button type="submit" name="with_spots" value="<%= spots_active ? '' : '1' %>"
                class="flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border transition
                       <%= spots_active ? 'bg-green-600 text-white border-green-600' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400' %>">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/>
            </svg>
            Free spots
          </span>
        </button>
      <% end %>

      <% if params[:sport].present? || params[:skill_level].present? || params[:city].present? || params[:with_spots].present? || params[:my_games].present? %>
        <%= link_to root_path, class: "flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 transition" do %>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Reset
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Active filter summary -->
  <% active_filters = [] %>
  <% active_filters << params[:city] if params[:city].present? %>
  <% active_filters << params[:sport]&.titleize if params[:sport].present? %>
  <% active_filters << params[:skill_level]&.titleize if params[:skill_level].present? %>
  <% active_filters << "Free spots" if params[:with_spots].present? %>
  <% active_filters << "My Games" if params[:my_games].present? %>

  <div class="flex items-center justify-between mb-4">
    <div>
      <% if active_filters.any? %>
        <p class="text-sm text-gray-500"><%= @games.size %> game<%= @games.size == 1 ? '' : 's' %> &middot; <%= safe_join(active_filters, ' &middot; '.html_safe) %></p>
      <% else %>
        <p class="text-sm text-gray-500"><%= @games.size %> game<%= @games.size == 1 ? '' : 's' %> available</p>
      <% end %>
    </div>
    <% if user_signed_in? %>
      <%= link_to new_game_path, class: "hidden md:inline-flex items-center gap-1.5 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        New Game
      <% end %>
    <% end %>
  </div>

  <!-- Games grid -->
  <% if @games.empty? %>
    <div class="rounded-2xl border-2 border-dashed border-gray-200 p-12 text-center">
      <svg class="mx-auto w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
      </svg>
      <p class="text-gray-500 font-medium">No games scheduled yet</p>
      <p class="text-gray-400 text-sm mt-1">Be the first to create a game!</p>
      <% if user_signed_in? %>
        <%= link_to "Create Game", new_game_path, class: "inline-flex items-center gap-1.5 mt-4 rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" %>
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @games.each do |game| %>
        <%= render partial: "games/card", locals: { game: game } %>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/pagy", pagy: @pagy %>
</div>

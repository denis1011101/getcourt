<% chances = Games::WinChances.for_game(game, viewer: current_user) %>
<section class="mt-4 rounded-md border border-sky-200 bg-sky-50/70 p-3 dark:border-sky-400/20 dark:bg-sky-500/10" data-testid="game-win-chances">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("games.show.win_chances.title") %></h2>
    <% if chances.available? %>
      <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("games.show.win_chances.mode.#{chances.mode}") %></p>
    <% end %>
  </div>

  <% if chances.available? %>
    <% if chances.splits.any? %>
      <h3 class="mt-3 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400"><%= t("games.show.win_chances.splits_title") %></h3>
      <ul class="mt-2 space-y-3">
        <% chances.splits.each_with_index do |split, index| %>
          <% percent = (split.probability * 100).round %>
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-2 text-sm text-gray-800 dark:text-slate-200">
              <span>
                <%= split.team_a.map(&:name).join(" + ") %>
                <span class="text-gray-400 dark:text-slate-500"><%= t("games.show.win_chances.versus") %></span>
                <%= split.team_b.map(&:name).join(" + ") %>
              </span>
              <span class="font-semibold tabular-nums"><%= percent %>% / <%= 100 - percent %>%</span>
            </div>
            <div class="mt-1 flex h-1.5 overflow-hidden rounded-full bg-gray-200 dark:bg-slate-700" role="presentation">
              <div class="bg-sky-500 dark:bg-sky-400" style="width: <%= percent %>%"></div>
            </div>
            <% if index.zero? && chances.splits.size > 1 %>
              <p class="mt-1 text-xs text-sky-700 dark:text-sky-300"><%= t("games.show.win_chances.most_even") %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if chances.duels.any? %>
      <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400"><%= t("games.show.win_chances.duels_title") %></h3>
      <ul class="mt-2 space-y-1.5">
        <% chances.duels.each do |duel| %>
          <li class="flex flex-wrap items-baseline justify-between gap-x-2 text-sm text-gray-800 dark:text-slate-200">
            <span><%= duel.player.name %></span>
            <span class="flex items-baseline gap-2">
              <span class="text-xs text-gray-500 dark:text-slate-400">
                <% if duel.played.zero? %>
                  <%= t("games.show.win_chances.no_record") %>
                <% else %>
                  <%= t("games.show.win_chances.record", wins: duel.wins, losses: duel.losses) %>
                <% end %>
              </span>
              <span class="font-semibold tabular-nums"><%= (duel.probability * 100).round %>%</span>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400"><%= t("games.show.win_chances.form_title") %></h3>
    <ul class="mt-2 space-y-1.5">
      <% chances.players.each do |player| %>
        <li class="flex flex-wrap items-center justify-between gap-x-2 text-sm text-gray-800 dark:text-slate-200">
          <span><%= player.name %></span>
          <span class="flex items-center gap-2">
            <% if player.form.any? %>
              <span class="flex items-center gap-1" title="<%= t("games.show.win_chances.form_summary", wins: player.form_wins, count: player.form.size) %>">
                <% player.form.each do |outcome| %>
                  <span class="h-2 w-2 rounded-full <%= { "win" => "bg-emerald-500", "loss" => "bg-gray-300 dark:bg-slate-600", "draw" => "bg-amber-400" }.fetch(outcome, "bg-gray-300 dark:bg-slate-600") %>"></span>
                <% end %>
              </span>
              <span class="text-xs text-gray-500 dark:text-slate-400 tabular-nums"><%= t("games.show.win_chances.form_summary", wins: player.form_wins, count: player.form.size) %></span>
            <% else %>
              <span class="text-xs text-gray-500 dark:text-slate-400"><%= t("games.show.win_chances.no_form") %></span>
            <% end %>
            <span class="text-xs text-gray-500 dark:text-slate-400 tabular-nums"><%= player.rating.round %></span>
          </span>
        </li>
      <% end %>
    </ul>

    <% if chances.unrated.any? %>
      <p class="mt-3 text-xs text-gray-500 dark:text-slate-400">
        <%= t("games.show.win_chances.unrated", names: chances.unrated.map(&:name).to_sentence, count: chances.unrated.size, rating: Games::WinChances::BASE_RATING.round) %>
      </p>
    <% end %>
  <% else %>
    <p class="mt-2 text-sm text-gray-600 dark:text-slate-300" data-testid="game-win-chances-pending">
      <%= t("games.show.win_chances.pending.#{chances.unavailable_reason}") %>
    </p>

    <h3 class="mt-3 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400"><%= t("games.show.win_chances.preview_title") %></h3>
    <ul class="mt-2 space-y-1.5 text-xs text-gray-500 dark:text-slate-400">
      <% %w[splits duels form].each do |item| %>
        <li class="flex gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-400 dark:bg-sky-500" role="presentation"></span>
          <span><%= t("games.show.win_chances.preview.#{item}") %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

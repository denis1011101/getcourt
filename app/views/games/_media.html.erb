<%# Фото и ролики с игры. Прикладывать может организатор, админ и любой
    записавшийся участник — снимает обычно не тот, кто игру создал. %>
<% media = game.game_media.visible.includes(:user, file_attachment: :blob).newest_first %>

<div class="mt-6 border-t dark:border-white/10 pt-4" data-testid="game-media">
  <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-3"><%= t("games.show.media.title") %></h2>

  <% if media.any? %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <% media.each do |medium| %>
        <figure class="relative overflow-hidden rounded-md border border-gray-200 dark:border-white/10">
          <% preview = medium.preview_variant %>
          <% if preview %>
            <%= image_tag preview, loading: "lazy", alt: t("games.show.media.alt"), class: "h-32 w-full object-cover" %>
          <% elsif medium.video? %>
            <video controls preload="none" playsinline class="h-32 w-full bg-black object-cover">
              <source src="<%= rails_blob_path(medium.file) %>" type="<%= medium.content_type %>">
            </video>
          <% end %>

          <% if current_user && (medium.user_id == current_user.id || current_user.admin?) %>
            <%= button_to t("games.show.media.remove"),
                  game_medium_path(game, medium),
                  method: :delete,
                  form: { data: { turbo_confirm: t("games.show.media.remove_confirm") } },
                  class: "absolute right-1 top-1 rounded bg-black/60 px-2 py-0.5 text-xs text-white hover:bg-black/80" %>
          <% end %>
        </figure>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-600 dark:text-slate-400"><%= t("games.show.media.empty") %></p>
  <% end %>

  <% if can_contribute %>
    <%= form_with url: game_media_path(game), method: :post, multipart: true, class: "mt-3 flex flex-wrap items-center gap-2" do |f| %>
      <%= f.file_field :file, required: true,
            accept: GameMedium::CONTENT_TYPES.join(","),
            class: "text-sm text-gray-700 file:mr-2 file:rounded file:border-0 file:bg-indigo-50 file:px-3 file:py-1 file:text-indigo-700 dark:text-slate-300" %>
      <%= f.submit t("games.show.media.upload"), class: "rounded bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700" %>
    <% end %>
    <p class="mt-2 text-xs text-gray-500 dark:text-slate-400">
      <%= t("games.show.media.limits",
            images: GameMedium::MAX_IMAGES_PER_GAME,
            image_size: GameMedium::MAX_IMAGE_SIZE / 1.megabyte,
            videos: GameMedium::MAX_VIDEOS_PER_GAME,
            video_size: GameMedium::MAX_VIDEO_SIZE / 1.megabyte) %>
    </p>
  <% end %>
</div>

<%# Invites GetCourt players by Telegram username — the bot delivers the invitation. %>
<div data-controller="invite-suggestions">
  <%= form_with url: game_invitations_path(game), method: :post, local: true, class: "flex flex-col gap-2 sm:flex-row" do %>
    <%= text_field_tag :usernames,
          nil,
          placeholder: t("games.show.invite.placeholder"),
          data: { invite_suggestions_target: "input" },
          class: "flex-1 rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
    <%= submit_tag t("games.show.invite.submit"),
          class: "inline-flex shrink-0 items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
  <p class="mt-2 text-xs text-gray-500 dark:text-slate-400"><%= t("games.show.invite.hint") %></p>

  <%# Re-inviting the same group is the common case, so recent lists refill the field in one click. %>
  <% if (recent_lists = current_user&.recent_invite_handles.presence) %>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <span class="text-xs text-gray-500 dark:text-slate-400"><%= t("games.show.invite.recent") %></span>
      <% recent_lists.each do |handles| %>
        <% mentions = handles.map { |handle| "@#{handle}" }.join(" ") %>
        <button type="button"
                data-action="invite-suggestions#fill"
                data-handles="<%= mentions %>"
                title="<%= mentions %>"
                class="max-w-full cursor-pointer truncate rounded-full border border-gray-300 px-3 py-1 text-xs text-gray-700 transition hover:border-indigo-500 hover:text-indigo-700 dark:border-white/15 dark:text-slate-200 dark:hover:border-indigo-400 dark:hover:text-indigo-300">
          <%= mentions %>
        </button>
      <% end %>
    </div>
  <% end %>
</div>

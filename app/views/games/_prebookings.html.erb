<% horizon = local_assigns.fetch(:horizon, 3) %>
<% dates = game.prebooking_candidate_dates(horizon) %>
<% required = game.prebooking_required_players %>
<% prebookings_by_date_and_slot = game.prebookings.where(date: dates).includes(:user).index_by { |prebooking| [prebooking.date, prebooking.slot_index] } %>
<% cancellations_by_date = game.prebooking_cancellations.where(date: dates).index_by(&:date) %>

<%= turbo_frame_tag "prebookings-#{game.id}", class: "block mt-6" do %>
  <% if game.prebooking_enabled? %>
    <h3 class="text-sm font-semibold text-gray-700 mb-2"><%= t("games.prebookings.title") %></h3>
  <div class="overflow-auto border rounded">
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-3 py-2 text-left"><%= t("games.prebookings.date") %></th>
          <% (1..required).each do |i| %>
            <th class="px-3 py-2 text-left"><%= t("games.prebookings.slot", number: i) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% dates.each do |d| %>
          <% cancellation = cancellations_by_date[d] %>
          <tr class="border-t <%= 'opacity-60 bg-red-50' if cancellation %>">
            <td class="px-3 py-2">
              <%= d.strftime("%Y-%m-%d") %>
              <% if user_signed_in? && (current_user.admin? || game.user == current_user) %>
                <% if cancellation %>
                  <%= button_to t("games.prebookings.restore_date"), game_prebooking_cancellation_path(game, cancellation), method: :delete, class: "ml-2 text-xs text-green-600" %>
                <% else %>
                  <%= button_to t("games.prebookings.cancel_date"), game_prebooking_cancellations_path(game, date: d), method: :post, data: { confirm: t("games.prebookings.cancel_date_confirm", date: d.strftime("%Y-%m-%d")) }, class: "ml-2 text-xs text-red-600" %>
                <% end %>
              <% end %>
            </td>

            <% if cancellation %>
              <td class="px-3 py-2 text-red-600" colspan="<%= required %>"><%= t("games.prebookings.cancelled") %></td>
            <% else %>
              <% (1..required).each do |si| %>
                <% pb = prebookings_by_date_and_slot[[d, si]] %>
                <td class="px-3 py-2">
                  <% if pb && pb.user %>
                    <% if pb.pending? %>
                      <div class="flex items-center gap-2">
                        <span><%= pb.user.name.presence || pb.user.email %></span>
                        <span class="inline-flex items-center rounded-md bg-amber-50 px-1.5 py-0.5 text-xs text-amber-700"><%= t("games.prebookings.pending") %></span>
                        <% if user_signed_in? && (current_user.admin? || game.user == current_user) %>
                          <%= button_to t("common.approve"), approve_game_prebooking_path(game, pb), method: :post, class: "text-xs text-emerald-600" %>
                          <%= button_to t("common.reject"), reject_game_prebooking_path(game, pb), method: :post, class: "text-xs text-red-600" %>
                        <% elsif pb.user == current_user %>
                          <%= button_to t("games.prebookings.cancel"), cancel_game_prebooking_path(game, pb), method: :post, class: "text-xs text-red-600" %>
                        <% end %>
                      </div>
                    <% else %>
                      <div class="flex items-center gap-2">
                        <span><%= pb.user.name.presence || pb.user.email %></span>
                        <% if pb.user == current_user || (user_signed_in? && (current_user.admin? || game.user == current_user)) %>
                          <%= button_to t("games.prebookings.cancel"), cancel_game_prebooking_path(game, pb), method: :post, class: "text-xs text-red-600" %>
                        <% end %>
                      </div>
                    <% end %>
                  <% else %>
                    <% if user_signed_in? %>
                      <% if pb %>
                        <% direct_book = current_user == game.user || (current_user.respond_to?(:admin?) && current_user.admin?) %>
                        <% book_label = direct_book ? t("games.prebookings.book") : t("games.prebookings.request") %>
                        <%= button_to book_label, book_game_prebooking_path(game, pb), method: :post, class: "text-xs bg-indigo-600 text-white px-2 py-1 rounded" %>
                      <% else %>
                        <span class="text-xs text-gray-400">—</span>
                      <% end %>
                    <% else %>
                      <span class="text-xs text-gray-400"><%= t("games.prebookings.sign_in_to_book") %></span>
                    <% end %>
                  <% end %>
                </td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>

  <% if game.coach_accepted? %>
    <% coach_bookings = game.coach_prebookings.where(date: dates).index_by(&:date) %>
    <div class="<%= "mt-5" if game.prebooking_enabled? %>">
      <h3 class="mb-2 text-sm font-semibold text-gray-700 dark:text-slate-200"><%= t("games.prebookings.coach_title") %></h3>
      <div class="overflow-auto rounded border dark:border-white/10">
        <table class="w-full text-sm">
          <tbody>
            <% dates.each do |date| %>
              <% booking = coach_bookings[date] %>
              <tr class="border-t dark:border-white/10">
                <td class="px-3 py-2"><%= date.strftime("%Y-%m-%d") %></td>
                <td class="px-3 py-2">
                  <%= booking ? t("games.prebookings.coach_confirmed") : t("games.prebookings.coach_not_booked") %>
                </td>
                <% if current_user == game.coach %>
                  <td class="px-3 py-2 text-right">
                    <% if booking %>
                      <%= button_to t("games.prebookings.coach_cancel"), game_coach_prebooking_path(game, booking), method: :delete, class: "text-xs text-red-600 dark:text-red-400" %>
                    <% elsif !game.cancelled_on?(date) %>
                      <%= button_to t("games.prebookings.coach_book"), game_coach_prebookings_path(game, date: date), method: :post, class: "rounded bg-violet-600 px-2 py-1 text-xs text-white" %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% if horizon < Game::MAX_PREBOOKING_HORIZON %>
    <%= link_to t("games.prebookings.show_more"), more_game_prebookings_path(game, horizon: [ horizon + 3, Game::MAX_PREBOOKING_HORIZON ].min), class: "mt-3 inline-flex text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400" %>
  <% end %>
<% end %>

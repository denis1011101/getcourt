<% dates = if @game.recurring?
  base = (@game.next_date.present? && @game.next_date > @game.date) ? @game.next_date : (@game.date + 7.days)
  Array.new(3) { |i| base + i.weeks }
else
  []
end %>
<% required = (@game.players_count.to_i > 0 ? @game.players_count.to_i : 4) %>

<div id="prebookings-<%= @game.id %>" class="mt-6">
  <h3 class="text-sm font-semibold text-gray-700 mb-2">Prebookings</h3>
  <div class="overflow-auto border rounded">
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-3 py-2 text-left">Date</th>
          <% (1..required).each do |i| %>
            <th class="px-3 py-2 text-left">Slot <%= i %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% dates.each do |d| %>
          <tr class="border-t">
            <td class="px-3 py-2"><%= d.strftime("%Y-%m-%d") %></td>
            <% (1..required).each do |si| %>
              <% pb = @game.prebookings.find_by(date: d, slot_index: si) %>
              <td class="px-3 py-2">
                <% if pb && pb.user %>
                  <div class="flex items-center gap-2">
                    <span><%= pb.user.name.presence || pb.user.email %></span>
                    <% if pb.user == current_user || can_manage?(@game) %>
                      <%= button_to "Cancel", cancel_game_prebooking_path(@game, pb), method: :post, class: "text-xs text-red-600" %>
                    <% end %>
                  </div>
                <% else %>
                  <% if user_signed_in? %>
                    <% if pb %>
                      <%= button_to "Book", book_game_prebooking_path(@game, pb), method: :post, class: "text-xs bg-indigo-600 text-white px-2 py-1 rounded" %>
                    <% else %>
                      <span class="text-xs text-gray-400">—</span>
                    <% end %>
                  <% else %>
                    <span class="text-xs text-gray-400">Sign in to book</span>
                  <% end %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% horizon = local_assigns.fetch(:horizon, 3) %>
<% dates = game.prebooking_candidate_dates(horizon) %>
<% required = game.prebooking_required_players %>
<% prebookings_by_date_and_slot = game.prebookings.where(date: dates).includes(:user).index_by { |prebooking| [prebooking.date, prebooking.slot_index] } %>
<% cancellations_by_date = game.prebooking_cancellations.where(date: dates).index_by(&:date) %>
<% accepted_coaches = game.accepted_coaches %>
<%# Тренеров у тренировки бывает двое, и каждый подтверждает свои даты сам. %>
<% coach_bookings = accepted_coaches.any? ? game.coach_prebookings.where(date: dates).index_by { |booking| [ booking.coach_id, booking.date ] } : {} %>
<% can_manage = user_signed_in? && (current_user.admin? || game.user == current_user) %>
<% weekdays = t("games.prebookings.weekdays") %>
<% month_names = t("games.prebookings.months") %>
<% taken_by_date = dates.index_with { |d| (1..required).count { |slot_index| prebookings_by_date_and_slot[[ d, slot_index ]]&.user } } %>

<%= turbo_frame_tag "prebookings-#{game.id}", class: "block mt-6" do %>
  <% if game.prebooking_enabled? || accepted_coaches.any? %>
    <h3 class="mb-2 text-sm font-semibold text-gray-700 dark:text-slate-300">
      <%= game.prebooking_enabled? ? t("games.prebookings.title") : t("games.prebookings.coach_title") %>
    </h3>

    <%# Календарь показывает, куда попадают занятия среди обычных дней; бронируют
        уже в карточках под ним — в клетку 7-колоночной сетки кнопки не влезают. %>
    <div class="w-full max-w-md rounded-lg border border-gray-200 p-3 dark:border-white/10" data-testid="prebooking-calendar">
      <% dates.map(&:beginning_of_month).uniq.each_with_index do |month, month_index| %>
        <p class="<%= "mt-3" if month_index.positive? %> mb-1.5 text-sm font-semibold text-gray-900 dark:text-slate-100">
          <%= month_names[month.month - 1] %> <%= month.year %>
        </p>
        <div class="grid grid-cols-7 gap-1">
          <% (1..7).each do |wday| %>
            <span class="pb-1 text-center text-[10px] uppercase tracking-wide text-gray-400 dark:text-slate-500"><%= weekdays[wday % 7] %></span>
          <% end %>

          <% (month.beginning_of_week(:monday)..month.end_of_month.end_of_week(:monday)).each do |day| %>
            <% in_month = day.month == month.month %>
            <% cancellation = cancellations_by_date[day] %>
            <% game_day = dates.include?(day) %>
            <% taken = taken_by_date[day].to_i %>
            <% cell_classes =
                 if !game_day
                   "bg-gray-50 text-gray-400 dark:bg-white/5 dark:text-slate-500"
                 elsif cancellation
                   "bg-red-100 text-red-700 line-through dark:bg-red-500/25 dark:text-red-200"
                 elsif game.prebooking_enabled? && taken >= required
                   "bg-emerald-100 font-semibold text-emerald-800 dark:bg-emerald-500/30 dark:text-emerald-100"
                 else
                   "bg-indigo-100 font-semibold text-indigo-800 dark:bg-indigo-500/35 dark:text-indigo-50"
                 end %>
            <% cell_body = capture do %>
              <span class="text-sm"><%= day.day %></span>
              <% if game_day && game.prebooking_enabled? && !cancellation %>
                <span class="text-[10px] tabular-nums"><%= taken %>/<%= required %></span>
              <% end %>
            <% end %>
            <% cell_classes = "#{cell_classes} flex min-h-11 flex-col items-center justify-center rounded-md leading-tight sm:min-h-9 #{"opacity-40" unless in_month} #{"ring-2 ring-indigo-400 dark:ring-indigo-300" if day == Date.current}" %>

            <% if game_day %>
              <%= link_to cell_body, "#prebooking-#{day.iso8601}",
                          class: "#{cell_classes} transition hover:brightness-95",
                          title: l(day, format: :long),
                          data: { testid: "calendar-day" } %>
            <% else %>
              <span class="<%= cell_classes %>" data-testid="calendar-day"><%= cell_body %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 border-t border-gray-200 pt-2 text-[11px] text-gray-600 dark:border-white/10 dark:text-slate-400">
        <li class="w-full font-medium text-gray-700 dark:text-slate-300"><%= t("games.prebookings.legend_title") %></li>
        <% legend = [
             [ "bg-indigo-100 dark:bg-indigo-500/40", t("games.prebookings.legend_free") ],
             [ "bg-emerald-100 dark:bg-emerald-500/40", t("games.prebookings.legend_full") ],
             [ "bg-amber-100 dark:bg-amber-500/40", t("games.prebookings.legend_pending") ],
             [ "bg-red-100 dark:bg-red-500/40", t("games.prebookings.legend_cancelled") ],
             [ "bg-gray-100 dark:bg-slate-700", t("games.prebookings.legend_no_game") ]
           ] %>
        <% legend.each do |swatch, label| %>
          <li class="flex items-center gap-1.5">
            <span class="inline-block h-2.5 w-2.5 shrink-0 rounded <%= swatch %>"></span><%= label %>
          </li>
        <% end %>
      </ul>
    </div>

    <% if game.prebooking_enabled? && !user_signed_in? %>
      <p class="mt-3 text-xs text-gray-500 dark:text-slate-400"><%= t("games.prebookings.sign_in_to_book") %></p>
    <% end %>

    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% dates.each do |d| %>
        <% cancellation = cancellations_by_date[d] %>
        <% slots = (1..required).map { |slot_index| [ slot_index, prebookings_by_date_and_slot[[ d, slot_index ]] ] } %>
        <% taken = taken_by_date[d].to_i %>
        <article id="prebooking-<%= d.iso8601 %>"
                 data-testid="prebooking-day"
                 class="scroll-mt-4 rounded-lg border p-3 <%= cancellation ? "border-red-200 bg-red-50/60 dark:border-red-400/20 dark:bg-red-500/10" : "border-gray-200 bg-gray-50/60 dark:border-white/10 dark:bg-white/5" %>">
          <header class="flex items-start justify-between gap-2">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-slate-400"><%= weekdays[d.wday] %></p>
              <p class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= l(d, format: :long) %></p>
            </div>
            <% if game.prebooking_enabled? && !cancellation %>
              <% full = taken >= required %>
              <span class="inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-xs font-medium tabular-nums <%= full ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200" : "bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-slate-100" %>"
                    title="<%= t("games.prebookings.filled", taken: taken, total: required) %>"><%= taken %>/<%= required %></span>
            <% end %>
          </header>

          <% if cancellation %>
            <p class="mt-3 text-xs text-red-600 dark:text-red-400"><%= t("games.prebookings.cancelled") %></p>
          <% elsif game.prebooking_enabled? %>
            <ul class="mt-3 space-y-1.5">
              <% slots.each do |slot_index, pb| %>
                <li class="flex items-center gap-2">
                  <span class="w-4 shrink-0 text-xs tabular-nums text-gray-400 dark:text-slate-500"
                        title="<%= t("games.prebookings.slot", number: slot_index) %>"><%= slot_index %></span>
                  <% if pb && pb.user %>
                    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-1 rounded-md border px-2 py-1.5 <%= pb.pending? ? "border-amber-200 bg-amber-50 dark:border-amber-400/20 dark:bg-amber-500/10" : "border-emerald-200 bg-emerald-50 dark:border-emerald-400/20 dark:bg-emerald-500/10" %>">
                      <span class="min-w-0 flex-1 truncate text-sm text-gray-900 dark:text-slate-100"><%= pb.user.name.presence || pb.user.email %></span>
                      <% if pb.pending? %>
                        <span class="inline-flex items-center rounded-md bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800 dark:bg-amber-500/20 dark:text-amber-200"><%= t("games.prebookings.pending") %></span>
                        <% if can_manage %>
                          <%= button_to t("common.approve"), approve_game_prebooking_path(game, pb), method: :post, form_class: "shrink-0", class: "text-xs font-medium text-emerald-700 hover:underline dark:text-emerald-300" %>
                          <%= button_to t("common.reject"), reject_game_prebooking_path(game, pb), method: :post, form_class: "shrink-0", class: "text-xs font-medium text-red-600 hover:underline dark:text-red-400" %>
                        <% elsif pb.user == current_user %>
                          <%= button_to t("games.prebookings.cancel"), cancel_game_prebooking_path(game, pb), method: :post, form_class: "shrink-0", class: "text-xs font-medium text-red-600 hover:underline dark:text-red-400" %>
                        <% end %>
                      <% elsif pb.user == current_user || can_manage %>
                        <%= button_to t("games.prebookings.cancel"), cancel_game_prebooking_path(game, pb), method: :post, form_class: "shrink-0", class: "text-xs font-medium text-red-600 hover:underline dark:text-red-400" %>
                      <% end %>
                    </div>
                  <% elsif user_signed_in? && pb %>
                    <% direct_book = current_user == game.user || (current_user.respond_to?(:admin?) && current_user.admin?) %>
                    <%= button_to (direct_book ? t("games.prebookings.book") : t("games.prebookings.request")),
                                  book_game_prebooking_path(game, pb),
                                  method: :post,
                                  form_class: "min-w-0 flex-1",
                                  class: "w-full rounded-md border border-dashed border-indigo-300 px-2 py-1.5 text-sm font-medium text-indigo-700 transition hover:bg-indigo-50 dark:border-indigo-400/30 dark:text-indigo-300 dark:hover:bg-indigo-500/10" %>
                  <% else %>
                    <span class="flex-1 rounded-md border border-dashed border-gray-200 px-2 py-1.5 text-sm text-gray-400 dark:border-white/10 dark:text-slate-500">—</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>

          <% if accepted_coaches.any? %>
            <div class="mt-3 space-y-1 border-t border-gray-200 pt-2 dark:border-white/10">
              <% accepted_coaches.each do |coach| %>
                <% booking = coach_bookings[[ coach.id, d ]] %>
                <div class="flex items-center justify-between gap-2">
                  <p class="min-w-0 truncate text-xs text-gray-500 dark:text-slate-400">
                    <%= accepted_coaches.many? ? (coach.name.presence || coach.email) : t("games.show.coach") %>:
                    <span class="font-medium <%= booking ? "text-emerald-700 dark:text-emerald-300" : "text-gray-600 dark:text-slate-300" %>">
                      <%= booking ? t("games.prebookings.coach_confirmed") : t("games.prebookings.coach_not_booked") %>
                    </span>
                  </p>
                  <% if coach == current_user %>
                    <% if booking %>
                      <%= button_to t("games.prebookings.coach_cancel"), game_coach_prebooking_path(game, booking), method: :delete, form_class: "shrink-0", class: "text-xs font-medium text-red-600 hover:underline dark:text-red-400" %>
                    <% elsif !cancellation %>
                      <%= button_to t("games.prebookings.coach_book"), game_coach_prebookings_path(game, date: d), method: :post, form_class: "shrink-0", class: "rounded-md bg-violet-600 px-2 py-1 text-xs font-medium text-white transition hover:bg-violet-700" %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if can_manage %>
            <div class="mt-3 border-t border-gray-200 pt-2 dark:border-white/10">
              <% if cancellation %>
                <%= button_to t("games.prebookings.restore_date"), game_prebooking_cancellation_path(game, cancellation), method: :delete, class: "text-xs font-medium text-emerald-700 hover:underline dark:text-emerald-300" %>
              <% else %>
                <%= button_to t("games.prebookings.cancel_date"), game_prebooking_cancellations_path(game, date: d), method: :post, data: { confirm: t("games.prebookings.cancel_date_confirm", date: l(d, format: :long)) }, class: "text-xs font-medium text-red-600 hover:underline dark:text-red-400" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>

  <% if horizon < Game::MAX_PREBOOKING_HORIZON %>
    <%= link_to t("games.prebookings.show_more"), more_game_prebookings_path(game, horizon: [ horizon + 3, Game::MAX_PREBOOKING_HORIZON ].min), class: "mt-3 inline-flex text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400" %>
  <% end %>
<% end %>

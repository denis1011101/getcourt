<%# Player statistics modal (CSS-only: open by hash, close via #close) %>
<div id="player-stats-<%= user.id %>" class="ps-modal" aria-hidden="true">
  <!-- overlay (click to close via anchor) -->
  <a href="#close" data-turbo="false" class="absolute inset-0 z-40" aria-hidden="true"></a>

  <div class="fixed left-1/2 top-16 z-50 w-[90%] md:w-auto max-w-2xl transform -translate-x-1/2 bg-white dark:bg-slate-800/80 p-6 md:p-8 rounded-lg shadow-lg pointer-events-auto">
    <a href="#close" data-turbo="false" class="absolute top-3 right-3 text-gray-600 dark:text-slate-400 hover:text-gray-800 dark:hover:text-slate-200 text-xl" aria-label="<%= t("common.close") %>">✕</a>

    <%= render partial: "player_statistics/summary",
               locals: {
                 user: user,
                 stats: stats,
                 matches: local_assigns[:matches],
                 names_by_id: local_assigns[:names_by_id] || {}
               } %>
  </div>
</div>

<!-- hidden target for closing the modal -->
<span id="close" style="display:none" aria-hidden="true"></span>

<h2 id="ps-title-<%= user.id %>" class="text-xl font-semibold mb-4">
  <%= t("player_statistics.title", name: user.name.presence || user.email) %>
</h2>

<% if stats.present? %>
  <% has_hours = stats.singles_hours.to_f > 0 || stats.doubles_hours.to_f > 0 %>
  <% has_activity = (stats.individual_training.to_i + stats.group_training.to_i + stats.singles_games.to_i + stats.doubles_games.to_i) > 0 %>
  <% has_match_stats = stats.aces.to_i > 0 || stats.double_faults.to_i > 0 || stats.first_serve_percent.present? ||
                      stats.break_points_saved.to_i > 0 || stats.break_points_converted.to_i > 0 ||
                      stats.winners.to_i > 0 || stats.unforced_errors.to_i > 0 || stats.net_points_won.to_i > 0 ||
                      stats.service_points_won.to_i > 0 || stats.return_points_won.to_i > 0 ||
                      stats.return_games_won.to_i > 0 || stats.games_won_total.to_i > 0 %>
  <% has_ratings = stats.singles_rating.present? || stats.doubles_rating.present? %>
<% else %>
  <% has_hours = has_activity = has_match_stats = has_ratings = false %>
<% end %>

<% if stats.blank? || !(has_hours || has_activity || has_match_stats || has_ratings) %>
  <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.empty") %></p>
<% else %>
  <% if has_hours %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1"><%= t("player_statistics.hours.title") %></h3>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.hours.singles") %>: <%= stats.singles_hours.to_f.round(1) %><%= t("player_statistics.hours.unit") %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.hours.doubles") %>: <%= stats.doubles_hours.to_f.round(1) %><%= t("player_statistics.hours.unit") %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.hours.total") %>: <%= stats.total_hours %><%= t("player_statistics.hours.unit") %></p>
    </section>
  <% end %>

  <% if has_activity %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1"><%= t("player_statistics.activity.title") %></h3>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.activity.individual_training") %>: <%= stats.individual_training.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.activity.group_training") %>: <%= stats.group_training.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.activity.singles_games") %>: <%= stats.singles_games.to_i %>, <%= t("player_statistics.activity.win_rate") %> <%= stats.singles_win_rate || t("player_statistics.not_available") %>%</p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.activity.doubles_games") %>: <%= stats.doubles_games.to_i %>, <%= t("player_statistics.activity.win_rate") %> <%= stats.doubles_win_rate || t("player_statistics.not_available") %>%</p>
    </section>
  <% end %>

  <% if has_match_stats %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1"><%= t("player_statistics.match_stats.title") %></h3>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.match_stats.aces") %>: <%= stats.aces.to_i %>, <%= t("player_statistics.match_stats.double_faults") %>: <%= stats.double_faults.to_i %>
        <% if stats.first_serve_percent.present? %>, <%= t("player_statistics.match_stats.first_serve_percent") %>: <%= stats.first_serve_percent %><% end %>
      </p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.match_stats.break_points_saved") %>: <%= stats.break_points_saved.to_i %>, <%= t("player_statistics.match_stats.break_points_converted") %>: <%= stats.break_points_converted.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.match_stats.winners") %>: <%= stats.winners.to_i %>, <%= t("player_statistics.match_stats.unforced_errors") %>: <%= stats.unforced_errors.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.match_stats.net_points_won") %>: <%= stats.net_points_won.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.match_stats.service_points_won") %>: <%= stats.service_points_won.to_i %>, <%= t("player_statistics.match_stats.return_points_won") %>: <%= stats.return_points_won.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.match_stats.return_games_won") %>: <%= stats.return_games_won.to_i %>, <%= t("player_statistics.match_stats.games_won_total") %>: <%= stats.games_won_total.to_i %></p>
    </section>
  <% end %>

  <% if local_assigns[:matches].present? %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1"><%= t("player_statistics.last_games.title") %></h3>
      <ul class="text-gray-600 dark:text-slate-400 space-y-1">
        <% matches.each do |match| %>
          <% mode = match.mode.to_s %>
          <% result = case match.outcome.to_s
                      when "win" then t("player_statistics.last_games.win")
                      when "draw", "tie" then t("player_statistics.last_games.draw")
                      else t("player_statistics.last_games.loss")
                      end %>
          <% details = [] %>
          <% details << match_title_with_guests(match, names_by_id: names_by_id) %>

          <li>
            <%= match.played_at&.strftime("%Y-%m-%d") %> — <%= mode %> <%= result %>
            <% if match.score.present? %> — <%= match.score %><% end %>
            <% if details.any? %> — <%= details.join(" ") %><% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if has_ratings %>
    <section>
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1"><%= t("player_statistics.ratings.title") %></h3>
      <% if stats.singles_rating.present? %>
        <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.ratings.singles") %>: <%= stats.singles_rating %></p>
      <% end %>
      <% if stats.doubles_rating.present? %>
        <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.ratings.doubles") %>: <%= stats.doubles_rating %></p>
      <% end %>
    </section>
  <% end %>
<% end %>

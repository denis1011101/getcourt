<h2 id="ps-title-<%= user.id %>" class="text-xl font-semibold mb-4">
  <%= user.name.presence || user.email %> — Statistics
</h2>

<% if stats.present? %>
  <% has_hours = stats.singles_hours.to_f > 0 || stats.doubles_hours.to_f > 0 %>
  <% has_activity = (stats.individual_training.to_i + stats.group_training.to_i + stats.singles_games.to_i + stats.doubles_games.to_i) > 0 %>
  <% has_match_stats = stats.aces.to_i > 0 || stats.double_faults.to_i > 0 || stats.first_serve_percent.present? ||
                      stats.break_points_saved.to_i > 0 || stats.break_points_converted.to_i > 0 ||
                      stats.winners.to_i > 0 || stats.unforced_errors.to_i > 0 || stats.net_points_won.to_i > 0 ||
                      stats.service_points_won.to_i > 0 || stats.return_points_won.to_i > 0 ||
                      stats.return_games_won.to_i > 0 || stats.games_won_total.to_i > 0 %>
  <% has_ratings = stats.singles_rating.present? || stats.doubles_rating.present? %>
<% else %>
  <% has_hours = has_activity = has_match_stats = has_ratings = false %>
<% end %>

<% if stats.blank? || !(has_hours || has_activity || has_match_stats || has_ratings) %>
  <p class="text-gray-600 dark:text-slate-400">No statistics available yet.</p>
<% else %>
  <% if has_hours %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Hours</h3>
      <p class="text-gray-600 dark:text-slate-400">Singles: <%= stats.singles_hours.to_f.round(1) %>h</p>
      <p class="text-gray-600 dark:text-slate-400">Doubles: <%= stats.doubles_hours.to_f.round(1) %>h</p>
      <p class="text-gray-600 dark:text-slate-400">Total: <%= stats.total_hours %>h</p>
    </section>
  <% end %>

  <% if has_activity %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Trainings / Games</h3>
      <p class="text-gray-600 dark:text-slate-400">Individual training: <%= stats.individual_training.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400">Group training: <%= stats.group_training.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400">Singles games: <%= stats.singles_games.to_i %>, win rate <%= stats.singles_win_rate || 'N/A' %>%</p>
      <p class="text-gray-600 dark:text-slate-400">Doubles games: <%= stats.doubles_games.to_i %>, win rate <%= stats.doubles_win_rate || 'N/A' %>%</p>
    </section>
  <% end %>

  <% if has_match_stats %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Match stats</h3>
      <p class="text-gray-600 dark:text-slate-400">Aces: <%= stats.aces.to_i %>, Double faults: <%= stats.double_faults.to_i %>
        <% if stats.first_serve_percent.present? %>, 1st serve %: <%= stats.first_serve_percent %><% end %>
      </p>
      <p class="text-gray-600 dark:text-slate-400">Break points saved: <%= stats.break_points_saved.to_i %>, Break points converted: <%= stats.break_points_converted.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400">Winners: <%= stats.winners.to_i %>, Unforced errors: <%= stats.unforced_errors.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400">Net points won: <%= stats.net_points_won.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400">Service points won: <%= stats.service_points_won.to_i %>, Return points won: <%= stats.return_points_won.to_i %></p>
      <p class="text-gray-600 dark:text-slate-400">Return games won: <%= stats.return_games_won.to_i %>, Games won total: <%= stats.games_won_total.to_i %></p>
    </section>
  <% end %>

  <% if local_assigns[:matches].present? %>
    <section class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Last 5 games</h3>
      <ul class="text-gray-600 dark:text-slate-400 space-y-1">
        <% matches.each do |match| %>
          <% mode = match.mode.to_s %>
          <% result = case match.outcome.to_s
                      when "win" then "W"
                      when "draw", "tie" then "D"
                      else "L"
                      end %>
          <% details = [] %>
          <% details << match_title_with_guests(match, names_by_id: names_by_id) %>

          <li>
            <%= match.played_at&.strftime("%Y-%m-%d") %> — <%= mode %> <%= result %>
            <% if match.score.present? %> — <%= match.score %><% end %>
            <% if details.any? %> — <%= details.join(" ") %><% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if has_ratings %>
    <section>
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Ratings</h3>
      <% if stats.singles_rating.present? %>
        <p class="text-gray-600 dark:text-slate-400">Singles rating: <%= stats.singles_rating %></p>
      <% end %>
      <% if stats.doubles_rating.present? %>
        <p class="text-gray-600 dark:text-slate-400">Doubles rating: <%= stats.doubles_rating %></p>
      <% end %>
    </section>
  <% end %>
<% end %>

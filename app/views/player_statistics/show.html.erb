<% if stats.blank? %>
<div id="player-stats-<%= user.id %>" class="ps-modal" aria-hidden="true">
  <div class="ps-modal__overlay"></div>
  <div class="ps-modal__content" role="dialog" aria-labelledby="ps-title-<%= user.id %>">
    <a class="ps-modal__close" href="#close" aria-label="Close">✕</a>
    <h2 id="ps-title-<%= user.id %>"><%= user.name.presence || user.email %> — Statistics</h2>

    <p class="text-gray-600 dark:text-slate-400">No statistics available yet.</p>
  </div>
</div>
<% else %>
<div id="player-stats-<%= user.id %>" class="ps-modal" aria-hidden="true">
  <div class="ps-modal__overlay"></div>
  <div class="ps-modal__content" role="dialog" aria-labelledby="ps-title-<%= user.id %>">
    <a class="ps-modal__close" href="#close" aria-label="Close">✕</a>
    <h2 id="ps-title-<%= user.id %>"><%= user.name.presence || user.email %> — Statistics</h2>

    <section>
      <h3>Hours</h3>
      <p>Singles: <%= stats.singles_hours.to_f.round(1) %>h</p>
      <p>Doubles: <%= stats.doubles_hours.to_f.round(1) %>h</p>
      <p>Total: <%= stats.total_hours %>h</p>
    </section>

    <section>
      <h3>Trainings / Games</h3>
      <p>Individual training: <%= stats.individual_training.to_i %></p>
      <p>Group training: <%= stats.group_training.to_i %></p>
      <p>Singles games: <%= stats.singles_games.to_i %>, win rate <%= stats.singles_win_rate || 'N/A' %>%</p>
      <p>Doubles games: <%= stats.doubles_games.to_i %>, win rate <%= stats.doubles_win_rate || 'N/A' %>%</p>
    </section>

    <section>
      <h3>Match stats</h3>
      <p>Aces: <%= stats.aces.to_i %>, Double faults: <%= stats.double_faults.to_i %>, 1st serve %: <%= stats.first_serve_percent || 'N/A' %></p>
      <p>Break points saved: <%= stats.break_points_saved.to_i %>, Break points converted: <%= stats.break_points_converted.to_i %></p>
      <p>Winners: <%= stats.winners.to_i %>, Unforced errors: <%= stats.unforced_errors.to_i %></p>
      <p>Net points won: <%= stats.net_points_won.to_i %></p>
      <p>Service points won: <%= stats.service_points_won.to_i %>, Return points won: <%= stats.return_points_won.to_i %></p>
      <p>Return games won: <%= stats.return_games_won.to_i %>, Games won total: <%= stats.games_won_total.to_i %></p>
    </section>

    <section>
      <h3>Ratings</h3>
      <p>Singles rating: <%= stats.singles_rating || 1500 %></p>
      <p>Doubles rating: <%= stats.doubles_rating || 1500 %></p>
    </section>

    <% if local_assigns[:matches].present? %>
      <section>
        <h3>Last 5 games</h3>
        <ul>
          <% matches.each do |m| %>
            <% mode = m.mode.to_s %>
            <% wl = case m.outcome.to_s
                    when 'win' then 'W'
                    when 'draw', 'tie' then 'D'
                    else 'L'
                    end %>
            <% details = [] %>
            <% details << match_title_with_guests(m, names_by_id: names_by_id) %>

            <li>
              <%= m.played_at&.strftime('%Y-%m-%d') %> — <%= mode %> <%= wl %>
              <% if m.score.present? %> — <%= m.score %><% end %>
              <% if details.any? %> — <%= details.join(' ') %><% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
<% end %>

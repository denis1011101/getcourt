<% if stats.blank? %>
<div id="player-stats-<%= user.id %>" class="ps-modal" aria-hidden="true">
  <div class="ps-modal__overlay"></div>
  <div class="ps-modal__content" role="dialog" aria-labelledby="ps-title-<%= user.id %>">
    <a class="ps-modal__close" href="#close" aria-label="<%= t("common.close") %>">✕</a>
    <h2 id="ps-title-<%= user.id %>"><%= t("player_statistics.title", name: user.name.presence || user.email) %></h2>

    <p class="text-gray-600 dark:text-slate-400"><%= t("player_statistics.empty") %></p>
  </div>
</div>
<% else %>
<div id="player-stats-<%= user.id %>" class="ps-modal" aria-hidden="true">
  <div class="ps-modal__overlay"></div>
  <div class="ps-modal__content" role="dialog" aria-labelledby="ps-title-<%= user.id %>">
    <a class="ps-modal__close" href="#close" aria-label="<%= t("common.close") %>">✕</a>
    <h2 id="ps-title-<%= user.id %>"><%= t("player_statistics.title", name: user.name.presence || user.email) %></h2>

    <section>
      <h3><%= t("player_statistics.hours.title") %></h3>
      <p><%= t("player_statistics.hours.singles") %>: <%= stats.singles_hours.to_f.round(1) %><%= t("player_statistics.hours.unit") %></p>
      <p><%= t("player_statistics.hours.doubles") %>: <%= stats.doubles_hours.to_f.round(1) %><%= t("player_statistics.hours.unit") %></p>
      <p><%= t("player_statistics.hours.total") %>: <%= stats.total_hours %><%= t("player_statistics.hours.unit") %></p>
    </section>

    <section>
      <h3><%= t("player_statistics.activity.title") %></h3>
      <p><%= t("player_statistics.activity.individual_training") %>: <%= stats.individual_training.to_i %></p>
      <p><%= t("player_statistics.activity.group_training") %>: <%= stats.group_training.to_i %></p>
      <p><%= t("player_statistics.activity.singles_games") %>: <%= stats.singles_games.to_i %>, <%= t("player_statistics.activity.win_rate") %> <%= stats.singles_win_rate || t("player_statistics.not_available") %>%</p>
      <p><%= t("player_statistics.activity.doubles_games") %>: <%= stats.doubles_games.to_i %>, <%= t("player_statistics.activity.win_rate") %> <%= stats.doubles_win_rate || t("player_statistics.not_available") %>%</p>
    </section>

    <section>
      <h3><%= t("player_statistics.match_stats.title") %></h3>
      <p><%= t("player_statistics.match_stats.aces") %>: <%= stats.aces.to_i %>, <%= t("player_statistics.match_stats.double_faults") %>: <%= stats.double_faults.to_i %>, <%= t("player_statistics.match_stats.first_serve_percent") %>: <%= stats.first_serve_percent || t("player_statistics.not_available") %></p>
      <p><%= t("player_statistics.match_stats.break_points_saved") %>: <%= stats.break_points_saved.to_i %>, <%= t("player_statistics.match_stats.break_points_converted") %>: <%= stats.break_points_converted.to_i %></p>
      <p><%= t("player_statistics.match_stats.winners") %>: <%= stats.winners.to_i %>, <%= t("player_statistics.match_stats.unforced_errors") %>: <%= stats.unforced_errors.to_i %></p>
      <p><%= t("player_statistics.match_stats.net_points_won") %>: <%= stats.net_points_won.to_i %></p>
      <p><%= t("player_statistics.match_stats.service_points_won") %>: <%= stats.service_points_won.to_i %>, <%= t("player_statistics.match_stats.return_points_won") %>: <%= stats.return_points_won.to_i %></p>
      <p><%= t("player_statistics.match_stats.return_games_won") %>: <%= stats.return_games_won.to_i %>, <%= t("player_statistics.match_stats.games_won_total") %>: <%= stats.games_won_total.to_i %></p>
    </section>

    <section>
      <h3><%= t("player_statistics.ratings.title") %></h3>
      <p><%= t("player_statistics.ratings.singles") %>: <%= stats.singles_rating || 1500 %></p>
      <p><%= t("player_statistics.ratings.doubles") %>: <%= stats.doubles_rating || 1500 %></p>
    </section>

    <% if local_assigns[:matches].present? %>
      <section>
        <h3><%= t("player_statistics.last_games.title") %></h3>
        <ul>
          <% matches.each do |m| %>
            <% mode = m.mode.to_s %>
            <% wl = case m.outcome.to_s
                    when 'win' then t("player_statistics.last_games.win")
                    when 'draw', 'tie' then t("player_statistics.last_games.draw")
                    else t("player_statistics.last_games.loss")
                    end %>
            <% details = [] %>
            <% details << match_title_with_guests(m, names_by_id: names_by_id) %>

            <li>
              <%= m.played_at&.strftime('%Y-%m-%d') %> — <%= mode %> <%= wl %>
              <% if m.score.present? %> — <%= m.score %><% end %>
              <% if details.any? %> — <%= details.join(' ') %><% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
<% end %>

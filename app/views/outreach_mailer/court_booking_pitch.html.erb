<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 560px; margin: 0 auto; padding: 24px; color: #1e1b4b;">
  <%= render "user_mailer/brand_header" %>

  <p style="font-size: 15px; line-height: 1.6;"><%= t("outreach_mailer.court_booking_pitch.greeting") %></p>
  <p style="font-size: 15px; line-height: 1.6;"><%= t("outreach_mailer.court_booking_pitch.intro") %></p>
  <p style="font-size: 15px; line-height: 1.6;"><%= t("outreach_mailer.court_booking_pitch.offer") %></p>
  <p style="font-size: 15px; line-height: 1.6;"><%= t("outreach_mailer.court_booking_pitch.why") %></p>
  <p style="font-size: 15px; line-height: 1.6;"><%= t("outreach_mailer.court_booking_pitch.together") %></p>

  <p style="font-size: 15px; line-height: 1.6;">
    <%= t("outreach_mailer.court_booking_pitch.link_intro") %>
    <a href="<%= @partnership_url %>" style="color: #4f46e5;"><%= @partnership_url %></a>
  </p>

  <p style="font-size: 15px; line-height: 1.6; margin: 24px 0 0;">
    <%= t("outreach_mailer.court_booking_pitch.closing") %><br>
    <%= t("outreach_mailer.court_booking_pitch.signature") %>
  </p>

  <p style="font-size: 12px; color: #777; line-height: 1.5; margin: 24px 0 0;">
    <%= t("outreach_mailer.court_booking_pitch.unsubscribe") %>
  </p>
</div>

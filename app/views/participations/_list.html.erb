<div id="participations">
  <% g = local_assigns[:game] || game %>
  <% approved_participations = g.participations.respond_to?(:approved) ? g.participations.approved : g.participations %>
  <% pending_participations = g.participations.respond_to?(:pending) ? g.participations.pending : [] %>
  <% can_manage = current_user && (current_user == g.user || (current_user.respond_to?(:admin?) && current_user.admin?)) %>

  <ul class="mb-4 space-y-2">
    <% approved_participations.each do |participation| %>
      <%= render partial: "participations/item", locals: { participation: participation, game: g } %>
      <% user = participation.user %>
      <% if user %>
        <%= render partial: "player_statistics/modal", locals: { user: user, stats: user.player_statistic || user.create_player_statistic } %>
      <% end %>
    <% end %>

    <% if approved_participations.empty? %>
      <li class="text-sm text-gray-500 dark:text-slate-400">No participants yet.</li>
    <% end %>
  </ul>

  <% if pending_participations.any? && can_manage %>
    <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 dark:border-amber-500/20 dark:bg-amber-500/10 p-3">
      <p class="text-xs font-semibold text-amber-800 dark:text-amber-200 mb-2">Pending requests</p>
      <ul class="space-y-2">
        <% pending_participations.each do |participation| %>
          <% user = participation.user %>
          <% label = (user&.respond_to?(:name) && user.name.present?) ? user.name : user&.email %>
          <li class="flex items-center justify-between gap-2 text-sm text-amber-900 dark:text-amber-100">
            <span><%= label.presence || "User" %></span>
            <span class="flex items-center gap-2">
              <%= button_to "Approve", approve_game_participation_path(g, participation), method: :post, form: { data: { turbo: true } }, class: "inline-flex items-center rounded-md bg-emerald-600 px-3 py-1.5 text-xs text-white hover:bg-emerald-700 transition" %>
              <%= button_to "Reject", reject_game_participation_path(g, participation), method: :post, form: { data: { turbo: true } }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-xs text-white hover:bg-red-700 transition" %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if can_manage %>
    <%= form_with url: create_guest_game_participations_path(g), method: :post,
          data: { turbo: true }, class: "mb-4 flex items-center gap-2" do %>
      <%= text_field_tag :guest_name, nil, maxlength: 50,
            required: true,
            placeholder: t("games.show.guest_placeholder"),
            class: "w-full rounded border-gray-300 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
      <%= submit_tag t("games.show.add_guest"),
            class: "inline-flex items-center rounded-md border border-indigo-300 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60" %>
    <% end %>
  <% end %>

  <% if approved_participations.count > 4 %>
    <div class="mt-2 mb-4 rounded-md bg-yellow-50 border border-yellow-200 p-2 text-yellow-800 dark:bg-yellow-500/10 dark:border-yellow-500/20 dark:text-yellow-200 text-sm">
      Classic format supports up to 4 players.
    </div>
  <% end %>
</div>

<div id="participations">
  <ul class="mb-4 space-y-2">
    <% game.participations.each do |participation| %>
      <%= render partial: "participations/item", locals: { participation: participation, game: game } %>
    <% end %>

    <% if game.participations.empty? %>
      <li class="text-sm text-gray-500">No participants yet.</li>
    <% end %>
  </ul>

  <% g = local_assigns[:game] || game %>
  <% if g.participations.count > 4 %>
    <div class="mt-2 mb-4 rounded-md bg-yellow-50 border border-yellow-200 p-2 text-yellow-800 text-sm">
      Classic format supports up to 4 players.
    </div>
  <% end %>
</div>
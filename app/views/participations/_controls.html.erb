<% sign_in_path = (respond_to?(:new_session_path) && new_session_path) || '/sign_in' rescue '/sign_in' %>
<% g = local_assigns[:game] || @game %>
<% user_participation = user_signed_in? ? g.participations.find_by(user: current_user) : nil %>

<% owner = g.respond_to?(:user) ? g.user : nil %>
<% owner_tg = owner&.telegram_username.to_s.strip.delete_prefix("@") %>

<div id="participation_controls" class="space-y-4">
  <div class="flex flex-wrap items-center gap-3">
    <% if user_signed_in? %>
      <% if user_participation %>
        <% if user_participation.respond_to?(:pending?) && user_participation.pending? %>
          <span class="inline-flex items-center rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-700 dark:bg-amber-500/15 dark:text-amber-200">Request sent</span>
          <%= form_with url: game_participation_path(g, user_participation), method: :delete, data: { turbo: true }, html: { class: "inline-flex" } do |f| %>
            <%= f.button "Cancel request", type: :submit, class: "inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-white hover:bg-red-700 transition" %>
          <% end %>
        <% else %>
          <%= form_with url: game_participation_path(g, user_participation), method: :delete, data: { turbo: true }, html: { class: "inline-flex" } do |f| %>
            <%= f.button "Leave Game", type: :submit, class: "inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-white hover:bg-red-700 transition" %>
          <% end %>
        <% end %>
      <% else %>
        <%= form_with url: game_participations_path(g), method: :post, data: { turbo: true }, html: { class: "inline-flex" } do |f| %>
          <% join_label = (current_user == g.user || (current_user.respond_to?(:admin?) && current_user.admin?)) ? "Join" : "Request to join" %>
          <%= f.button join_label, type: :submit, class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition" %>
        <% end %>
      <% end %>
    <% else %>
      <a href="<%= sign_in_path %>" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
        Login to join
      </a>
    <% end %>
  </div>

  <div class="border-t border-gray-200 pt-4 dark:border-white/10">
    <p class="mb-1 text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("games.show.share_title") %></p>
    <p class="mb-3 text-sm text-gray-500 dark:text-slate-400"><%= t("games.show.share_description") %></p>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to t("games.show.share_image"),
                  game_share_card_path(g),
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex items-center rounded-md border border-indigo-300 px-3 py-2 text-sm font-medium text-indigo-700 transition hover:bg-indigo-50 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60" %>
      <%= link_to t("games.show.game_link"),
                  game_url(g),
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      <% if owner_tg.present? %>
        <%= link_to t("games.show.creator_telegram"),
                    "https://t.me/#{owner_tg}",
                    target: "_blank",
                    rel: "noopener",
                    class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      <% end %>
    </div>
  </div>
</div>

<% sign_in_path = (respond_to?(:new_session_path) && new_session_path) || '/sign_in' rescue '/sign_in' %>
<% g = local_assigns[:game] || @game %>
<% user_participation = user_signed_in? ? g.participations.find_by(user: current_user) : nil %>

<% owner = g.respond_to?(:user) ? g.user : nil %>
<% owner_tg = owner&.telegram_username.to_s.strip.delete_prefix("@") %>

<div id="participation_controls" class="space-y-4">
  <div class="flex flex-wrap items-center gap-3">
    <% if user_signed_in? %>
      <% if user_participation %>
        <% if user_participation.respond_to?(:pending?) && user_participation.pending? %>
          <span class="inline-flex items-center rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-700 dark:bg-amber-500/15 dark:text-amber-200"><%= t("games.show.request_sent") %></span>
          <%= form_with url: game_participation_path(g, user_participation), method: :delete, data: { turbo: true }, html: { class: "inline-flex" } do |f| %>
            <%= f.button t("games.show.cancel_request"), type: :submit, class: "inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-white hover:bg-red-700 transition" %>
          <% end %>
        <% else %>
          <%= form_with url: game_participation_path(g, user_participation), method: :delete, data: { turbo: true }, html: { class: "inline-flex" } do |f| %>
            <%= f.button t("games.show.leave_game"), type: :submit, class: "inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-white hover:bg-red-700 transition" %>
          <% end %>
        <% end %>
      <% else %>
        <%= form_with url: game_participations_path(g), method: :post, data: { turbo: true }, html: { class: "inline-flex" } do |f| %>
          <% join_label = (current_user == g.user || (current_user.respond_to?(:admin?) && current_user.admin?)) ? t("games.show.join") : t("games.show.request_to_join") %>
          <%= f.button join_label, type: :submit, class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition" %>
        <% end %>
      <% end %>
    <% else %>
      <a href="<%= sign_in_path %>" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
        <%= t("games.show.login_to_join") %>
      </a>
    <% end %>
  </div>

  <div class="border-t border-gray-200 pt-4 dark:border-white/10">
    <p class="mb-1 text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("games.show.share_title") %></p>
    <p class="mb-3 text-sm text-gray-500 dark:text-slate-400"><%= t("games.show.share_description") %></p>
    <div class="flex flex-wrap items-center gap-3">
      <%= button_tag t("games.show.share_image"),
                     type: "button",
                     data: {
                       controller: "download",
                       download_url_value: game_share_card_path(g),
                       download_filename_value: "getcourt-game-#{g.id}.png",
                       download_success_label_value: t("games.show.downloaded"),
                       action: "click->download#download"
                     },
                     class: "inline-flex items-center rounded-md border border-indigo-300 px-3 py-2 text-sm font-medium text-indigo-700 transition hover:bg-indigo-50 disabled:opacity-60 dark:border-white/15 dark:text-slate-100 dark:hover:bg-slate-700/60" %>
      <%= button_tag t("games.show.game_link"),
                     type: "button",
                     data: {
                       controller: "clipboard",
                       clipboard_text_value: game_url(g),
                       clipboard_success_label_value: t("games.show.copied"),
                       action: "click->clipboard#copy"
                     },
                     class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 disabled:opacity-60 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      <% if owner_tg.present? %>
        <%= button_tag t("games.show.creator_telegram"),
                       type: "button",
                       data: {
                         controller: "clipboard",
                         clipboard_text_value: "https://t.me/#{owner_tg}",
                         clipboard_success_label_value: t("games.show.copied"),
                         action: "click->clipboard#copy"
                       },
                       class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 disabled:opacity-60 dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      <% end %>
    </div>
  </div>
</div>

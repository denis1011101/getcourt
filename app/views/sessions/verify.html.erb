<% content_for :meta_robots, "noindex, nofollow" %>
<div class="max-w-md mx-auto p-6 bg-white rounded shadow-sm dark:bg-slate-800/80 dark:shadow-none">
  <h1 class="text-xl font-semibold mb-4"><%= t("sessions.verify.title_#{@via}") %></h1>

  <p class="text-sm text-gray-600 dark:text-slate-400 mb-4">
    <%= t("sessions.verify.subtitle_#{@via}") %>
  </p>

  <%= form_with url: verify_session_path, method: :post, local: true do %>
    <%= hidden_field_tag :email, @email %>
    <div class="mb-4">
      <%= label_tag :code, t("sessions.code_label"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= text_field_tag :code, nil, autofocus: true, required: true,
            class: "mt-1 block w-full rounded border px-3 py-2 tracking-widest uppercase dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
    </div>
    <div class="flex items-center gap-2">
      <%= submit_tag t("sessions.verify.submit"), class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700" %>
      <%= link_to t("common.back"), new_session_path(email: @email), class: "text-sm text-gray-700 dark:text-slate-300 hover:underline" %>
    </div>
  <% end %>
</div>

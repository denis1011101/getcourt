<% content_for :meta_robots, "noindex, follow" %>
<div class="max-w-md mx-auto p-6 bg-white rounded shadow-sm dark:bg-slate-800/80 dark:shadow-none">
  <h1 class="text-xl font-semibold mb-4"><%= t("layout.auth.sign_in") %></h1>

  <%= form_with url: session_path, method: :post, data: { turbo: false } do %>
     <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
    <div class="mb-4">
      <%= label_tag :email, t("sessions.email_label"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= email_field_tag :email, nil, required: true, class: "mt-1 block w-full rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
    </div>

    <%# People who started in the bot end up with a second account unless they link it — say so before they sign up. %>
    <details class="mb-4 rounded-md border border-indigo-100 bg-indigo-50/70 p-3 dark:border-indigo-400/20 dark:bg-indigo-500/10" data-testid="telegram-signup-hint">
      <summary class="cursor-pointer text-sm font-medium text-indigo-700 dark:text-indigo-300"><%= t("sessions.telegram_hint.summary") %></summary>
      <p class="mt-2 text-xs text-gray-600 dark:text-slate-400">
        <%= t("sessions.telegram_hint.body_html", account_url: notifications_account_path) %>
      </p>
    </details>

    <div class="mb-3">
      <label class="flex items-start gap-2">
        <%= check_box_tag :privacy_consent, "1", false, required: true,
            class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600" %>
        <span class="text-xs text-gray-600 dark:text-slate-400">
          <%= t("sessions.privacy_consent_html", url: privacy_policy_path).html_safe %>
        </span>
      </label>
    </div>
    <div class="mb-3">
      <label class="flex items-start gap-2">
        <%= check_box_tag :age_consent, "1", false, required: true,
            class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600" %>
        <span class="text-xs text-gray-600 dark:text-slate-400">
          <%= t("sessions.age_consent") %>
        </span>
      </label>
    </div>

    <div class="flex items-center gap-2">
      <%= submit_tag t("sessions.submit"), title: t("sessions.sign_in_title"), class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700" %>
      <%= link_to t("common.cancel"), root_path, class: "block inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 transition dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
    </div>
  <% end %>
</div>

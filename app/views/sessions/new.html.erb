<div class="max-w-md mx-auto p-6 bg-white rounded shadow-sm">
  <h1 class="text-xl font-semibold mb-4">Sign in</h1>

  <%= form_with url: sign_in_path, method: :post, local: true do %>
     <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
    <div class="mb-4">
      <%= label_tag :email, "Email", class: "block text-sm font-medium text-gray-700" %>
      <%= email_field_tag :email, nil, required: true, class: "mt-1 block w-full rounded border px-3 py-2" %>
    </div>

    <div class="flex items-center gap-2">
      <%= submit_tag "Sign in", class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700" %>
      <%= link_to "Cancel", root_path, class: "block inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition" %>
    </div>
  <% end %>
</div>
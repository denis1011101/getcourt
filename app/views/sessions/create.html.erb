<div class="max-w-md mx-auto p-6 bg-white rounded shadow-sm">
  <h1 class="text-2xl font-semibold mb-4">Signed in</h1>

  <p class="text-sm text-gray-700 mb-4">
    You are signed in as
    <strong class="text-gray-900"><%= current_user&.email || "user" %></strong>.
  </p>

  <div class="flex gap-2">
    <%= link_to "Go to Home", root_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500" %>
    <%= link_to "Sign out", sign_out_path, method: :delete, data: { confirm: "Sign out?" }, class: "inline-flex items-center rounded-md border px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50"
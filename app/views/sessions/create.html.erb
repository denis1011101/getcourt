<div class="max-w-md mx-auto p-6 bg-white rounded shadow-sm">
  <h1 class="text-2xl font-semibold mb-4"><%= t("sessions.signed_in.title") %></h1>

  <p class="text-sm text-gray-700 mb-4">
    <%= t("sessions.signed_in.body_html", email: content_tag(:strong, current_user&.email || t("sessions.signed_in.fallback_user"), class: "text-gray-900")) %>
  </p>

  <div class="flex gap-2">
    <%= link_to t("sessions.go_home"), root_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500" %>
    <%= link_to t("layout.auth.sign_out"), sign_out_path, method: :delete, data: { confirm: t("layout.auth.sign_out_confirm") }, class: "inline-flex items-center rounded-md border px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50" %>
  </div>
</div>

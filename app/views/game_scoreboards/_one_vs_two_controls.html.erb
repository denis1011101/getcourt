<%# У каждого из троих свой «+» — гейм, выигранный им в одиночку, — и «−»,
    снимающий его последний такой гейм. Гейм пары очков не даёт, но двигает
    очередь одиночки, поэтому у неё отдельная кнопка. %>
<% board = scoreboard.state %>
<% players = scoreboard.trio_players.map { |player| scoreboard_player_label(player) } %>
<% solo = players[board.solo_index] %>
<% pair = (players - [ solo ]).join(" + ") %>
<% press = "transition active:scale-95 select-none touch-manipulation" %>
<% outline = "flex w-full items-center justify-center rounded-xl border border-gray-300 font-semibold text-gray-700 disabled:opacity-40 dark:border-white/15 dark:text-slate-200 #{press}" %>
<div id="game_scoreboard_controls">
  <p class="mt-4 text-center text-sm text-gray-700 dark:text-slate-300"><%= t("game_scoreboards.one_vs_two.now", solo: solo, pair: pair) %></p>
  <div class="mt-2 grid grid-cols-3 gap-2">
    <% players.each_with_index do |name, index| %>
      <div class="flex flex-col gap-2">
        <%= button_to score_game_scoreboard_path(scoreboard.game), params: { side: index, scoreboard_id: scoreboard.id },
              form: { class: "contents" },
              class: "flex h-28 w-full flex-col items-center justify-center rounded-2xl text-white shadow-sm #{press} #{index == board.solo_index ? "bg-indigo-600 active:bg-indigo-700 ring-2 ring-indigo-300 ring-offset-2 dark:ring-offset-slate-900" : "bg-indigo-500/80 active:bg-indigo-600"}",
              aria: { label: t("game_scoreboards.one_vs_two.solo_won", name: name) } do %>
          <span class="text-5xl font-bold leading-none">+</span>
          <span class="mt-1 max-w-full truncate px-2 text-xs opacity-90"><%= name %></span>
        <% end %>
        <%= button_to unscore_game_scoreboard_path(scoreboard.game), params: { side: index, scoreboard_id: scoreboard.id },
              form: { class: "contents" }, disabled: board.solo_wins[index].zero?, class: "#{outline} h-12 text-2xl",
              aria: { label: "− #{name}" } do %>
          −
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-3 grid grid-cols-[1fr_3.5rem] gap-2">
    <%= button_to score_game_scoreboard_path(scoreboard.game), params: { side: "pair", scoreboard_id: scoreboard.id },
          form: { class: "contents" },
          class: "flex h-12 w-full items-center justify-center rounded-xl bg-emerald-600 px-3 text-sm font-semibold text-white active:bg-emerald-700 #{press}" do %>
      + <%= t("game_scoreboards.one_vs_two.pair_won", name: pair) %>
    <% end %>
    <%= button_to unscore_game_scoreboard_path(scoreboard.game), params: { side: "pair", scoreboard_id: scoreboard.id },
          form: { class: "contents" }, disabled: board.winners.none?(&:nil?), class: "#{outline} h-12 text-2xl",
          aria: { label: "− #{t("game_scoreboards.one_vs_two.pair_won", name: pair)}" } do %>
      −
    <% end %>
  </div>
  <p class="mt-2 text-center text-xs text-gray-500 dark:text-slate-400"><%= t("game_scoreboards.one_vs_two.rules") %></p>

  <%= button_to finish_game_scoreboard_path(scoreboard.game), params: { scoreboard_id: scoreboard.id },
        form: { data: { turbo_confirm: t("game_scoreboards.one_vs_two.finish_confirm") } },
        class: "mt-6 w-full rounded-xl border border-red-300 px-4 py-3 text-base font-semibold text-red-700 transition hover:bg-red-50 active:scale-[0.99] dark:border-red-400/40 dark:text-red-300 dark:hover:bg-red-500/10" do %>
    <%= t("game_scoreboards.one_vs_two.finish") %>
  <% end %>
  <p class="mt-1 text-center text-xs text-gray-500 dark:text-slate-400"><%= t("game_scoreboards.one_vs_two.finish_hint") %></p>
</div>

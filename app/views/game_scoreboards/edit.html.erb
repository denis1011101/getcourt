<% content_for :meta_robots, "noindex, follow" %>
<div class="max-w-xl mx-auto px-4 py-4">
  <div class="flex items-center justify-between gap-3 mb-4">
    <h1 class="text-xl font-semibold"><%= t("game_scoreboards.edit.title") %></h1>
    <%= link_to t("game_scoreboards.edit.back"), game_scoreboard_path(@game), class: "shrink-0 inline-flex items-center rounded-md border border-gray-300 dark:border-white/10 px-3 py-2 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-white/5 transition" %>
  </div>

  <p class="mb-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200"><%= t("game_scoreboards.edit.keeps_score") %></p>

  <%= render "game_scoreboards/setup", game: @game, scoreboard: @scoreboard %>
</div>

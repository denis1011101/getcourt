<%# Табло без слов: оно же рассылается всем зрителям через Turbo Streams,
    а рендерится на языке того, кто нажал. Цифры, имена и значки понятны всем. %>
<% board = scoreboard.state %>
<div id="game_scoreboard" class="rounded-lg border bg-white shadow-sm dark:bg-slate-800/80 dark:border-white/10 overflow-hidden" data-testid="scoreboard">
  <% %w[a b].each do |side| %>
    <% players = scoreboard.players(side) %>
    <div class="flex items-center gap-2 px-3 py-3 <%= "border-t dark:border-white/10" if side == "b" %>">
      <div class="min-w-0 flex-1">
        <p class="truncate text-base font-semibold text-gray-900 dark:text-slate-100">
          <% if board.finished? && board.winner == side %><span aria-hidden="true">🏆</span><% end %>
          <%= players.map { |player| scoreboard_player_label(player) }.join(" / ") %>
        </p>
      </div>
      <% board.sets.each do |set| %>
        <span class="w-7 shrink-0 text-center text-lg tabular-nums <%= set[side] > set[side == "a" ? "b" : "a"] ? "font-bold text-gray-900 dark:text-slate-100" : "text-gray-400 dark:text-slate-500" %>">
          <%= set[side] %><% if set["tb"] && set[side] < set[side == "a" ? "b" : "a"] %><sup class="ml-0.5 text-xs font-semibold text-amber-600 dark:text-amber-300"><%= set["tb"] %></sup><% end %>
        </span>
      <% end %>
      <% unless board.finished? %>
        <span class="w-9 shrink-0 rounded-md bg-gray-100 text-center text-2xl font-bold tabular-nums text-gray-900 dark:bg-slate-700 dark:text-slate-100"><%= board.games[side] %></span>
        <% if board.points_mode? %>
          <span class="w-14 shrink-0 rounded-md bg-indigo-600 py-1 text-center text-2xl font-bold tabular-nums text-white"><%= board.point_label(side) %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if board.tiebreak? %>
    <p class="border-t bg-amber-50 px-3 py-1 text-center text-xs font-semibold tracking-wide text-amber-800 dark:border-white/10 dark:bg-amber-500/15 dark:text-amber-200">TIE-BREAK</p>
  <% end %>
</div>

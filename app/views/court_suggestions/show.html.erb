<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-4xl px-4 py-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold"><%= t("courts.suggestions.show_title", court: @suggestion.court.name) %></h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-slate-400"><%= @suggestion.user.name.presence || @suggestion.user.email %> · <%= l(@suggestion.created_at, format: :short) %></p>
    </div>
    <span class="rounded-full bg-gray-100 px-3 py-1 text-sm"><%= t("courts.suggestions.statuses.#{@suggestion.status}") %></span>
  </div>

  <div class="mt-6 overflow-hidden rounded-xl border bg-white dark:border-white/10 dark:bg-slate-800/80">
    <% @suggestion.payload.each do |field, proposed_value| %>
      <% current_value = @suggestion.court.public_send(field) %>
      <div class="grid gap-2 border-b p-4 last:border-b-0 dark:border-white/10 sm:grid-cols-3">
        <p class="font-medium"><%= t("courts.suggestions.fields.#{field}", default: field.humanize) %></p>
        <p class="text-sm text-gray-500 line-through dark:text-slate-400"><%= Array(current_value).to_sentence.presence || "—" %></p>
        <p class="text-sm font-medium text-green-700 dark:text-green-300"><%= Array(proposed_value).to_sentence.presence || "—" %></p>
      </div>
    <% end %>

    <% if @suggestion.comment.present? %>
      <div class="p-4">
        <p class="text-sm font-medium"><%= t("courts.suggestions.comment") %></p>
        <p class="mt-1 whitespace-pre-line text-sm text-gray-700 dark:text-slate-300"><%= @suggestion.comment %></p>
      </div>
    <% end %>
  </div>

  <% if @suggestion.pending? %>
    <div class="mt-6 flex gap-3">
      <%= button_to t("courts.suggestions.approve"), court_suggestion_approval_path(@suggestion), method: :post, class: "rounded-md bg-green-600 px-4 py-2 text-white hover:bg-green-700" %>
      <%= button_to t("courts.suggestions.reject"), court_suggestion_rejection_path(@suggestion), method: :post, data: { turbo_confirm: t("courts.suggestions.reject_confirm") }, class: "rounded-md bg-red-600 px-4 py-2 text-white hover:bg-red-700" %>
    </div>
  <% end %>

  <div class="mt-6 flex gap-4 text-sm">
    <%= link_to t("courts.suggestions.open_court"), @suggestion.court, class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
    <%= link_to t("courts.suggestions.back_to_list"), court_suggestions_path, class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>
</div>

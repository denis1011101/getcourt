<% if @exceeded %>
  <div class="mb-2 rounded-md bg-yellow-50 border border-yellow-200 p-2 text-yellow-800 text-sm">
    Google geocoding quota exceeded for today (limit: <%= @limit %>). Address lookup via Google is disabled.
    <% if Rails.env.development? || (defined?(current_user) && current_user&.admin?) %>
      <%= form_with url: geocoding_reset_path, method: :post, data: { turbo_frame: "geocoding-status" } do %>
        <%= submit_tag "Reset quota", class: "ml-3 inline-flex items-center text-sm font-medium text-indigo-600 hover:underline" %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div></div>
<% end %>
<!DOCTYPE html>
<html lang="<%= (I18n.locale || :en).to_s %>">
  <head>
    <title><%= meta_title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= meta_description %>" />
    <meta name="google-site-verification" content="QKaZtbncns-eyZmeVp-DVA3riXkmBgcvdLDQKoSYn7c" />
    <meta name="robots" content="index, follow" />

    <!-- FAVICONS START -->
        <!-- Fallback для всех браузеров -->
        <link rel="icon" href="/favicon.ico" sizes="any">
        <!-- SVG для современных браузеров -->
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <!-- Главная для Google (кратна 48px) -->
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
        <!-- Для Android и Chrome -->
        <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
        <!-- Стандартные для браузеров -->
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <!-- Для iPhone/iPad -->
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <!-- Манифест -->
        <link rel="manifest" href="/site.webmanifest">
    <!-- FAVICONS END -->

    <link rel="canonical" href="https://getcourt.co<%= request.path %>" />

    <!-- Open Graph -->
    <meta property="og:title" content="<%= meta_title %>"/>
    <meta property="og:description" content="<%= meta_description %>"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="<%= request.original_url %>"/>
    <meta property="og:image" content="<%= meta_image %>"/>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= meta_title %>" />
    <meta name="twitter:description" content="<%= meta_description %>" />
    <meta name="twitter:image" content="<%= meta_image %>" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <!-- Google Maps JavaScript API -->
    <script>window.initMap = window.initMap || function(){};</script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <!-- Top header (visible on all screens). Right-side menu hidden on small screens. -->
    <header class="border-b bg-white">
      <nav class="mx-auto max-w-5xl px-4 py-3 flex justify-between items-center gap-4">
        <!-- Logo (always top-left, two lines) -->
        <div class="flex-shrink-0">
          <%= link_to root_path, class: "text-xl font-semibold leading-tight" do %>
            <span class="block">Get</span>
            <span class="block">Court</span>
          <% end %>
        </div>

        <!-- Mobile sign info (visible only on small screens) -->
        <div class="flex items-center gap-3 sm:hidden">
          <% if user_signed_in? %>
            <div class="text-right">
              <div class="text-xs text-gray-600">Signed in as</div>
              <div class="text-sm font-semibold text-indigo-600 truncate" style="max-width:130px;">
                <%= link_to (current_user.email.presence || current_user.name.presence || "Account"), edit_account_path, class: "hover:underline inline-block" %>
              </div>
            </div>
            <%= link_to "Sign out", sign_out_path, data: { "turbo-method": :delete, "turbo-confirm": "Sign out?" }, class: "ml-2 text-sm text-red-600 hover:underline" %>
          <% else %>
            <%= link_to "Sign in / Sign up", new_session_path, title: "Sign in or create an account", class: "text-sm text-gray-700 hover:underline" %>
          <% end %>
        </div>

        <!-- Right column: hidden on small screens to keep header compact -->
        <div class="hidden sm:flex flex-col items-end gap-2">
          <div class="flex items-center gap-6">
            <%= link_to "Courts", courts_path, class: "text-sm text-gray-700 hover:text-gray-900" %>
            <%= link_to "Games", games_path, class: "text-sm text-gray-700 hover:text-gray-900" %>
            <%= link_to "Search nearby", searches_path, class: "text-sm text-gray-700 hover:text-gray-900 whitespace-nowrap" %>
            <details class="relative inline-block">
              <summary class="text-sm text-gray-700 hover:text-gray-900 cursor-pointer list-none">More ▾</summary>
              <div class="absolute right-0 mt-2 w-48 bg-white border rounded shadow-md z-50">
                <%# link_to "Tournaments", tournaments_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                <%= link_to "Tennis Life", tennis_life_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                <%= link_to "Contacts", contacts_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                <%= link_to "Mission", mission_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
              </div>
            </details>
          </div>

          <div class="flex items-center gap-4">
            <% if user_signed_in? %>
              <span class="text-sm text-gray-600 whitespace-nowrap">
                Signed in as
                <%= link_to (current_user.email.presence || current_user.name.presence || "Account"), edit_account_path,
                            class: "font-semibold text-indigo-600 hover:underline" %>
              </span>
              <%= link_to "Sign out", sign_out_path, data: { "turbo-method": :delete, "turbo-confirm": "Sign out?" }, class: "text-sm text-red-600 hover:underline" %>
            <% else %>
              <%= link_to "Sign in / Sign up", new_session_path, title: "Sign in or create an account", class: "text-sm text-gray-700 hover:underline font-semibold " %>
            <% end %>
          </div>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-2">
      <%= render "shared/flash" %>

      <turbo-frame id="geocoding-status" src="<%= geocoding_status_path %>"></turbo-frame>

      <%= yield %>
      <!-- spacer чтобы контент не заезжал под мобильную нижнюю навигацию -->
      <div class="h-20 sm:hidden" aria-hidden="true"></div>
    </main>

    <!-- Mobile bottom navigation (visible only on small screens) -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t sm:hidden z-50" style="padding-bottom: env(safe-area-inset-bottom);">
      <div class="max-w-5xl mx-auto px-1 py-2 grid grid-cols-5 gap-1 items-end justify-items-center">
        <%= link_to courts_path, class: "flex flex-col items-center justify-center text-xs text-gray-700 hover:bg-gray-50 rounded-md py-2 px-2 transition-colors" do %>
          <span class="font-medium">Courts</span>
        <% end %>

        <%= link_to games_path, class: "flex flex-col items-center justify-center text-xs text-gray-700 hover:bg-gray-50 rounded-md py-2 px-2 transition-colors" do %>
          <span class="font-medium">Games</span>
        <% end %>

        <%# Mobile central button: on Games -> new_game, otherwise -> new_court %>
        <% central_path, central_title = if controller_name == "games"
          [new_game_path, "Add Game"]
        else
          [new_court_path, "Add Court"]
        end %>

        <%= link_to central_path, class: "inline-flex items-center rounded-lg bg-gradient-to-r from-indigo-600 to-indigo-500 px-3 py-1.5 text-sm font-medium text-white hover:from-indigo-500 hover:to-indigo-400 whitespace-nowrap", title: central_title do %>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
        <% end %>

        <%= link_to searches_path, class: "flex flex-col items-center justify-center text-xs text-gray-700 hover:bg-gray-50 rounded-md py-2 px-2 transition-colors" do %>
          <span class="font-medium">Search</span>
        <% end %>

        <details class="relative">
          <summary class="flex flex-col items-center justify-center text-xs text-gray-700 hover:bg-gray-50 rounded-md py-2 px-2 transition-colors cursor-pointer">
            <span class="font-medium">More</span>
          </summary>
          <div class="absolute bottom-14 left-1/2 transform -translate-x-1/2 w-56 bg-white border rounded-lg shadow-md z-50 p-2">
            <%# link_to "Tournaments", tournaments_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
            <%= link_to "Tennis Life", tennis_life_path, class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded" %>
            <%= link_to "Contacts", contacts_path, class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded" %>
            <%= link_to "Mission", mission_path, class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded" %>
          </div>
        </details>
      </div>
    </nav>
  </body>
</html>

<!DOCTYPE html>
<html lang="<%= (I18n.locale || :en).to_s %>">
  <head>
    <title><%= meta_title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= meta_description %>" />
    <meta name="google-site-verification" content="QKaZtbncns-eyZmeVp-DVA3riXkmBgcvdLDQKoSYn7c" />
    <meta name="robots" content="<%= meta_robots_content %>" />

    <!-- FAVICONS START -->
        <!-- Fallback для всех браузеров -->
        <link rel="icon" href="/favicon.ico" sizes="any">
        <!-- SVG для современных браузеров -->
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <!-- Главная для Google (кратна 48px) -->
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
        <!-- Для Android и Chrome -->
        <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
        <!-- Стандартные для браузеров -->
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <!-- Для iPhone/iPad -->
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <!-- Манифест -->
        <link rel="manifest" href="/site.webmanifest">
    <!-- FAVICONS END -->

    <link rel="canonical" href="<%= canonical_url %>" />
    <% hreflang_links.each do |locale, href| %>
      <link rel="alternate" hreflang="<%= locale %>" href="<%= href %>" />
    <% end %>

    <!-- Open Graph -->
    <meta property="og:title" content="<%= meta_title %>"/>
    <meta property="og:description" content="<%= meta_description %>"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="<%= canonical_url %>"/>
    <meta property="og:image" content="<%= meta_image %>"/>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= meta_title %>" />
    <meta name="twitter:description" content="<%= meta_description %>" />
    <meta name="twitter:image" content="<%= meta_image %>" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script>
      (function() {
        var storageKey = "getcourt_theme";
        var stored = localStorage.getItem(storageKey);
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var useDark = stored ? stored === "dark" : prefersDark;

        if (useDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <% unless user_signed_in? %>
      <script src="https://telegram.org/js/telegram-web-app.js"></script>
      <script>
        (function() {
          var tg = window.Telegram && window.Telegram.WebApp;
          if (!tg || !tg.initData) return;
          if (document.cookie.indexOf("_get_court_session_v2=") !== -1) return;

          fetch("/telegram/web_app_auth", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ init_data: tg.initData })
          }).then(function(response) {
            if (response.ok) window.location.reload();
          });
        })();
      </script>
    <% end %>
    <!-- Google Maps JavaScript API -->
    <script>window.initMap = window.initMap || function(){};</script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap"></script>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="bg-gray-50 text-gray-900 transition-colors dark:bg-slate-950 dark:text-slate-100">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b bg-white/95 backdrop-blur dark:border-white/10 dark:bg-slate-900/80">
      <nav class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <%= link_to root_path, class: "flex flex-col leading-tight group transition" do %>
            <span class="text-xl font-bold bg-gradient-to-r from-indigo-600 to-purple-500 dark:from-indigo-400 dark:to-purple-400 bg-clip-text text-transparent group-hover:from-indigo-700 group-hover:to-purple-600 dark:group-hover:from-indigo-300 dark:group-hover:to-purple-300">Get</span>
            <span class="text-xl font-bold bg-gradient-to-r from-indigo-600 to-purple-500 dark:from-indigo-400 dark:to-purple-400 bg-clip-text text-transparent group-hover:from-indigo-700 group-hover:to-purple-600 dark:group-hover:from-indigo-300 dark:group-hover:to-purple-300">Court</span>
          <% end %>
        </div>

        <!-- Desktop nav links -->
        <div class="hidden md:flex items-center gap-5">
          <%= link_to t("layout.nav.games"), root_path, class: "text-sm font-medium text-gray-700 hover:text-gray-900 transition dark:text-slate-300 dark:hover:text-white" %>
          <%= link_to t("layout.nav.courts"), courts_path, class: "text-sm font-medium text-gray-700 hover:text-gray-900 transition dark:text-slate-300 dark:hover:text-white" %>
          <%= link_to t("layout.nav.tennis_life"), tennis_life_path, class: "text-sm font-medium text-gray-700 hover:text-gray-900 transition dark:text-slate-300 dark:hover:text-white" %>
          <details class="relative inline-block">
            <summary class="text-sm font-medium text-gray-700 hover:text-gray-900 cursor-pointer list-none transition dark:text-slate-300 dark:hover:text-white"><%= t("layout.nav.more") %> &#9662;</summary>
            <div class="absolute right-0 mt-2 w-48 bg-white border rounded-lg shadow-lg z-50 py-1 dark:border-white/10 dark:bg-slate-800">
              <%= link_to t("layout.nav.tournaments"), tournaments_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.nav.coaches"), coaches_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.nav.contacts"), contacts_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.nav.statistics"), tennis_life_statistics_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.nav.partnership"), partnership_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.nav.formats_rules"), tennis_formats_and_rules_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.nav.ntrp_guide"), ntrp_level_guide_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.nav.mission"), mission_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            </div>
          </details>
        </div>

        <!-- Desktop right side: Telegram + auth -->
        <div class="hidden md:flex items-center gap-4">
          <%= render "shared/language_select" %>
          <button type="button"
                  onclick="toggleTheme()"
                  class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition dark:border-white/10 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700"
                  title="Toggle theme">
            <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0112 21c-5.385 0-9.75-4.365-9.75-9.75 0-4.828 3.508-8.832 8.112-9.618a.75.75 0 01.87.932 7.49 7.49 0 0010.37 8.576.75.75 0 01.9.862z"/></svg>
            <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
          </button>
          <a href="https://t.me/GetCourtBot" target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 rounded-full bg-[#2AABEE]/10 px-4 py-2 text-sm font-semibold text-[#2AABEE] hover:bg-[#2AABEE]/20 transition"
             title="Telegram Bot">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            Telegram
          </a>

          <% if user_signed_in? %>
            <div class="flex items-center gap-3">
              <%= link_to edit_account_path, class: "inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition dark:border-white/10 dark:bg-slate-800/70 dark:text-slate-100 dark:hover:bg-slate-700 dark:hover:border-white/20" do %>
                <svg class="w-4 h-4 text-gray-400 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                </svg>
                <%= current_user.name.presence || current_user.email %>
              <% end %>
              <%= link_to t("layout.auth.sign_out"), sign_out_path, data: { "turbo-method": :delete, "turbo-confirm": t("layout.auth.sign_out_confirm") },
                          class: "text-sm text-red-500 hover:text-red-700 transition" %>
            </div>
          <% else %>
            <%= link_to t("layout.auth.sign_in"), new_session_path,
                        class: "inline-flex items-center rounded-full border border-gray-300 px-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
          <% end %>
        </div>

        <!-- Mobile right side: Telegram + user -->
        <div class="flex items-center gap-2 md:hidden">
          <%= render "shared/language_select", compact: true %>
          <button type="button"
                  onclick="toggleTheme()"
                  class="inline-flex items-center justify-center min-w-9 h-9 rounded-full bg-gray-100 px-2 text-xs font-medium text-gray-700 hover:bg-gray-200 transition dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600"
                  title="Toggle theme">
            <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0112 21c-5.385 0-9.75-4.365-9.75-9.75 0-4.828 3.508-8.832 8.112-9.618a.75.75 0 01.87.932 7.49 7.49 0 0010.37 8.576.75.75 0 01.9.862z"/></svg>
            <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
          </button>
          <a href="https://t.me/GetCourtBot" target="_blank" rel="noopener"
             class="inline-flex items-center gap-1.5 rounded-full bg-[#2AABEE]/10 px-3 py-1.5 text-sm font-semibold text-[#2AABEE] hover:bg-[#2AABEE]/20 transition"
             title="Telegram Bot">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            Telegram
          </a>
          <% if user_signed_in? %>
            <%= link_to edit_account_path, class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600", title: t("layout.nav.account"), aria: { label: t("layout.nav.account") } do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
              </svg>
            <% end %>
          <% else %>
            <%= link_to new_session_path, class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600", title: t("layout.auth.sign_in"), aria: { label: t("layout.auth.sign_in") } do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
              </svg>
            <% end %>
          <% end %>
        </div>
      </nav>
    </header>

    <%= render "shared/locale_suggestion" %>

    <main class="mx-auto max-w-6xl px-4 py-4">
      <%= render "shared/flash" %>

      <turbo-frame id="geocoding-status" src="<%= geocoding_status_path %>"></turbo-frame>

      <%= yield %>
      <!-- spacer для мобильной навигации -->
      <div class="h-20 md:hidden" aria-hidden="true"></div>
    </main>

    <!-- Mobile bottom navigation -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t md:hidden z-50 dark:border-white/10 dark:bg-slate-900/90" style="padding-bottom: env(safe-area-inset-bottom);">
      <div class="max-w-6xl mx-auto px-2 py-1.5 grid grid-cols-5 gap-1 items-end justify-items-center">
        <%= link_to root_path, class: "flex flex-col items-center justify-center text-xs #{controller_name == 'games' && action_name == 'index' ? 'text-indigo-600 dark:text-indigo-400' : 'text-gray-500'} hover:text-indigo-600 rounded-md py-1.5 px-2 transition-colors" do %>
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 01-.657.643 48.491 48.491 0 01-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 01-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 00-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 01-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 00.657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 01-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 005.427-.63 48.05 48.05 0 00.582-4.717.532.532 0 00-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 00.658-.663 48.422 48.422 0 00-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 01-.61-.58v0z"/>
          </svg>
          <span class="font-medium"><%= t("layout.nav.games") %></span>
        <% end %>

        <%= link_to courts_path, class: "flex flex-col items-center justify-center text-xs #{controller_name == 'courts' ? 'text-indigo-600 dark:text-indigo-400' : 'text-gray-500'} hover:text-indigo-600 rounded-md py-1.5 px-2 transition-colors" do %>
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
          <span class="font-medium"><%= t("layout.nav.courts") %></span>
        <% end %>

        <% if user_signed_in? %>
          <%= link_to new_game_path, class: "flex flex-col items-center justify-center text-xs text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl py-1.5 px-3 transition-colors -mt-3 shadow-lg" do %>
            <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            <span class="font-medium text-[10px]"><%= t("layout.nav.new") %></span>
          <% end %>
        <% else %>
          <%= link_to new_session_path, class: "flex flex-col items-center justify-center text-xs text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl py-1.5 px-3 transition-colors -mt-3 shadow-lg" do %>
            <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            <span class="font-medium text-[10px]"><%= t("layout.nav.new") %></span>
          <% end %>
        <% end %>

        <%= link_to tennis_life_path, class: "flex flex-col items-center justify-center text-xs #{controller_name == 'tennis_life' && action_name != 'statistics' ? 'text-indigo-600 dark:text-indigo-400' : 'text-gray-500'} hover:text-indigo-600 rounded-md py-1.5 px-2 transition-colors" do %>
          <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/>
          </svg>
          <span class="font-medium"><%= t("layout.nav.life") %></span>
        <% end %>

        <details class="relative">
          <summary class="flex flex-col items-center justify-center text-xs <%= (%w[tournaments coaches contacts partnership].include?(controller_name) || (controller_name == 'tennis_life' && action_name == 'statistics')) ? 'text-indigo-600 dark:text-indigo-400' : 'text-gray-500' %> hover:text-indigo-600 rounded-md py-1.5 px-2 transition-colors cursor-pointer list-none">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
            </svg>
            <span class="font-medium"><%= t("layout.nav.more") %></span>
          </summary>
          <div class="absolute bottom-14 right-0 w-56 bg-white border rounded-lg shadow-lg z-50 py-1 dark:border-white/10 dark:bg-slate-800">
            <%= link_to t("layout.nav.tournaments"), tournaments_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <%= link_to t("layout.nav.coaches"), coaches_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <%= link_to t("layout.nav.contacts"), contacts_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <%= link_to t("layout.nav.statistics"), tennis_life_statistics_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <%= link_to t("layout.nav.partnership"), partnership_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <%= link_to t("layout.nav.formats_rules"), tennis_formats_and_rules_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <%= link_to t("layout.nav.ntrp_guide"), ntrp_level_guide_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <%= link_to t("layout.nav.mission"), mission_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
            <% if user_signed_in? %>
              <hr class="my-1 dark:border-white/10">
              <%= link_to t("layout.nav.account"), edit_account_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 dark:text-slate-300 dark:hover:bg-white/5" %>
              <%= link_to t("layout.auth.sign_out"), sign_out_path, data: { "turbo-method": :delete, "turbo-confirm": t("layout.auth.sign_out_confirm") },
                          class: "block px-4 py-2.5 text-sm text-red-600 hover:bg-red-50" %>
            <% end %>
          </div>
        </details>
      </div>
    </nav>

    <!-- Cookie notice popup -->
    <div id="consent-popup" class="hidden fixed bottom-24 md:bottom-6 right-4 z-50 max-w-sm">
      <div class="bg-white rounded-2xl shadow-2xl border p-5 dark:border-white/10 dark:bg-slate-900">
        <div class="text-sm text-gray-700 leading-relaxed dark:text-slate-300">
          <p><%= t("layout.cookies.primary") %>
            <%= link_to t("layout.cookies.learn_more"), privacy_policy_path,
                class: "text-indigo-600 dark:text-indigo-400 hover:underline" %>
          </p>
        </div>
        <div class="mt-4 flex gap-2">
          <button onclick="dismissConsent()" class="flex-1 rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition">
            <%= t("layout.cookies.ok") %>
          </button>
        </div>
      </div>
    </div>

    <script>
      (function() {
        var CONSENT_KEY = 'getcourt_consent';
        var popup = document.getElementById('consent-popup');
        if (!popup) return;

        if (!localStorage.getItem(CONSENT_KEY)) {
          setTimeout(function() { popup.classList.remove('hidden'); }, 1500);
        }

        window.dismissConsent = function() {
          localStorage.setItem(CONSENT_KEY, 'dismissed');
          popup.classList.add('hidden');
        };
      })();

      window.toggleTheme = function() {
        var storageKey = "getcourt_theme";
        var root = document.documentElement;
        var useDark = !root.classList.contains("dark");

        root.classList.toggle("dark", useDark);
        localStorage.setItem(storageKey, useDark ? "dark" : "light");
      };
    </script>
  </body>
</html>

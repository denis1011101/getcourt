<% content_for :meta_robots, "noindex, follow" %>

<div class="max-w-3xl mx-auto px-4 py-6">
  <h1 class="text-xl font-semibold mb-4">Account</h1>

  <div class="mb-6 rounded-lg border bg-white p-4 shadow-sm dark:border-white/10 dark:bg-slate-800/80">
    <%= render partial: "player_statistics/summary",
               locals: { user: @user, stats: @player_statistic, matches: @recent_matches, names_by_id: @names_by_id } %>
  </div>

  <div class="mb-6 flex flex-wrap gap-3">
    <%= link_to games_account_path,
          class: "inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h18"/>
      </svg>
      My games
    <% end %>

    <%= link_to profile_account_path,
          class: "inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a8.25 8.25 0 0115 0"/>
      </svg>
      Profile
    <% end %>

    <%= link_to notifications_account_path,
          class: "inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022 23.848 23.848 0 005.455 1.31m5.714 0a3 3 0 11-5.714 0"/>
      </svg>
      Telegram & notifications
    <% end %>

    <%= link_to security_account_path,
          class: "inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7.5 3v5.25c0 4.2-2.8 8.1-7.5 9.75-4.7-1.65-7.5-5.55-7.5-9.75V6L12 3z"/>
      </svg>
      Security
    <% end %>

    <%= link_to courts_account_path,
          class: "inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15M7.5 4.5h12v12M4.5 7.5v12h12"/>
      </svg>
      Court preferences
    <% end %>
  </div>
</div>

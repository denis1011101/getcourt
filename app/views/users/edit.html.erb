<% content_for :meta_robots, "noindex, follow" %>
<div class="max-w-3xl mx-auto px-4 py-6">
  <h1 class="text-xl font-semibold mb-4">Account</h1>

  <div class="mb-6 rounded-lg border bg-white p-4 shadow-sm dark:border-white/10 dark:bg-slate-800/80">
    <%= render partial: "player_statistics/summary",
               locals: { user: @user, stats: @player_statistic, matches: @recent_matches, names_by_id: @names_by_id } %>
  </div>

  <div class="mb-6">
    <%= link_to games_account_path,
          class: "inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h18"/>
      </svg>
      My games
    <% end %>
  </div>

  <!-- 1. Открываем ОДНУ общую форму для всей страницы -->
  <%= form_with model: @user, url: account_path, method: :patch, local: true do |f| %>
    
    <!-- Блок настроек верификации -->
    <div class="mb-4 p-3 bg-yellow-50 border-l-4 border-yellow-300 rounded text-sm text-gray-700 dark:text-slate-300 dark:bg-yellow-500/10 dark:border-yellow-500/30 dark:text-slate-300">
      <p class="font-medium">Account verification recommended</p>
      <p class="mt-1">If you plan to create courts or host games, we recommend enabling sign-in verification (email or Telegram). This helps build trust and prevents abuse.</p>

      <div class="mt-3 flex items-center gap-4">
        <label class="inline-flex items-center gap-2">
          <%= f.check_box :require_verification, class: "h-4 w-4 text-indigo-600" %>
          <span class="text-sm text-gray-700 dark:text-slate-300">Require verification for sensitive actions</span>
        </label>

        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-600 dark:text-slate-400 mr-2">Verification method:</span>
          <%= f.select :preferred_login_via,
                options_for_select([["Telegram", "telegram"], [t("users.edit.verification_method_email"), "email"]], @user.preferred_login_via),
                {}, class: "mt-1 block rounded border px-3 py-2 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
      </div>

      <p class="text-xs text-gray-500 dark:text-slate-400 mt-2">
        By default you sign in without a code. Enable verification to require a one-time code sent via your selected method.
      </p>
    </div>

    <!-- Информационный блок Telegram (просто HTML внутри формы) -->
    <% if @user.telegram_chat_id.present? %>
      <p class="mb-2 flex items-center gap-1.5 text-sm text-gray-700 dark:text-slate-300">
        <svg class="h-4 w-4 flex-shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Telegram connected<% if @user.telegram_username.present? %>:
          <%= telegram_profile_link(@user.telegram_username, class: "text-indigo-600 dark:text-indigo-400 hover:underline") %>
        <% end %>
      </p>
    <% end %>
    <p class="mb-4 text-sm text-gray-700 dark:text-slate-300">
      To receive Telegram notifications, please open a chat with our bot...
      <a href="https://t.me/GetCourtBot" class="text-indigo-600 dark:text-indigo-400 hover:underline" target="_blank" rel="noopener">https://t.me/GetCourtBot</a> and send:
    </p>

    <div class="mb-4 p-3 bg-gray-50 border rounded dark:bg-slate-700/50 dark:border-white/10">
      <code>/register <%= @registration_token %></code>
    </div>

    <!-- Кнопка регенерации токена -->
    <!-- ВАЖНО: Используем link_to вместо button_to, чтобы не создавать вложенную форму -->
    <div class="flex items-center gap-3 mb-6">
      <%= link_to "Regenerate token",
            regenerate_token_account_path,
            data: { turbo_method: :post }, 
            class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition text-sm font-medium decoration-0" %>
    </div>

    <!-- Блок личных данных (Name, Email, Skills) -->
    <div class="grid grid-cols-1 gap-4">
      <div>
        <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
      </div>

      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= f.email_field :email, class: "mt-1 block w-full rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
      </div>

      <div>
        <p class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Skill levels</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% User::SPORTS.each do |sport| %>
            <div>
              <label class="block text-sm text-gray-600 dark:text-slate-400"><%= sport %></label>
              <%= select_tag "user[skill_levels][#{sport}]",
                    options_for_select([["—", ""]] + User::SKILL_LEVELS.map { |s| [s.titleize, s] }, @user.skill_level_for(sport)),
                    class: "mt-1 block w-full rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
            </div>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">Set your skill level for each sport.</p>
      </div>

      <div>
        <label class="inline-flex items-center gap-2">
          <%= f.check_box :coach, class: "h-4 w-4 text-indigo-600" %>
          <span class="text-sm text-gray-700 dark:text-slate-300">I am a coach</span>
        </label>
        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">Tick if you coach — this helps others find and hire coaches in the future.</p>
      </div>

      <div>
        <%= f.label :city_name, "City", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= f.text_field :city_name, value: (params[:city_query].presence || @user.city_name || @selected_city_name), placeholder: "e.g. Moskva", class: "mt-1 block w-full rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
        <p class="text-sm text-gray-600 dark:text-slate-400 mt-2">Enter a place. The system will transliterate names and try to detect timezone automatically on save. Press "Save Changes".</p>
      </div>

      <div>
        <label class="inline-flex items-center gap-2">
          <%= f.check_box :notify_nearby, class: "h-4 w-4 text-indigo-600" %>
          <span class="text-sm text-gray-700 dark:text-slate-300">Notify me about nearby searches</span>
        </label>
        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">Receive notifications when someone searches for players near you.</p>
      </div>

      <div>
        <%= f.label :about_me, "About me", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
        <%= f.text_area :about_me, rows: 4, placeholder: "Tell others a bit about yourself…", class: "mt-1 block w-full rounded border px-3 py-2 text-sm" %>
      </div>

      <div class="rounded-lg border border-gray-200 p-4 dark:border-white/10">
        <p class="block text-sm font-medium text-gray-700 dark:text-slate-300"><%= t("users.edit.court_preferences_title") %></p>

        <div class="mt-3 space-y-2">
          <label class="flex items-start gap-2">
            <%= radio_button_tag "user[court_preferences_mode]", "favorites", @court_preferences_mode == "favorites", class: "mt-1 h-4 w-4 text-indigo-600" %>
            <span class="text-sm text-gray-700 dark:text-slate-300"><%= t("users.edit.court_preferences_mode_favorites") %></span>
          </label>

          <div class="ml-6">
            <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("users.edit.favorite_courts_help") %></p>
            <div class="mt-2 max-h-56 overflow-y-auto rounded border border-gray-200 p-3 dark:border-white/10">
              <% @available_courts.each do |court| %>
                <label class="flex items-start gap-2 py-1">
                  <%= check_box_tag "user[favorite_court_ids][]", court.id, @user.favorite_court_ids.include?(court.id), class: "mt-1 h-4 w-4 text-indigo-600" %>
                  <span class="text-sm text-gray-700 dark:text-slate-300">
                    <%= court.name %>
                    <% if court.city_name.present? %>
                      <span class="text-gray-500 dark:text-slate-400">(<%= court.city_name %>)</span>
                    <% end %>
                  </span>
                </label>
              <% end %>
            </div>
          </div>
        </div>

        <div class="mt-4 space-y-2">
          <label class="flex items-start gap-2">
            <%= radio_button_tag "user[court_preferences_mode]", "note", @court_preferences_mode == "note", class: "mt-1 h-4 w-4 text-indigo-600" %>
            <span class="text-sm text-gray-700 dark:text-slate-300"><%= t("users.edit.court_preferences_mode_note") %></span>
          </label>

          <div class="ml-6">
            <%= f.label :court_preferences_note, t("users.edit.court_note_label"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
            <%= f.text_area :court_preferences_note,
                  rows: 3,
                  placeholder: t("users.edit.court_note_placeholder"),
                  class: "mt-1 block w-full rounded border px-3 py-2 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
            <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("users.edit.court_note_help") %></p>
          </div>
        </div>
      </div>

      <!-- Кнопки действий -->
      <div class="mt-4 flex items-center gap-3">
        <%= f.submit "Save Changes", class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 cursor-pointer" %>
        
        <%= link_to "Back", root_path,
          class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 transition dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      </div>
    </div>

  <% end %> <!-- Здесь закрывается единственная форма -->

  <div class="mt-8 rounded-lg border border-red-200 dark:border-red-500/20 p-4">
    <h2 class="text-sm font-semibold text-red-700 dark:text-red-400 mb-1">
      <%= t("users.delete_account_title") %>
    </h2>
    <p class="text-xs text-gray-500 dark:text-slate-400 mb-3">
      <%= t("users.delete_account_body") %>
    </p>
    <%= button_to t("users.delete_account_button"),
        account_path,
        method: :delete,
        data: { turbo_confirm: t("users.delete_account_confirm") },
        class: "rounded-md bg-red-600 px-4 py-2 text-sm text-white hover:bg-red-700 cursor-pointer" %>
  </div>
</div>

<div class="max-w-3xl mx-auto px-4 py-6">
  <h1 class="text-xl font-semibold mb-4">Account</h1>

  <!-- 1. Открываем ОДНУ общую форму для всей страницы -->
  <%= form_with model: @user, url: account_path, method: :patch, local: true do |f| %>
    
    <!-- Блок настроек верификации -->
    <div class="mb-4 p-3 bg-yellow-50 border-l-4 border-yellow-300 rounded text-sm text-gray-700">
      <p class="font-medium">Account verification recommended</p>
      <p class="mt-1">If you plan to create courts or host games, we recommend enabling sign-in verification (email or Telegram). This helps build trust and prevents abuse.</p>

      <div class="mt-3 flex items-center gap-4">
        <label class="inline-flex items-center gap-2">
          <%= f.check_box :require_verification, class: "h-4 w-4 text-indigo-600" %>
          <span class="text-sm text-gray-700">Require verification for sensitive actions</span>
        </label>

        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-600 mr-2">Verification method:</span>
          <%= f.select :preferred_login_via,
                options_for_select([["Telegram", "telegram"]], @user.preferred_login_via),
                {}, class: "mt-1 block rounded border px-3 py-2 text-sm" %>
        </div>
      </div>

      <p class="text-xs text-gray-500 mt-2">
        By default you sign in without a code. Enable verification + Telegram to require a one‑time code sent to your bot chat.
      </p>
    </div>

    <!-- Информационный блок Telegram (просто HTML внутри формы) -->
    <p class="mb-4 text-sm text-gray-700">
      To receive Telegram notifications, please open a chat with our bot...
      <a href="https://t.me/GetCourtBot" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">https://t.me/GetCourtBot</a> and send:
    </p>

    <div class="mb-4 p-3 bg-gray-50 border rounded">
      <code>/register <%= @registration_token %></code>
    </div>

    <!-- Кнопка регенерации токена -->
    <!-- ВАЖНО: Используем link_to вместо button_to, чтобы не создавать вложенную форму -->
    <div class="flex items-center gap-3 mb-6">
      <%= link_to "Regenerate token",
            regenerate_token_account_path,
            data: { turbo_method: :post }, 
            class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition text-sm font-medium decoration-0" %>
    </div>

    <!-- Блок личных данных (Name, Email, Skills) -->
    <div class="grid grid-cols-1 gap-4">
      <div>
        <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded border px-3 py-2" %>
      </div>

      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, class: "mt-1 block w-full rounded border px-3 py-2" %>
      </div>

      <div>
        <p class="block text-sm font-medium text-gray-700 mb-2">Skill levels</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% User::SPORTS.each do |sport| %>
            <div>
              <label class="block text-sm text-gray-600"><%= sport %></label>
              <%= select_tag "user[skill_levels][#{sport}]",
                    options_for_select([["—", ""]] + User::SKILL_LEVELS.map { |s| [s.titleize, s] }, @user.skill_level_for(sport)),
                    class: "mt-1 block w-full rounded border px-3 py-2" %>
            </div>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 mt-1">Set your skill level for each sport.</p>
      </div>

      <div>
        <label class="inline-flex items-center gap-2">
          <%= f.check_box :coach, class: "h-4 w-4 text-indigo-600" %>
          <span class="text-sm text-gray-700">I am a coach</span>
        </label>
        <p class="text-xs text-gray-500 mt-1">Tick if you coach — this helps others find and hire coaches in the future.</p>
      </div>

      <!-- Кнопки действий -->
      <div class="mt-4 flex items-center gap-3">
        <%= f.submit "Save Changes", class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 cursor-pointer" %>
        
        <%= link_to "Back", root_path,
          class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition" %>
      </div>
    </div>

  <% end %> <!-- Здесь закрывается единственная форма -->
</div>
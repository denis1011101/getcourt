<% content_for :meta_robots, "noindex, follow" %>

<div class="mx-auto max-w-3xl space-y-4 px-4 py-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Security</h1>
    <%= link_to "Back to account", edit_account_path, class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>

  <div class="rounded-lg border bg-white p-4 dark:border-white/10 dark:bg-slate-800/80">
    <%= form_with model: @user, url: account_path, method: :patch, local: true do |f| %>
      <%= hidden_field_tag :section, "security" %>
      <%= render "users/verification_form", f: f %>
    <% end %>
  </div>

  <div class="rounded-lg border border-red-200 p-4 dark:border-red-500/20">
    <h2 class="text-sm font-semibold text-red-700 dark:text-red-400 mb-1">
      <%= t("users.delete_account_title") %>
    </h2>
    <p class="text-xs text-gray-500 dark:text-slate-400 mb-3">
      <%= t("users.delete_account_body") %>
    </p>
    <%= button_to t("users.delete_account_button"),
        account_path,
        method: :delete,
        data: { turbo_confirm: t("users.delete_account_confirm") },
        class: "rounded-md bg-red-600 px-4 py-2 text-sm text-white hover:bg-red-700 cursor-pointer" %>
  </div>
</div>

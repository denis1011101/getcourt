<% content_for :meta_robots, "noindex, follow" %>

<div class="mx-auto max-w-3xl space-y-4 px-4 py-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Telegram & notifications</h1>
    <%= link_to "Back to account", edit_account_path, class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>

  <div class="rounded-lg border bg-white p-4 dark:border-white/10 dark:bg-slate-800/80">
    <%= form_with model: @user, url: account_path, method: :patch, local: true do |f| %>
      <%= hidden_field_tag :section, "notifications" %>
      <%= render "users/telegram_section", f: f %>

      <div class="mt-6 border-t border-gray-200 pt-4 dark:border-white/10">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("users.notifications.delivery_title") %></h2>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("users.notifications.delivery_help") %></p>

        <div class="mt-4">
          <%= f.label :notification_channel, t("users.notifications.channel"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= f.select :notification_channel,
                options_for_select([
                  [t("users.notifications.channel_email"), "email"],
                  [t("users.notifications.channel_telegram"), "telegram"]
                ], @user.notification_channel),
                {},
                class: "mt-1 block rounded border px-3 py-2 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
        </div>

        <% if @user.telegram_chat_id.blank? && @user.notification_channel == "telegram" %>
          <p class="mt-2 text-xs text-amber-700 dark:text-amber-300"><%= t("users.notifications.telegram_required") %></p>
        <% end %>
      </div>

      <div class="mt-6 border-t border-gray-200 pt-4 dark:border-white/10">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300"><%= t("users.notifications.nearby_title") %></h2>
        <p class="mt-1 text-xs text-gray-500 dark:text-slate-400"><%= t("users.notifications.nearby_help") %></p>

        <label class="mt-4 inline-flex items-center gap-2">
          <%= f.check_box :notify_nearby, class: "h-4 w-4 text-indigo-600" %>
          <span class="text-sm text-gray-700 dark:text-slate-300"><%= t("users.notifications.nearby_enabled") %></span>
        </label>

        <% if @user.city_name.blank? %>
          <p class="mt-2 text-xs text-amber-700 dark:text-amber-300">
            <%= t("users.notifications.city_required_html", url: profile_account_path) %>
          </p>
        <% end %>
      </div>

      <div class="mt-6 flex items-center gap-3">
        <%= f.submit t("users.notifications.save"), class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 cursor-pointer" %>
        <%= link_to t("users.notifications.back"), edit_account_path,
          class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
      </div>
    <% end %>
  </div>
</div>

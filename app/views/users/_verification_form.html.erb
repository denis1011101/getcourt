<div class="space-y-4">
  <div class="p-3 bg-yellow-50 border-l-4 border-yellow-300 rounded text-sm text-gray-700 dark:bg-yellow-500/10 dark:border-yellow-500/30 dark:text-slate-300">
    <p class="font-medium"><%= t("users.security.verification_title") %></p>
    <p class="mt-1"><%= t("users.security.verification_body") %></p>

    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
      <label class="inline-flex items-center gap-2">
        <%= f.check_box :require_verification, class: "h-4 w-4 text-indigo-600" %>
        <span class="text-sm text-gray-700 dark:text-slate-300"><%= t("users.security.require_verification") %></span>
      </label>

      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-600 dark:text-slate-400 mr-2"><%= t("users.security.verification_method") %></span>
        <%= f.select :preferred_login_via,
              options_for_select([["Telegram", "telegram"], [t("users.edit.verification_method_email"), "email"]], @user.preferred_login_via),
              {}, class: "mt-1 block rounded border px-3 py-2 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
      </div>
    </div>

    <p class="text-xs text-gray-500 dark:text-slate-400 mt-2">
      <%= t("users.security.verification_hint") %>
    </p>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <%= f.submit t("common.save_changes"), class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to t("common.back"), edit_account_path,
      class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition dark:border-white/15 dark:text-slate-200 dark:hover:bg-white/5" %>
  </div>
</div>

<% content_for :meta_title, t("users.games.title") %>

<div class="mx-auto max-w-3xl space-y-4 px-4 py-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold"><%= t("users.games.title") %></h1>
    <%= link_to t("common.back_to_account"), edit_account_path, class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
  </div>

  <div class="rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
    <%= t("account.games.fairness_warning") %>
  </div>

  <% if current_user.coach? %>
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-gray-900 dark:text-slate-100"><%= t("users.games.coach_schedule_title") %></h2>
      <% if @coach_schedule.empty? %>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("users.games.coach_schedule_empty") %></p>
      <% else %>
        <% @coach_schedule.each do |entry| %>
          <% game = entry[:game] %>
          <div class="rounded-lg border bg-white p-4 dark:border-white/10 dark:bg-slate-800/80">
            <p class="text-sm text-gray-500 dark:text-slate-400">
              <%= l(entry[:date], format: :long) %> · <%= game.time&.strftime("%H:%M") %>
            </p>
            <p class="font-medium">
              <%= link_to game.court&.name, game_path(game), class: "hover:underline" %>
            </p>
            <p class="mt-2 text-sm text-gray-700 dark:text-slate-300">
              <%= t("users.games.coach_participants") %>:
              <%= game.participations.filter_map { |participation| participation.user&.name.presence || participation.user&.email }.join(", ").presence || "—" %>
            </p>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if @games.empty? %>
    <p class="text-gray-500"><%= t("users.games.empty") %></p>
  <% else %>
    <% @games.each do |game| %>
      <div class="rounded-lg border bg-white p-4 dark:border-white/10 dark:bg-slate-800/80">
        <div class="mb-3 flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500">
              <%= l((game.display_date_for_show || game.date).to_date, format: :long) rescue "-" %>
              · <%= game.time&.strftime("%H:%M") %>
            </p>
            <p class="text-lg font-medium">
              <%= link_to game.court&.name, game_path(game), class: "hover:underline" %>
            </p>
          </div>
          <%= link_to t("users.games.open_game"), game_path(game), class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
        </div>

        <details class="border-t pt-3 dark:border-white/10">
          <summary class="cursor-pointer text-sm font-medium"><%= t("users.games.enter_stats") %></summary>
          <div class="mt-3">
            <%= render "games/stats_form", game: game %>
          </div>
        </details>
      </div>
    <% end %>

    <%= render "shared/pagy", pagy: @pagy if @pagy.respond_to?(:pages) %>
  <% end %>

  <% if @past_match_groups.any? %>
    <div class="mt-8 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-slate-100"><%= t("users.games.past_title") %></h2>
      <p class="text-sm text-gray-500 dark:text-slate-400">
        <%= t("users.games.past_subtitle") %>
      </p>

      <% @past_match_groups.each do |date, matches_for_date| %>
        <div class="rounded-lg border bg-white p-4 dark:border-white/10 dark:bg-slate-800/80">
          <div class="mb-2 flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500 dark:text-slate-400">
                <%= l(date, format: :long) rescue date.to_s %>
              </p>
              <p class="text-lg font-medium text-gray-900 dark:text-slate-100">
                <%= t("users.games.matches_count", count: matches_for_date.size) %>
              </p>
            </div>
            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-slate-700 dark:text-slate-300">
              <%= t("users.games.history_badge") %>
            </span>
          </div>

          <ul class="divide-y dark:divide-white/10">
            <% matches_for_date.each do |m| %>
              <li class="py-2 text-sm">
                <div class="flex items-center justify-between">
                  <span class="text-gray-700 dark:text-slate-300">
                    <%= m.mode&.titleize %>
                    · <%= match_title_with_guests(m, names_by_id: @opponents_by_id) %>
                  </span>
                  <span class="font-mono text-gray-900 dark:text-slate-100">
                    <%= m.score.presence || "—" %>
                  </span>
                </div>
                <% if m.outcome.present? %>
                  <span class="text-xs text-gray-500 dark:text-slate-400">
                    <%= m.outcome.titleize %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
